#!/usr/bin/env python3
"""Per-stream TTS player with live gain control.

Replaces `afplay` for VoiceBox clips when per-stream ducking is wanted:
the emitted samples are scaled by a gain read from a JSON file
(`~/.local/state/omp-voice/stream-gain.json`) every chunk, so the
controller can attenuate only the assistant's stream instead of the
macOS master output volume. Other applications are untouched.

Usage: voice-play <wav> [--gain-file PATH] [--chunk-ms 40]
Exit code mirrors afplay: 0 on clean completion, 1 on bad input.
"""

from __future__ import annotations

import argparse
import json
import math
import signal
import struct
import sys
import time
from pathlib import Path

import numpy as np
import sounddevice as sd


def _load_gain(path: Path) -> float:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        gain = float(data.get("gain", 1.0))
    except Exception:
        return 1.0
    return max(0.0, min(1.0, gain))


def _parse_wav(data: bytes) -> tuple[int, int, np.ndarray] | None:
    if len(data) < 12 or data[:4] != b"RIFF" or data[8:12] != b"WAVE":
        return None
    rate = channels = 0
    pos = 12
    pcm = b""
    while pos + 8 <= len(data):
        tag = data[pos : pos + 4]
        size = struct.unpack("<I", data[pos + 4 : pos + 8])[0]
        body = data[pos + 8 : pos + 8 + size]
        if tag == b"fmt ":
            fmt = struct.unpack("<H", body[0:2])[0]
            channels = struct.unpack("<H", body[2:4])[0]
            rate = struct.unpack("<I", body[4:8])[0]
            if fmt != 1:  # only PCM supported
                return None
        elif tag == b"data":
            pcm = body
        pos += 8 + size
    if not rate or not channels or not pcm:
        return None
    samples = np.frombuffer(pcm, dtype="<i2")
    samples = samples.reshape(-1, channels)
    return rate, channels, samples


def time_stretch(samples: np.ndarray, rate: int, speed: float) -> np.ndarray:
    """Change tempo without changing pitch (WSOLA).

    Plain resampling at the reply speed (1.18x) raised the cloned voice's
    pitch by 18% and made it sound like a woman's voice (live 2026-11-21).
    """
    x = samples.astype(np.float32)
    mono = x.mean(axis=1)
    win = int(0.030 * rate)
    hop_out = win // 2
    hop_in = hop_out * speed
    tol = int(0.010 * rate)
    window = np.hanning(win).astype(np.float32)
    n_frames = max(1, int((len(x) - win - tol) / hop_in))
    out = np.zeros((n_frames * hop_out + win, x.shape[1]), dtype=np.float32)
    norm = np.zeros(n_frames * hop_out + win, dtype=np.float32)
    prev = 0
    for k in range(n_frames):
        nominal = int(k * hop_in)
        lo, hi = max(0, nominal - tol), min(len(x) - win, nominal + tol)
        if k == 0 or hi <= lo:
            start = min(max(0, nominal), max(0, len(x) - win))
        else:
            # Pick the input offset that best continues the previous frame.
            target = mono[prev + hop_out : prev + hop_out + win]
            region = mono[lo : hi + win]
            if len(target) < win:
                start = lo
            else:
                corr = np.correlate(region, target, mode="valid")
                start = lo + int(np.argmax(corr))
        seg = x[start : start + win]
        if len(seg) < win:
            break
        o = k * hop_out
        out[o : o + win] += seg * window[:, None]
        norm[o : o + win] += window
        prev = start
    norm[norm < 1e-3] = 1.0
    out /= norm[:, None]
    return np.clip(out, -32768, 32767).astype(np.int16)


def main() -> int:
    parser = argparse.ArgumentParser(prog="voice-play")
    parser.add_argument("wav", type=Path)
    parser.add_argument("--gain-file", type=Path, default=Path.home() / ".local" / "state" / "omp-voice" / "stream-gain.json")
    parser.add_argument("--chunk-ms", type=int, default=40)
    parser.add_argument("--speed", type=float, default=1.0, help="Playback speed multiplier (mirrors afplay -r)")
    args = parser.parse_args()

    parsed = _parse_wav(args.wav.read_bytes())
    if parsed is None:
        print(f"voice-play: cannot parse {args.wav}", file=sys.stderr)
        return 1
    rate, channels, samples = parsed
    speed = max(0.25, min(2.0, args.speed))
    if speed != 1.0:
        samples = time_stretch(samples, rate, speed)
    chunk = max(1, int(rate * args.chunk_ms / 1000))

    stop = {"flag": False}

    def handle_sig(signum, frame):
        stop["flag"] = True

    signal.signal(signal.SIGTERM, handle_sig)
    signal.signal(signal.SIGINT, handle_sig)

    gain = _load_gain(args.gain_file)
    target = gain
    with sd.OutputStream(samplerate=rate, channels=channels, dtype="int16") as out:
        for i in range(0, len(samples), chunk):
            if stop["flag"]:
                break
            # Ramp toward the target gain so a duck change does not click.
            if gain != target:
                step = min(1.0, chunk / max(rate * 0.05, 1))
                gain += (target - gain) * step
                if abs(target - gain) < 0.01:
                    gain = target
            target = _load_gain(args.gain_file)
            out.write((samples[i : i + chunk] * gain).astype(np.int16))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
