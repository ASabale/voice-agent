#!/usr/bin/env python3
from __future__ import annotations

import os
import sys

_venv = os.path.expanduser("~/.local/share/omp-voice/venv/bin/python")
if os.path.exists(_venv) and os.path.realpath(sys.executable) != os.path.realpath(_venv):
    os.execv(_venv, [_venv, os.path.abspath(__file__), *sys.argv[1:]])

"""
OMP Hands-Free Voice Controller (Stage 1: In-Room Loop)

State machine:
- IDLE:
    Listens continuously on a 16 kHz mono mic stream using:
      1. openWakeWord ("hey_jarvis") with automatic mic gain normalization, AND
      2. Silero VAD + faster-whisper `tiny.en` (CPU int8, ~90ms) short-utterance verifier
         with initial_prompt vocabulary bias so accented/quiet "Hey Jarvis" or "Jarvis"
         or standalone "send prompt" is recognized reliably every time without transcribing long room chatter.
    When "Hey Jarvis" / "Jarvis" fires:
      1. Calls POST http://127.0.0.1:17494/barge-in to silence VoiceBox if speaking.
      2. Plays Wake chime (marimba_start.wav).
      3. Toggles Handy recording ON (`handy --toggle-transcription`).
      4. Enters DICTATING.
- DICTATING:
    Monitors Silero VAD + RMS energy on the same 16 kHz stream:
      - Once speech is detected in the current chunk and 5.0s of silence elapses (Pause),
        flushes the chunk by calling `handy --toggle-transcription`.
      - Reads the newly transcribed row from Handy's SQLite `history.db`, forwards it to
        OMP extension `POST http://127.0.0.1:17494/transcript` (which strips command phrases
        like "send prompt" / "pause listening" / "cancel that", updates `ctx.ui.setEditorText`,
        or calls `pi.sendUserMessage`).
      - If action == "appended": plays Chunk tick (Tink.aiff) and immediately calls
        `handy --toggle-transcription` to keep recording the next chunk in DICTATING.
      - If action == "sent": plays Send chime (marimba_stop.wav) and returns to IDLE.
      - If action == "paused" / "cancelled": plays Pop/Basso tone and returns to IDLE.
      - If 15.0s elapses in DICTATING with zero speech at all, cancels Handy (`handy --cancel`)
        and returns to IDLE.
"""

import argparse
from collections import deque
import ctypes
import datetime
import json
import os
import re
import select
import signal
import sqlite3
import subprocess
import sys
import queue
import threading
import time
import urllib.error
import urllib.request
from pathlib import Path

import numpy as np

HANDY_BIN = "/Applications/Handy.app/Contents/MacOS/handy"
HANDY_DIR = Path.home() / "Library" / "Application Support" / "com.pais.handy"
HANDY_DB = HANDY_DIR / "history.db"
HANDY_SETTINGS = HANDY_DIR / "settings_store.json"
HANDY_LOG = Path.home() / "Library" / "Logs" / "com.pais.handy" / "handy.log"

OMP_BRIDGE_URL = os.environ.get("OMP_VOICE_BRIDGE_URL", "http://127.0.0.1:17494")

SOUND_WAKE = "/Applications/Handy.app/Contents/Resources/resources/marimba_start.wav"
SOUND_CHUNK_TICK = "/System/Library/Sounds/Tink.aiff"
SOUND_SEND = "/Applications/Handy.app/Contents/Resources/resources/marimba_stop.wav"
SOUND_PAUSE = "/System/Library/Sounds/Pop.aiff"
SOUND_CANCEL = "/System/Library/Sounds/Basso.aiff"

STATE_DIR = Path.home() / ".local" / "state" / "omp-voice"
SESSION_DIR = STATE_DIR / "sessions"
PID_FILE = STATE_DIR / "controller.pid"
TEXT_ROLES = frozenset({"AXTextArea", "AXTextField", "AXComboBox", "AXSearchField"})
STATUS_FILE = STATE_DIR / "status.json"
LOG_FILE = STATE_DIR / "controller.log"
TTS_STATE_FILE = STATE_DIR / "tts-playing.json"

_coreaudio = ctypes.CDLL("/System/Library/Frameworks/CoreAudio.framework/CoreAudio")
_coregraphics = ctypes.CDLL("/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics")
_coregraphics.CGEventSourceFlagsState.argtypes = [ctypes.c_uint32]
_coregraphics.CGEventSourceFlagsState.restype = ctypes.c_uint64


class _AudioObjectPropertyAddress(ctypes.Structure):
    _fields_ = [
        ("mSelector", ctypes.c_uint32),
        ("mScope", ctypes.c_uint32),
        ("mElement", ctypes.c_uint32),
    ]


def coreaudio_default_input_device_id() -> int:
    """Return macOS CoreAudio kAudioHardwarePropertyDefaultInputDevice ID so we detect headphone hotplug."""
    try:
        addr = _AudioObjectPropertyAddress(0x64496E20, 0x676C6F62, 0)
        dev_id = ctypes.c_uint32(0)
        size = ctypes.c_uint32(ctypes.sizeof(dev_id))
        res = _coreaudio.AudioObjectGetPropertyData(
            1, ctypes.byref(addr), 0, None, ctypes.byref(size), ctypes.byref(dev_id)
        )
        return int(dev_id.value) if res == 0 else -1
    except Exception:
        return -1


def next_mic_frame(
    frames: queue.Queue,
    active_id: int,
    device_id,
    last_check: float,
    check_every: float = 2.0,
) -> tuple[str, object, float]:
    """Return the next mic block, or ask the caller to reopen the device.

    The wait is capped at half a second. A blocking PortAudio read does not
    return after stream.abort() once the default input device changes, and the
    wake word and the Handy paste poll both sit behind that read.
    """
    try:
        block = frames.get(timeout=min(0.5, check_every))
    except queue.Empty:
        block = None
    now = time.monotonic()
    if now - last_check >= check_every:
        last_check = now
        new_id = device_id()
        if new_id != -1 and active_id != -1 and new_id != active_id:
            return "rebind", None, last_check
    if block is None:
        return "idle", None, last_check
    return "frame", block, last_check


def is_voicebox_speaking() -> bool:
    """Fast local check whether VoiceBox afplay is currently outputting audio."""
    try:
        # 1. Check if any afplay process is actively running (not a zombie 'Z')
        res = subprocess.run(
            ["/bin/ps", "-axo", "stat=,comm="],
            capture_output=True,
            text=True,
            timeout=0.5,
            check=False,
        )
        for line in res.stdout.splitlines():
            parts = line.split(None, 1)
            if len(parts) == 2 and parts[1].endswith("afplay") and not parts[0].startswith("Z"):
                return True
        # 2. Check 600ms room-reverb tail guard after afplay exits
        if TTS_STATE_FILE.exists():
            data = json.loads(TTS_STATE_FILE.read_text(encoding="utf-8"))
            ended_at = float(data.get("ended_at", 0))
            if (time.time() - ended_at) < 0.60:
                return True
    except Exception:
        pass
    return False


def log(msg: str) -> None:
    ts = time.strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] {msg}"
    print(line, flush=True)


def play_cue(path: str, wait: bool = False) -> None:
    if not os.path.exists(path):
        return
    try:
        proc = subprocess.Popen(
            ["/usr/bin/afplay", path],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if wait:
            proc.wait(timeout=2.0)
    except Exception:
        pass


def write_status(state: str, extra: dict | None = None) -> None:
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        payload = {
            "state": state,
            "pid": os.getpid(),
            "updated_at": time.time(),
        }
        if extra:
            payload.update(extra)
        tmp = STATUS_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps(payload, indent=2), encoding="utf-8")
        tmp.replace(STATUS_FILE)
    except Exception:
        pass


def bridge_request(
    path: str,
    method: str = "GET",
    body: dict | None = None,
    timeout: float = 2.0,
    base: str | None = None,
) -> dict | None:
    url = f"{base or OMP_BRIDGE_URL}{path}"
    data = json.dumps(body).encode("utf-8") if body is not None else None
    headers = {"content-type": "application/json"} if data is not None else {}
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception:
        return None


def normalize_tty(value: object) -> str | None:
    if not isinstance(value, str):
        return None
    text = value.strip()
    if not text or text in {"?", "??", "stdin", "-"}:
        return None
    if text.startswith("/dev/tty"):
        return text
    if text.startswith("tty"):
        return "/dev/" + text
    return None


def normalize_started_at(value: object) -> float:
    try:
        number = float(value)  # type: ignore[arg-type]
    except (TypeError, ValueError):
        return 0.0
    if number > 10_000_000_000:
        return number / 1000.0
    return number


def choose_delivery(
    focus: dict | None,
    sessions: list[dict],
    legacy_owner_pid: int | None,
) -> dict:
    """Pick where a Handy transcript goes.

    A focused text control wins. An omp tab with its own bridge gets the
    transcript through that bridge. Any other text control is a paste.
    When the focused control is not text, the newest omp session gets it.
    """
    text_role = bool(focus) and focus.get("role") in TEXT_ROLES
    tty = normalize_tty(focus.get("tty")) if focus else None
    usable: list[dict] = []
    for session in sessions:
        pid = session.get("pid")
        if not isinstance(pid, int):
            continue
        port = session.get("port")
        usable.append(
            {
                "pid": pid,
                "tty": normalize_tty(session.get("tty")),
                "started_at": normalize_started_at(session.get("started_at")),
                "port": port if isinstance(port, int) and port > 0 else None,
            }
        )

    def bridge(session: dict, port: int) -> dict:
        return {"mode": "bridge", "pid": session["pid"], "port": port, "focused_text": text_role}

    def paste(pid: int | None = None) -> dict:
        return {"mode": "paste", "pid": pid, "port": None, "focused_text": text_role}

    if text_role:
        matches = [session for session in usable if tty and session["tty"] == tty]
        if len(matches) == 1:
            session = matches[0]
            if session["port"]:
                return bridge(session, session["port"])
            if legacy_owner_pid == session["pid"]:
                return bridge(session, 17494)
            return paste(session["pid"])
        return paste(None)

    if not usable:
        return paste(None)
    newest = max(usable, key=lambda session: (session["started_at"], session["pid"]))
    if newest["port"]:
        return bridge(newest, newest["port"])
    if legacy_owner_pid == newest["pid"]:
        return bridge(newest, 17494)
    return paste(newest["pid"])


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def pid_tty(pid: int) -> str | None:
    try:
        out = subprocess.check_output(
            ["lsof", "-nP", "-a", "-p", str(pid), "-d", "0", "-Fn"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    for line in out.splitlines():
        if line.startswith("n"):
            return normalize_tty(line[1:])
    return None


def pid_started_at(pid: int) -> float:
    try:
        raw = subprocess.check_output(["ps", "-p", str(pid), "-o", "lstart="], text=True).strip()
        return datetime.datetime.strptime(raw, "%a %b %d %H:%M:%S %Y").timestamp()
    except (OSError, subprocess.CalledProcessError, ValueError):
        return 0.0


def omp_ui_pids() -> list[int]:
    try:
        out = subprocess.check_output(["ps", "-ax", "-o", "pid=,command="], text=True)
    except (OSError, subprocess.CalledProcessError):
        return []
    pids: list[int] = []
    for line in out.splitlines():
        line = line.strip()
        if not line or "__omp_worker" in line:
            continue
        pid_s, _, cmd = line.partition(" ")
        if not pid_s.isdigit() or not cmd:
            continue
        exe = cmd.split()[0]
        if exe == "omp" or exe.endswith("/omp"):
            pids.append(int(pid_s))
    return pids


def legacy_bridge_owner_pid() -> int | None:
    try:
        out = subprocess.check_output(
            ["lsof", "-nP", "-iTCP:17494", "-sTCP:LISTEN", "-t"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    for line in out.splitlines():
        line = line.strip()
        if line.isdigit():
            return int(line)
    return None


def load_session_registry() -> dict[int, dict]:
    found: dict[int, dict] = {}
    if not SESSION_DIR.exists():
        return found
    for path in SESSION_DIR.glob("*.json"):
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            pid = int(data["pid"])
        except (OSError, ValueError, KeyError, TypeError):
            continue
        if not pid_alive(pid):
            try:
                path.unlink(missing_ok=True)
            except OSError:
                pass
            continue
        port = data.get("port")
        found[pid] = {
            "pid": pid,
            "tty": normalize_tty(data.get("tty")),
            "started_at": normalize_started_at(data.get("startedAt")),
            "port": int(port) if isinstance(port, int) and port > 0 else None,
        }
    return found


def omp_session_records() -> list[dict]:
    records = load_session_registry()
    for pid in omp_ui_pids():
        if not pid_alive(pid):
            continue
        current = records.get(pid, {"pid": pid, "tty": None, "started_at": 0, "port": None})
        if not current.get("tty"):
            current["tty"] = pid_tty(pid)
        if not current.get("started_at"):
            current["started_at"] = pid_started_at(pid)
        records[pid] = current
    return list(records.values())


_FOCUSED_TEXT_SCRIPT = """
tell application "System Events"
  set frontApp to first application process whose frontmost is true
  set appName to name of frontApp
  set roleName to ""
  try
    set focusedElem to value of attribute "AXFocusedUIElement" of frontApp
    set roleName to role of focusedElem
  end try
end tell
return appName & linefeed & roleName
"""


def focused_text_context() -> dict | None:
    raw = subprocess.run(
        ["/usr/bin/osascript", "-e", _FOCUSED_TEXT_SCRIPT],
        capture_output=True,
        text=True,
        check=False,
    )
    if raw.returncode != 0:
        return None
    lines = [line.strip() for line in raw.stdout.splitlines()]
    app = lines[0] if lines else ""
    role = lines[1] if len(lines) > 1 else ""
    if role not in TEXT_ROLES:
        return None
    tty_script = None
    if app == "Terminal":
        tty_script = 'tell application "Terminal" to tty of selected tab of front window'
    elif app in {"iTerm2", "iTerm"}:
        tty_script = 'tell application "iTerm" to tty of current session of current window'
    tty = None
    if tty_script:
        tty_run = subprocess.run(
            ["/usr/bin/osascript", "-e", tty_script],
            capture_output=True,
            text=True,
            check=False,
        )
        if tty_run.returncode == 0:
            tty = tty_run.stdout.strip()
    return {"app": app, "role": role, "tty": tty}


def resolve_delivery() -> dict:
    return choose_delivery(focused_text_context(), omp_session_records(), legacy_bridge_owner_pid())


def bridge_base(dest: dict) -> str:
    port = dest.get("port") or 17494
    return f"http://127.0.0.1:{int(port)}"


def live_bridge_bases() -> list[str]:
    bases: list[str] = []
    for session in omp_session_records():
        port = session.get("port")
        if isinstance(port, int) and port > 0:
            bases.append(f"http://127.0.0.1:{port}")
    if legacy_bridge_owner_pid() is not None:
        bases.append(OMP_BRIDGE_URL)
    deduped: list[str] = []
    for base in bases:
        if base not in deduped:
            deduped.append(base)
    if not deduped:
        deduped.append(OMP_BRIDGE_URL)
    return deduped


def latest_history_row() -> tuple[int, str]:
    if not HANDY_DB.exists():
        return (0, "")
    try:
        conn = sqlite3.connect(f"file:{HANDY_DB}?mode=ro", uri=True, timeout=1.5)
        try:
            cur = conn.execute(
                "SELECT id, COALESCE(post_processed_text, transcription_text, '') "
                "FROM transcription_history ORDER BY id DESC LIMIT 1"
            )
            row = cur.fetchone()
            if not row:
                return (0, "")
            return (int(row[0]), str(row[1]))
        finally:
            conn.close()
    except Exception:
        return (0, "")


def wait_for_new_history_row(after_id: int, timeout_sec: float = 6.0) -> tuple[int, str] | None:
    deadline = time.monotonic() + timeout_sec
    while time.monotonic() < deadline:
        row_id, text = latest_history_row()
        if row_id > after_id:
            return (row_id, text)
        time.sleep(0.06)
    return None


def unmute_async() -> None:
    try:
        subprocess.Popen(
            [
                "/bin/sh",
                "-c",
                'sleep 0.15; /usr/bin/osascript -e "set volume without output muted" >/dev/null 2>&1; '
                'sleep 0.65; /usr/bin/osascript -e "set volume without output muted" >/dev/null 2>&1',
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


def handy_process_running() -> bool:
    """True when the Handy app process exists. A failed probe is treated as running so we do not relaunch it."""
    try:
        res = subprocess.run(
            ["/usr/bin/pgrep", "-x", "handy"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=1.0,
        )
        return res.returncode == 0
    except Exception:
        return True


def handy_is_recording() -> bool:
    """Manual fn barge-in has no recording flag from Handy. Never raise; a missing function used to kill the mic loop."""
    return False


def handy_exec(flag: str, allow_launch: bool = False) -> bool:
    """Send a flag to the running Handy app. Never launches the app unless allow_launch is set."""
    if not allow_launch and not handy_process_running():
        return False
    try:
        subprocess.run(
            [HANDY_BIN, flag],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=3.0,
            check=False,
        )
        return True
    except Exception:
        return False


def handy_window_open() -> bool:
    """False when the user has closed Handy's window. A failed probe is treated as still open."""
    if not handy_process_running():
        return False
    try:
        res = subprocess.run(
            [
                "/usr/bin/osascript",
                "-e",
                'tell application "System Events" to tell process "handy" to count windows',
            ],
            capture_output=True,
            text=True,
            timeout=1.0,
            check=False,
        )
        return int((res.stdout or "0").strip() or "0") > 0
    except Exception:
        return True


def handy_toggle(allow_launch: bool = False) -> bool:
    return handy_exec("--toggle-transcription", allow_launch=allow_launch)


def handy_start_recording(allow_launch: bool = False) -> bool:
    if not handy_cancel(allow_launch=allow_launch):
        return False
    time.sleep(0.08)
    started = handy_toggle(allow_launch=allow_launch)
    if started:
        unmute_async()
    return started


def handy_stop_recording() -> bool:
    return handy_toggle(allow_launch=False)


def handy_cancel(allow_launch: bool = False) -> bool:
    return handy_exec("--cancel", allow_launch=allow_launch)


HANDY_MODEL_QUALITY = "handy-computer/Qwen3-ASR-1.7B-gguf/Qwen3-ASR-1.7B-Q8_0.gguf"
HANDY_MODEL_LIGHT = "handy-computer/Qwen3-ASR-0.6B-gguf/Qwen3-ASR-0.6B-Q8_0.gguf"
STRATA_STATE = Path.home() / ".local/state/strata/omp-autostart.json"
_strata_loaded = False
_handy_on_light = False


def strata_loaded() -> bool:
    """True only while the local Strata engine is the running model."""
    try:
        raw = json.loads(STRATA_STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    return raw.get("engine") == "flash"


def _watch_strata() -> None:
    """Block on the state file. A start or stop is the only time this wakes."""
    global _strata_loaded
    while True:
        _strata_loaded = strata_loaded()
        try:
            fd = os.open(STRATA_STATE, os.O_EVTONLY)
        except OSError:
            time.sleep(5)
            continue
        try:
            kq = select.kqueue()
            event = select.kevent(
                fd,
                filter=select.KQ_FILTER_VNODE,
                flags=select.KQ_EV_ADD | select.KQ_EV_CLEAR,
                fflags=select.KQ_NOTE_WRITE | select.KQ_NOTE_ATTRIB | select.KQ_NOTE_RENAME | select.KQ_NOTE_DELETE,
            )
            kq.control([event], 0)
            kq.control(None, 1)
        except OSError:
            time.sleep(5)
        finally:
            os.close(fd)


def handy_model_id() -> str:
    try:
        raw = json.loads(HANDY_SETTINGS.read_text(encoding="utf-8"))
        return str(raw.get("settings", {}).get("selected_model", ""))
    except (OSError, ValueError):
        return ""


def apply_voicebox_model(strata_running: bool) -> bool:
    """0.6B while Strata is resident. 1.7B on the GPU when it is not."""
    size = "0.6B" if strata_running else "1.7B"
    drop = "qwen-tts-1.7B" if strata_running else "qwen-tts-0.6B"
    marker = STATE_DIR / "tts-model"
    loaded = ""
    try:
        with urllib.request.urlopen("http://127.0.0.1:17493/health", timeout=2) as res:
            loaded = str(json.loads(res.read().decode()).get("model_size") or "")
    except (OSError, ValueError, json.JSONDecodeError):
        log("VoiceBox health unread; speech tier not changed")
        return False
    if loaded == size:
        marker.write_text(size + "\n", encoding="utf-8")
        return True
    try:
        urllib.request.urlopen(
            urllib.request.Request(f"http://127.0.0.1:17493/models/{drop}/unload", method="POST"),
            timeout=60,
        )
        urllib.request.urlopen(
            urllib.request.Request(
                f"http://127.0.0.1:17493/models/load?model_size={size}",
                method="POST",
            ),
            timeout=180,
        )
    except (OSError, urllib.error.URLError) as exc:
        log(f"VoiceBox model switch to {size} failed: {exc}")
        return False
    marker.write_text(size + "\n", encoding="utf-8")
    log(f"VoiceBox model -> {size} ({'Strata loaded' if strata_running else 'Strata stopped'})")
    return True


def apply_handy_model(strata_running: bool) -> None:
    """1.7B by default. 0.6B only while Strata is resident."""
    global _handy_on_light
    want = HANDY_MODEL_LIGHT if strata_running else HANDY_MODEL_QUALITY
    if handy_model_id() == want:
        _handy_on_light = strata_running
        return
    try:
        raw = json.loads(HANDY_SETTINGS.read_text(encoding="utf-8"))
        raw.setdefault("settings", {})["selected_model"] = want
        HANDY_SETTINGS.write_text(json.dumps(raw, indent=2), encoding="utf-8")
    except (OSError, ValueError) as exc:
        log(f"Could not set Handy model: {exc}")
        return
    _handy_on_light = strata_running
    log(f"Handy model -> {want} ({'Strata loaded' if strata_running else 'Strata stopped'})")
    subprocess.run(["/usr/bin/pkill", "-f", "Handy.app/Contents/MacOS/handy"], check=False)
    time.sleep(0.4)
    subprocess.Popen(
        [HANDY_BIN, "--start-hidden"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def fallback_macos_inject(text: str, action: str) -> None:
    """Fallback if OMP bridge (:17494) is unreachable (e.g. OMP not yet reloaded)."""
    if action in ("appended", "paused") and text:
        subprocess.run(["/usr/bin/pbcopy"], input=text.encode("utf-8"), check=False)
        subprocess.run(
            [
                "/usr/bin/osascript",
                "-e",
                'tell application "System Events" to keystroke "v" using command down',
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    elif action == "sent":
        if text:
            subprocess.run(["/usr/bin/pbcopy"], input=text.encode("utf-8"), check=False)
            subprocess.run(
                [
                    "/usr/bin/osascript",
                    "-e",
                    'tell application "System Events" to keystroke "v" using command down',
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            time.sleep(0.12)
        subprocess.run(
            [
                "/usr/bin/osascript",
                "-e",
                'tell application "System Events" to key code 36',
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )


_GRAMMAR: dict | None = None


def command_grammar() -> dict:
    """Phrase of N words: one word from each of N lists, in order. Wake is optional in front."""
    global _GRAMMAR
    if _GRAMMAR is None:
        path = Path.home() / ".local" / "share" / "omp-voice" / "grammar.json"
        _GRAMMAR = json.loads(path.read_text(encoding="utf-8"))
        _GRAMMAR["wake"].sort(key=len, reverse=True)
    return _GRAMMAR


def _command_tokens(text: str) -> list[str]:
    return [token for token in re.sub(r"[\s.,!?;:]+", " ", text.lower()).strip().split(" ") if token]


def _slots_match(words: list[str], slots: list[list[str]]) -> bool:
    return len(words) == len(slots) and all(word in choices for word, choices in zip(words, slots))


def match_command(raw: str) -> dict | None:
    """Longest suffix that is an optional wake plus one word from each slot."""
    grammar = command_grammar()
    tokens = _command_tokens(raw)
    best: dict | None = None
    for start in range(len(tokens)):
        span = tokens[start:]
        for wake in [[], *grammar["wake"]]:
            if wake and span[: len(wake)] != wake:
                continue
            rest = span[len(wake) :]
            for group in grammar["actions"]:
                if not _slots_match(rest, group["slots"]):
                    continue
                if best is None or len(span) > best["span"]:
                    best = {
                        "span": len(span),
                        "action": group["action"],
                        "stem": [rest[0]],
                        "prefix": " ".join(tokens[:start]),
                        "phrase": " ".join(span),
                    }
    if best is None:
        return None
    best.pop("span")
    return best


def canonicalize_transcript(text: str) -> str:
    """Map a send-family suffix onto the phrase an older bridge already submits."""
    matched = match_command(text)
    if not matched or matched["action"] != "sent":
        return text
    prefix = matched["prefix"]
    return f"{prefix} send prompt".strip() if prefix else "send prompt"


def kill_tts_clips() -> None:
    """Stop VoiceBox speech clips only. Leave the wake chime, which is a different file."""
    try:
        listing = subprocess.check_output(["ps", "-axo", "pid=,command="], text=True)
    except Exception:
        return
    for line in listing.splitlines():
        if "afplay" not in line or "omp-vb-" not in line:
            continue
        pid = line.split(None, 1)[0]
        subprocess.run(["kill", "-9", pid], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def bridge_session_file() -> Path | None:
    """Session file of the OMP process that owns the voice bridge."""
    try:
        listeners = subprocess.check_output(["lsof", "-nP", "-iTCP:17494", "-sTCP:LISTEN"], text=True)
    except (OSError, subprocess.CalledProcessError):
        return None
    pid = ""
    for line in listeners.splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 2 and parts[1].isdigit():
            pid = parts[1]
            break
    if not pid:
        return None
    try:
        opened = subprocess.check_output(["lsof", "-nP", "-p", pid], text=True)
    except (OSError, subprocess.CalledProcessError):
        return None
    for line in opened.splitlines():
        if "/sessions/" in line and line.endswith(".jsonl"):
            return Path(line.split()[-1])
    return None


def watch_submitted_messages() -> None:
    """A typed or spoken send is the new turn. Stop leftover playback only.

    Do not abort the agent. The session file records the user message, the
    turn leaves idle, and this poll would then cancel that same turn
    ("Interrupted by user", 0 tokens). Wake and the fn barge-in still abort.
    """
    path: Path | None = None
    offset = 0
    while True:
        current = bridge_session_file()
        if current != path:
            path = current
            offset = path.stat().st_size if path and path.exists() else 0
        if path and path.exists():
            size = path.stat().st_size
            if size < offset:
                offset = size
            elif size > offset:
                with path.open(encoding="utf-8", errors="replace") as handle:
                    handle.seek(offset)
                    fresh = handle.read()
                    offset = handle.tell()
                for line in fresh.splitlines():
                    try:
                        event = json.loads(line)
                    except ValueError:
                        continue
                    message = event.get("message") if isinstance(event, dict) else None
                    if (
                        isinstance(event, dict)
                        and event.get("type") == "message"
                        and isinstance(message, dict)
                        and message.get("role") == "user"
                    ):
                        log("Submitted message -> stopping leftover playback")
                        silence_speech(False)
        time.sleep(0.4)


def fn_held() -> bool:
    """True while the Globe/fn key is down. Handy uses that key as push-to-talk."""
    try:
        flags = _coregraphics.CGEventSourceFlagsState(1)
    except Exception:
        return False
    return bool(int(flags) & 0x00800000)


def silence_speech(abort_agent: bool) -> None:
    # Kill the speakers before the bridge round-trip. Otherwise Handy records the reply.
    # Abort only the session that would receive the dictation. Other sessions lose
    # their audio but keep a turn that the user is not talking to.
    kill_tts_clips()
    try:
        target = resolve_delivery()
    except Exception:
        target = {"mode": "bridge", "port": 17494}
    target_base = bridge_base(target) if target.get("mode") == "bridge" else None
    for base in live_bridge_bases():
        bridge_request(
            "/barge-in",
            method="POST",
            body={"abortAgent": bool(abort_agent) and base == target_base},
            base=base,
        )

    def keep_killing() -> None:
        for _ in range(8):
            time.sleep(0.25)
            kill_tts_clips()

    threading.Thread(target=keep_killing, daemon=True).start()


def dispatch_transcript(text: str) -> dict:
    """Paste into the focused text control, or send to the newest omp when focus is not text."""
    original = " ".join(text.strip().split())
    if not original:
        return {"action": "noop", "draft": ""}

    try:
        dest = resolve_delivery()
    except Exception as exc:
        log(f"Delivery lookup failed ({exc}); using the legacy bridge")
        dest = {"mode": "bridge", "port": 17494, "focused_text": False}
    log(
        f"Delivery {dest.get('mode')} pid={dest.get('pid')} port={dest.get('port')} "
        f"focused_text={dest.get('focused_text')}"
    )
    if dest.get("mode") == "paste":
        fallback_macos_inject(original + " ", "appended")
        return {"action": "appended", "draft": original, "via": "focus"}

    base = bridge_base(dest)
    text = canonicalize_transcript(text)
    cleaned = " ".join(text.strip().split())
    if not cleaned:
        return {"action": "noop", "draft": ""}

    status = bridge_request("/status", method="GET", base=base)
    if status and status.get("ok"):
        if status.get("version", 1) >= 2:
            resp = bridge_request("/transcript", method="POST", body={"text": text}, base=base)
            if resp and resp.get("ok"):
                return resp
        else:
            # v1 bridge compatibility (before /reload-runtime):
            # Handy's Cmd+V already pasted `text` into the focused OMP editor if `draft` ends with `text`.
            current_draft = str(status.get("draft", ""))
            already_pasted = current_draft.rstrip().endswith(text.strip()) or current_draft.rstrip().endswith(cleaned)
            matched = match_command(cleaned)
            if already_pasted and not matched:
                return {"action": "appended", "draft": current_draft}
            if already_pasted and matched:
                n_del = len(text)
                subprocess.run(
                    [
                        "/usr/bin/osascript",
                        "-e",
                        f'tell application "System Events" to repeat {n_del} times\nkey code 51\nend repeat',
                    ],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
                time.sleep(0.08)
            if matched and matched["action"] == "paused":
                mapped = f"{matched['prefix']} pause listening".strip()
                resp = bridge_request("/transcript", method="POST", body={"text": mapped}, base=base)
                if resp and resp.get("ok"):
                    return resp
            if matched and matched["action"] == "sent":
                mapped = f"{matched['prefix']} send prompt".strip()
                resp = bridge_request("/transcript", method="POST", body={"text": mapped}, base=base)
                if resp and resp.get("ok"):
                    return resp
            resp = bridge_request("/transcript", method="POST", body={"text": text}, base=base)
            if resp and resp.get("ok"):
                return resp

    if dest.get("focused_text"):
        fallback_macos_inject(original + " ", "appended")
        return {"action": "appended", "draft": original, "via": "focus"}

    matched = match_command(cleaned)
    if matched and matched["action"] == "cancelled":
        return {"action": "cancelled", "strippedCommand": matched["phrase"]}
    if matched and matched["action"] == "paused":
        fallback_macos_inject(matched["prefix"] + (" " if matched["prefix"] else ""), "paused")
        return {"action": "paused", "strippedCommand": matched["phrase"]}
    if matched and matched["action"] == "sent":
        fallback_macos_inject(matched["prefix"], "sent")
        return {"action": "sent", "strippedCommand": matched["phrase"]}

    fallback_macos_inject(cleaned + " ", "appended")
    return {"action": "appended", "draft": cleaned}


def configure_handy_settings() -> None:
    """Ensure Handy keeps its ASR model warm and uses standard ctrl_v paste."""
    if not HANDY_SETTINGS.exists():
        return
    try:
        raw = json.loads(HANDY_SETTINGS.read_text(encoding="utf-8"))
        settings = raw.get("settings", {})
        changed = False
        if settings.get("mute_while_recording") is True:
            settings["mute_while_recording"] = False
            changed = True
        if settings.get("model_unload_timeout") == "min2":
            settings["model_unload_timeout"] = "hour1"
            changed = True
        if settings.get("selected_language") != "en":
            settings["selected_language"] = "en"
            changed = True
        if settings.get("paste_method") != "none":
            settings["paste_method"] = "none"
            settings["external_script_path"] = None
            changed = True
        if changed:
            HANDY_SETTINGS.write_text(json.dumps(raw, indent=2), encoding="utf-8")
            log("Updated Handy settings (mute_while_recording=False, model_unload_timeout=hour1, paste_method=none)")
    except Exception as exc:
        log(f"Warning: could not update Handy settings: {exc}")


def tts_wake_threshold(on_headphones: bool) -> float:
    """Same wake score during playback on the laptop mic and on headphones.

    The laptop used to require 0.50 because it hears the speakers. A real
    Hey Jarvis then fell through, and the whisper check transcribed the
    speaker audio instead of opening Handy.
    """
    return 0.35


def idle_command(heard: str) -> dict | None:
    """A command said alone, with no words before it."""
    matched = match_command(heard)
    if matched and not matched["prefix"]:
        return matched
    return None


def run_daemon(
    wake_word: str = "hey_jarvis",
    wake_threshold: float = 0.35,
    pause_seconds: float = 5.0,
    idle_timeout_seconds: float = 15.0,
    vad_threshold: float = 0.40,
) -> None:
    import sounddevice as sd
    from faster_whisper import WhisperModel
    from openwakeword.model import Model
    from openwakeword.vad import VAD

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    PID_FILE.write_text(str(os.getpid()), encoding="utf-8")
    configure_handy_settings()
    # Ensure macOS microphone input gain is at least 80% so across-the-room voice isn't attenuated
    subprocess.run(
        ["/usr/bin/osascript", "-e", "set volume input volume 85"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )

    log(f"Loading openWakeWord '{wake_word}' + Silero VAD + faster-whisper tiny.en wake verifier...")
    oww = Model(wakeword_models=[wake_word], inference_framework="onnx")
    vad = VAD()
    whisper = WhisperModel("tiny.en", device="cpu", compute_type="int8")

    sample_rate = 16000
    chunk_samples = 1280  # 80 ms frames

    state = "IDLE"
    last_history_id, _ = latest_history_row()
    speech_seen_in_chunk = False
    chunk_started_at = 0.0
    last_handy_ui_check = 0.0
    handy_ui_gone = False
    last_speech_at = 0.0
    cooldown_until = 0.0

    last_tts_check = 0.0
    last_tts_mute = 0.0
    last_manual_check = 0.0
    barge_mute = False
    tts_active = False
    fn_was_down = fn_held()
    fn_ignore_through = 0
    fn_cut_busy = False
    # Rolling speaker-bleed floor while VoiceBox plays. A person talking over the laptop
    # speakers sits well above that floor; a wake-word hit on the TTS audio does not.
    tts_rms_floor: deque[float] = deque(maxlen=25)  # ~2.0s
    tts_loud_run = 0
    tts_stop_frames: list[np.ndarray] = []
    tts_stop_silence = 0
    idle_pre_roll: deque[np.ndarray] = deque(maxlen=6)  # 480ms pre-roll
    idle_speech_frames: list[np.ndarray] = []
    idle_in_speech = False
    idle_silence_frames = 0

    # Rolling tail buffer in DICTATING for fast 1.5s detection of "send prompt" / "pause listening" / "cancel that"
    dict_tail_frames: deque[np.ndarray] = deque(maxlen=38)  # ~3.0s
    dict_speech_frames: list[np.ndarray] = []
    checked_fast_cmd = False

    def transcribe_local_fallback(frames_list: list[np.ndarray]) -> str:
        """If Handy failed to persist a row (e.g. Escape/fn interference), transcribe our buffered PCM directly."""
        if len(frames_list) < 6:
            return ""
        try:
            audio_i16 = np.concatenate(frames_list)
            if float(np.max(np.abs(audio_i16))) < 350.0:
                return ""
            audio_f32 = audio_i16.astype(np.float32) / 32768.0
            peak = float(np.max(np.abs(audio_f32)))
            if peak > 0.01:
                audio_f32 = np.clip(audio_f32 * min(5.0, 0.5 / peak), -1.0, 1.0)
            segments, _ = whisper.transcribe(
                audio_f32,
                language="en",
                beam_size=1,
                without_timestamps=True,
                initial_prompt="send prompt, prompt this, send that, submit prompt, scratch that, undo that, clear draft, pause listening.",
            )
            return " ".join(s.text for s in segments).strip()
        except Exception:
            return ""

    def stop_playback(reason: str) -> None:
        # Kill the clip and the turn. Stopping only afplay leaves the agent
        # streaming, and the next sentence starts the loop again.
        log(reason)
        silence_speech(True)

    def enter_dictating(reason: str) -> None:
        nonlocal state, speech_seen_in_chunk, chunk_started_at, last_speech_at, cooldown_until, last_history_id
        nonlocal last_handy_ui_check, handy_ui_gone
        nonlocal idle_in_speech, idle_silence_frames, checked_fast_cmd, barge_mute
        log(f"Wake triggered ({reason}) -> entering DICTATING")
        oww.reset()
        vad.reset_states()
        idle_speech_frames.clear()
        dict_tail_frames.clear()
        dict_speech_frames.clear()
        checked_fast_cmd = False
        idle_in_speech = False
        idle_silence_frames = 0
        # 1. Trigger Barge-in on VoiceBox if it's speaking (and abort any in-flight OMP generation/tool run)
        barge_mute = True
        silence_speech(True)
        # 2. Play Wake chime AND start Handy concurrently so any speech right after "Hey Jarvis" is never missed!
        play_cue(SOUND_WAKE, wait=False)
        last_history_id, _ = latest_history_row()
        # 3. Start Handy recording. This is the only path allowed to launch the app.
        handy_start_recording(allow_launch=True)
        handy_ui_gone = False
        last_handy_ui_check = time.monotonic()
        state = "DICTATING"
        speech_seen_in_chunk = False
        chunk_started_at = time.monotonic()
        last_speech_at = chunk_started_at
        cooldown_until = chunk_started_at + 0.25
        write_status(state, {"chunk_started_at": time.time(), "trigger": reason})

    global _strata_loaded, _handy_on_light
    _strata_loaded = strata_loaded()
    threading.Thread(target=_watch_strata, daemon=True).start()
    threading.Thread(target=watch_submitted_messages, daemon=True).start()
    apply_handy_model(_strata_loaded)
    if not apply_voicebox_model(_strata_loaded):
        _handy_on_light = not _strata_loaded
    write_status(state, {"wake_word": wake_word, "pause_seconds": pause_seconds})
    log(
        f"OMP Voice Controller ready in IDLE. Say 'Hey Jarvis' (or 'Jarvis') to start dictating; "
        f"pause {pause_seconds:.1f}s to flush chunk; say 'send prompt' to press Enter."
    )

    running = True

    def handle_sig(_signum: int, _frame: object) -> None:
        nonlocal running
        running = False

    signal.signal(signal.SIGINT, handle_sig)
    signal.signal(signal.SIGTERM, handle_sig)

    while running:
        try:
            sd._terminate()
            sd._initialize()
        except Exception:
            pass
        active_ca_dev = coreaudio_default_input_device_id()
        try:
            dev_info = sd.query_devices(kind="input")
            dev_name = str(dev_info.get("name", "default")) if isinstance(dev_info, dict) else "default"
        except Exception:
            dev_name = "default"
        on_headphones = any(
            word in dev_name.lower() for word in ("buds", "airpod", "headphone", "headset", "beats")
        )
        log(f"Opening microphone input stream on '{dev_name}' (CoreAudio id={active_ca_dev})")
        write_status(state, {"wake_word": wake_word, "pause_seconds": pause_seconds, "mic": dev_name})
        last_dev_check = time.monotonic()

        try:
            mic_frames: queue.Queue = queue.Queue(maxsize=32)

            def on_mic(indata, _frames, _time_info, _status) -> None:
                block = indata.copy()
                try:
                    mic_frames.put_nowait(block)
                except queue.Full:
                    try:
                        mic_frames.get_nowait()
                    except queue.Empty:
                        pass
                    try:
                        mic_frames.put_nowait(block)
                    except queue.Full:
                        pass

            with sd.InputStream(
                samplerate=sample_rate,
                channels=1,
                dtype="int16",
                blocksize=chunk_samples,
                callback=on_mic,
            ):
                while running:
                    kind, pcm_block, last_dev_check = next_mic_frame(
                        mic_frames,
                        active_ca_dev,
                        coreaudio_default_input_device_id,
                        last_dev_check,
                    )
                    if kind == "rebind":
                        new_ca_dev = coreaudio_default_input_device_id()
                        log(
                            f"macOS default microphone changed ({active_ca_dev} -> {new_ca_dev}); rebinding stream..."
                        )
                        subprocess.run(
                            ["/usr/bin/osascript", "-e", "set volume input volume 85"],
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL,
                            check=False,
                        )
                        break
                    if kind != "frame" or pcm_block is None:
                        continue
                    frame = pcm_block[:, 0]
                    now = time.monotonic()

                    if now < cooldown_until:
                        oww.predict(frame)
                        continue

                    rms = float(np.sqrt(np.mean(frame.astype(np.float32) ** 2)))
                    vad_score = float(vad.predict(frame))
                    is_speech = (vad_score >= vad_threshold) or (rms >= 320.0)
                    if barge_mute and (now - last_tts_mute) >= 0.25:
                        last_tts_mute = now
                        kill_tts_clips()
                        if not is_voicebox_speaking():
                            barge_mute = False

                    if state == "IDLE":
                        if _strata_loaded != _handy_on_light:
                            apply_handy_model(_strata_loaded)
                            if not apply_voicebox_model(_strata_loaded):
                                _handy_on_light = not _strata_loaded
                        if (now - last_manual_check) >= 1.0:
                            last_manual_check = now
                            manual_id, manual_txt = latest_history_row()
                            if manual_id > last_history_id and manual_id <= fn_ignore_through:
                                last_history_id = manual_id
                                log(f"Dropped Handy transcription #{manual_id} recorded over playback")
                            elif manual_id > last_history_id and manual_txt.strip():
                                last_history_id = manual_id
                                log(f"Manual Handy transcription #{manual_id}: {manual_txt!r}")
                                manual_outcome = dispatch_transcript(manual_txt)
                                manual_action = manual_outcome.get("action", "appended")
                                log(f"Manual chunk outcome: {manual_action}")
                                if manual_action == "sent":
                                    play_cue(SOUND_SEND, wait=False)
                                elif manual_action in ("paused", "cancelled", "scratched", "cleared"):
                                    play_cue(SOUND_CANCEL if manual_action in ("scratched", "cleared") else SOUND_PAUSE, wait=False)
                        if (now - last_tts_check) >= 0.24:
                            last_tts_check = now
                            tts_active = is_voicebox_speaking()
                        # Handy starts recording on fn. That used to keep the reply that was
                        # still coming out of the speakers. Cut the speakers on the key edge,
                        # throw away that take, and record again only if fn is still held.
                        fn_down = fn_held()
                        if fn_down and not fn_was_down and not fn_cut_busy and (tts_active or is_voicebox_speaking()):
                            fn_cut_busy = True
                            tts_active = False
                            kill_tts_clips()
                            log("fn held during playback -> stopping speech before Handy keeps it")

                            def cut_playback_then_listen() -> None:
                                nonlocal fn_ignore_through, fn_cut_busy
                                silence_speech(True)
                                handy_cancel(allow_launch=False)
                                deadline = time.monotonic() + 1.5
                                while time.monotonic() < deadline and is_voicebox_speaking():
                                    kill_tts_clips()
                                    time.sleep(0.05)
                                absorb_until = time.monotonic() + 0.45
                                while time.monotonic() < absorb_until:
                                    row_id, _ = latest_history_row()
                                    fn_ignore_through = max(fn_ignore_through, row_id)
                                    time.sleep(0.05)
                                if fn_held():
                                    handy_start_recording(allow_launch=False)
                                    log("fn barge-in: speakers stopped, recording restarted without the reply")
                                else:
                                    log("fn barge-in: speakers stopped")
                                fn_cut_busy = False

                            threading.Thread(target=cut_playback_then_listen, daemon=True).start()
                        fn_was_down = fn_down

                        # While VoiceBox is playing, only two phrases interrupt.
                        # "Hey Jarvis" stops playback and opens Handy.
                        # "stop" stops playback and does not open Handy.
                        # Noise and other words do not interrupt. Headphones use the
                        # voice detector instead of loudness, because the mic is not
                        # hearing the earpiece.
                        if tts_active:
                            idle_pre_roll.clear()
                            idle_speech_frames.clear()
                            idle_in_speech = False
                            idle_silence_frames = 0
                            on_headphones = any(
                                word in dev_name.lower()
                                for word in ("buds", "airpod", "headphone", "headset", "beats")
                            )
                            preds = oww.predict(frame)
                            score = float(preds.get(wake_word, 0.0))
                            if score >= tts_wake_threshold(on_headphones):
                                tts_loud_run = 0
                                tts_rms_floor.clear()
                                tts_stop_frames.clear()
                                tts_stop_silence = 0
                                enter_dictating(f"barge-in openWakeWord score={score:.2f}")
                                continue
                            floor = sorted(tts_rms_floor)[len(tts_rms_floor) // 2] if tts_rms_floor else 0.0
                            if on_headphones:
                                user_voice = vad_score >= 0.25 and rms >= 180.0
                                clip_limit = 18
                                clip_floor = 250.0
                            else:
                                # The laptop mic hears the speakers, so a normal "stop" is only
                                # a little louder than playback. The old 1.35x / rms 450 gate
                                # demanded a shout. Keep the clip short so the word is not
                                # drowned by the surrounding reply.
                                user_voice = vad_score >= 0.28 and rms >= max(140.0, floor * 1.08)
                                clip_limit = 10
                                clip_floor = 80.0
                            if user_voice:
                                tts_stop_silence = 0
                                tts_stop_frames.append(frame.copy())
                                flush_clip = len(tts_stop_frames) >= clip_limit
                            else:
                                flush_clip = bool(tts_stop_frames) and tts_stop_silence >= 3
                                if tts_stop_frames:
                                    tts_stop_silence += 1
                                    flush_clip = tts_stop_silence >= 4
                            if flush_clip and tts_stop_frames:
                                    clip = np.concatenate(tts_stop_frames)
                                    n_frames = len(tts_stop_frames)
                                    tts_stop_frames.clear()
                                    tts_stop_silence = 0
                                    if 2 <= n_frames <= 16 and float(np.max(np.abs(clip))) >= clip_floor:
                                        audio_f32 = clip.astype(np.float32) / 32768.0
                                        peak = float(np.max(np.abs(audio_f32)))
                                        if peak > 0.01:
                                            audio_f32 = np.clip(audio_f32 * min(6.0, 0.5 / peak), -1.0, 1.0)
                                        segments, _ = whisper.transcribe(
                                            audio_f32,
                                            language="en",
                                            beam_size=1,
                                            without_timestamps=True,
                                            initial_prompt="Hey Jarvis. stop.",
                                        )
                                        heard = " ".join(s.text for s in segments).strip()
                                        if re.fullmatch(
                                            r"(?:hey[\s,]+jarvis|ok[\s,]+jarvis|hello[\s,]+jarvis|jarvis)[\s.,!?]*",
                                            heard,
                                            re.IGNORECASE,
                                        ):
                                            tts_loud_run = 0
                                            tts_rms_floor.clear()
                                            enter_dictating(f"barge-in whisper heard {heard!r}")
                                            continue
                                        # "stop" and its tails come from the shared grammar, including a wake prefix.
                                        heard_cmd = match_command(heard)
                                        if heard_cmd and heard_cmd["action"] == "paused" and heard_cmd["stem"] == ["stop"]:
                                            stop_playback(f"Heard {heard!r} over TTS -> stopping speech, not opening Handy")
                                            tts_loud_run = 0
                                            tts_rms_floor.clear()
                                            tts_active = False
                                            continue
                                        if heard:
                                            log(f"Ignored {heard!r} over TTS (not stop)")
                            tts_rms_floor.append(rms)
                            continue
                        tts_loud_run = 0
                        tts_rms_floor.clear()
                        tts_stop_frames.clear()
                        tts_stop_silence = 0

                        # Path 1: Fast neural keyword spotter (with 3x gain normalization if mic signal is quiet)
                        boosted = np.clip(frame.astype(np.float32) * 3.0, -32768, 32767).astype(np.int16) if rms < 1200 else frame
                        preds = oww.predict(boosted)
                        score = float(preds.get(wake_word, 0.0))
                        if score >= wake_threshold:
                            enter_dictating(f"openWakeWord score={score:.2f}")
                            continue

                        # Path 2: Short utterance verifier (disabled while VoiceBox TTS is playing so continuous TTS speech isn't fed to Whisper)
                        if is_speech:
                            if not idle_in_speech:
                                idle_in_speech = True
                                idle_silence_frames = 0
                                idle_speech_frames.extend(idle_pre_roll)
                            idle_speech_frames.append(frame.copy())
                            # Cap at ~3.2s (40 frames) so long background conversations are ignored
                            if len(idle_speech_frames) > 42:
                                idle_speech_frames.clear()
                                idle_in_speech = False
                                idle_silence_frames = 0
                        else:
                            if not idle_in_speech:
                                idle_pre_roll.append(frame.copy())
                            else:
                                idle_speech_frames.append(frame.copy())
                                idle_silence_frames += 1
                                # 7 frames = 560ms of silence after a short burst (0.3s - 3.2s)
                                if idle_silence_frames >= 7:
                                    n_frames = len(idle_speech_frames)
                                    audio_i16 = np.concatenate(idle_speech_frames)
                                    idle_speech_frames.clear()
                                    idle_in_speech = False
                                    idle_silence_frames = 0
                                    if 5 <= n_frames <= 42 and float(np.max(np.abs(audio_i16))) >= 450.0:
                                        audio_f32 = audio_i16.astype(np.float32) / 32768.0
                                        peak = float(np.max(np.abs(audio_f32)))
                                        if peak > 0.01:
                                            audio_f32 = np.clip(audio_f32 * min(6.0, 0.5 / peak), -1.0, 1.0)
                                        segments, _ = whisper.transcribe(
                                            audio_f32,
                                            language="en",
                                            beam_size=1,
                                            without_timestamps=True,
                                            initial_prompt="Hey Jarvis, Jarvis, send prompt, prompt this, submit prompt, scratch that, undo that, clear draft.",
                                        )
                                        heard = " ".join(s.text for s in segments).strip()
                                        if re.fullmatch(r"(?:hey[\s,]+jarvis|ok[\s,]+jarvis|hello[\s,]+jarvis|jarvis)[\s.,!?]*", heard, re.IGNORECASE):
                                            enter_dictating(f"whisper heard {heard!r}")
                                            continue
                                        idle_cmd = idle_command(heard)
                                        if idle_cmd and idle_cmd["action"] == "sent":
                                            log(f"Standalone send phrase in IDLE ({heard!r}) -> submitting draft")
                                            outcome = dispatch_transcript("send prompt")
                                            if outcome.get("action") == "sent":
                                                play_cue(SOUND_SEND, wait=False)
                                            cooldown_until = time.monotonic() + 0.6
                                        elif idle_cmd and idle_cmd["action"] in ("scratched", "cleared"):
                                            log(f"Standalone scratch/clear phrase in IDLE ({heard!r}) -> scratching draft")
                                            outcome = dispatch_transcript(heard)
                                            play_cue(SOUND_CANCEL, wait=False)
                                            cooldown_until = time.monotonic() + 0.6

                    elif state == "DICTATING":
                        # Quitting Handy, or closing its window, must not launch it again.
                        # Skip the first 1.5s so the window we just opened can appear.
                        if (now - chunk_started_at) > 1.5 and (now - last_handy_ui_check) >= 1.0:
                            last_handy_ui_check = now
                            handy_ui_gone = not handy_process_running() or not handy_window_open()
                        if handy_ui_gone:
                            log("Handy was closed during dictation -> returning to IDLE without restarting it")
                            state = "IDLE"
                            oww.reset()
                            vad.reset_states()
                            dict_speech_frames.clear()
                            dict_tail_frames.clear()
                            speech_seen_in_chunk = False
                            cooldown_until = time.monotonic() + 0.6
                            write_status(state, {"last_action": "handy_closed"})
                            play_cue(SOUND_PAUSE, wait=False)
                            continue
                        # If the user manually pressed `fn` and Handy already finished a new row while we were waiting,
                        # consume and dispatch it immediately so we never re-toggle Handy out of sync!
                        live_id, live_txt = latest_history_row()
                        if live_id > last_history_id:
                            last_history_id = live_id
                            log(f"Detected manual Handy transcription #{live_id} during DICTATING: {live_txt!r}")
                            time.sleep(0.26)
                            outcome = dispatch_transcript(live_txt)
                            action = outcome.get("action", "appended")
                            log(f"Manual chunk outcome: {action}")
                            dict_tail_frames.clear()
                            dict_speech_frames.clear()
                            checked_fast_cmd = False
                            speech_seen_in_chunk = False
                            if action in ("sent", "paused", "cancelled"):
                                play_cue(SOUND_SEND if action == "sent" else SOUND_PAUSE, wait=False)
                                state = "IDLE"
                                oww.reset()
                                vad.reset_states()
                                cooldown_until = time.monotonic() + 0.6
                                write_status(state, {"last_action": action})
                            else:
                                play_cue(SOUND_CHUNK_TICK, wait=False)
                                handy_start_recording()
                                chunk_started_at = time.monotonic()
                                last_speech_at = chunk_started_at
                                cooldown_until = chunk_started_at + 0.25
                                write_status(state, {"last_action": action})
                            continue

                        # Headphones sit close to the mouth, so a quiet or slow phrase is
                        # still speech. The room-mic gate (vad 0.40 / rms 320) drops those
                        # frames, the 5s clock starts, and the rest of the sentence is cut.
                        heard_speech = is_speech or (on_headphones and (vad_score >= 0.15 or rms >= 30.0))
                        if heard_speech:
                            if not speech_seen_in_chunk:
                                log(f"Speech started in chunk (vad={vad_score:.2f}, rms={rms:.0f})")
                            speech_seen_in_chunk = True
                            last_speech_at = now
                            checked_fast_cmd = False
                            dict_tail_frames.append(frame.copy())
                            if len(dict_speech_frames) < 750:  # cap at ~60s
                                dict_speech_frames.append(frame.copy())
                        else:
                            if speech_seen_in_chunk:
                                dict_tail_frames.append(frame.copy())
                                if len(dict_speech_frames) < 750:
                                    dict_speech_frames.append(frame.copy())
                                silence_dur = now - last_speech_at
                                flush_after = 8.0 if on_headphones else pause_seconds
                                should_flush = silence_dur >= flush_after

                                if not should_flush and silence_dur >= 1.5 and not checked_fast_cmd and len(dict_tail_frames) >= 8:
                                    checked_fast_cmd = True
                                    tail_i16 = np.concatenate(list(dict_tail_frames))
                                    tail_f32 = tail_i16.astype(np.float32) / 32768.0
                                    peak = float(np.max(np.abs(tail_f32)))
                                    if peak > 0.01:
                                        tail_f32 = np.clip(tail_f32 * min(6.0, 0.5 / peak), -1.0, 1.0)
                                    segments, _ = whisper.transcribe(
                                        tail_f32,
                                        language="en",
                                        beam_size=1,
                                        without_timestamps=True,
                                        initial_prompt="send prompt, prompt this, submit prompt, pause listening, cancel that, scratch that, undo that, clear draft.",
                                    )
                                    tail_heard = " ".join(s.text for s in segments).strip()
                                    if match_command(tail_heard):
                                        log(f"Fast command phrase detected after {silence_dur:.1f}s silence ({tail_heard!r}) -> flushing now")
                                        should_flush = True

                                if should_flush:
                                    log(f"Pause of {silence_dur:.1f}s detected -> flushing chunk via Handy")
                                    prev_id = last_history_id
                                    if not handy_stop_recording():
                                        log("Handy is not running -> not launching it to flush")
                                        action = "handy_stopped"
                                        row = None
                                    else:
                                        row = wait_for_new_history_row(prev_id, timeout_sec=2.2)
                                    if row is not None:
                                        last_history_id, transcript = row
                                        log(f"Handy transcribed chunk #{last_history_id}: {transcript!r}")
                                        # Wait 260ms so Handy's native Cmd+V paste (229ms) finishes before OMP deduplicates & updates editor
                                        time.sleep(0.26)
                                        outcome = dispatch_transcript(transcript)
                                        action = outcome.get("action", "appended")
                                        log(f"Transcript outcome: {action}")
                                    else:
                                        # Handy was closed or its recording was cancelled. Keep any words we already
                                        # buffered, then go idle. Do not toggle Handy back on.
                                        fallback_txt = transcribe_local_fallback(dict_speech_frames)
                                        if fallback_txt:
                                            log(f"Handy row missing (stopped externally); kept local transcript: {fallback_txt!r}")
                                            dispatch_transcript(fallback_txt)
                                        else:
                                            log("Handy row missing (stopped externally); nothing to keep")
                                        action = "handy_stopped"

                                    dict_speech_frames.clear()
                                    if action == "sent":
                                        play_cue(SOUND_SEND, wait=False)
                                        state = "IDLE"
                                        oww.reset()
                                        vad.reset_states()
                                        dict_tail_frames.clear()
                                        cooldown_until = time.monotonic() + 0.6
                                        write_status(state, {"last_action": "sent"})
                                        log("Prompt submitted -> returned to IDLE")
                                    elif action == "paused":
                                        play_cue(SOUND_PAUSE, wait=False)
                                        state = "IDLE"
                                        oww.reset()
                                        vad.reset_states()
                                        dict_tail_frames.clear()
                                        cooldown_until = time.monotonic() + 0.6
                                        write_status(state, {"last_action": "paused"})
                                        log("Paused listening -> returned to IDLE (draft preserved)")
                                    elif action in ("scratched", "cleared"):
                                        # Play cancel/undo tone, keep DICTATING active so the user can immediately re-speak the corrected thought!
                                        play_cue(SOUND_CANCEL, wait=False)
                                        last_history_id, _ = latest_history_row()
                                        handy_start_recording()
                                        vad.reset_states()
                                        dict_tail_frames.clear()
                                        checked_fast_cmd = False
                                        speech_seen_in_chunk = False
                                        chunk_started_at = time.monotonic()
                                        last_speech_at = chunk_started_at
                                        cooldown_until = chunk_started_at + 0.25
                                        write_status(state, {"last_action": action})
                                        log(f"Draft {action} -> continuing DICTATING for replacement chunk...")
                                    elif action in ("cancelled", "handy_stopped"):
                                        play_cue(SOUND_PAUSE if action == "handy_stopped" else SOUND_CANCEL, wait=False)
                                        state = "IDLE"
                                        oww.reset()
                                        vad.reset_states()
                                        dict_tail_frames.clear()
                                        cooldown_until = time.monotonic() + 0.6
                                        write_status(state, {"last_action": action})
                                        log("Handy stopped -> returned to IDLE without restarting it")
                                    else:
                                        play_cue(SOUND_CHUNK_TICK, wait=False)
                                        last_history_id, _ = latest_history_row()
                                        handy_start_recording()
                                        vad.reset_states()
                                        dict_tail_frames.clear()
                                        checked_fast_cmd = False
                                        speech_seen_in_chunk = False
                                        chunk_started_at = time.monotonic()
                                        last_speech_at = chunk_started_at
                                        cooldown_until = chunk_started_at + 0.25
                                        write_status(state, {"last_action": "appended"})
                                        log("Continuing DICTATING for next chunk...")
                            else:
                                if (now - chunk_started_at) >= idle_timeout_seconds:
                                    log(f"No speech for {idle_timeout_seconds:.0f}s in DICTATING -> cancelling Handy & returning to IDLE")
                                    handy_cancel()
                                    play_cue(SOUND_PAUSE, wait=False)
                                    state = "IDLE"
                                    oww.reset()
                                    vad.reset_states()
                                    cooldown_until = time.monotonic() + 0.5
                                    write_status(state, {"last_action": "idle_timeout"})
        except Exception as stream_err:
            log(f"Audio stream interrupted ({stream_err}); reconnecting in 1.0s...")
            time.sleep(1.0)

    if state == "DICTATING":
        handy_cancel()
    write_status("STOPPED")
    try:
        PID_FILE.unlink(missing_ok=True)
    except Exception:
        pass
    log("OMP Voice Controller stopped.")


def cmd_status() -> int:
    bridge = bridge_request("/status", method="GET")
    try:
        delivery = resolve_delivery()
    except Exception as exc:
        delivery = {"mode": "unknown", "error": str(exc)}
    ctrl = json.loads(STATUS_FILE.read_text(encoding="utf-8")) if STATUS_FILE.exists() else {"state": "STOPPED"}
    pid = ctrl.get("pid")
    alive = False
    if isinstance(pid, int):
        try:
            os.kill(pid, 0)
            alive = True
        except OSError:
            alive = False
    print(
        json.dumps(
            {
                "controller": {**ctrl, "alive": alive},
                "delivery": delivery,
                "omp_bridge": bridge or {"ok": False, "note": "Restart/reload OMP session to bind :17494"},
            },
            indent=2,
        )
    )
    return 0


def cmd_stop() -> int:
    if not PID_FILE.exists():
        print("OMP Voice Controller is not running.")
        return 0
    try:
        pid = int(PID_FILE.read_text(encoding="utf-8").strip())
        os.kill(pid, signal.SIGTERM)
        for _ in range(30):
            try:
                os.kill(pid, 0)
                time.sleep(0.05)
            except OSError:
                break
        PID_FILE.unlink(missing_ok=True)
        print(f"Stopped OMP Voice Controller (pid {pid}).")
    except Exception as exc:
        print(f"Controller not running ({exc}).")
        PID_FILE.unlink(missing_ok=True)
    return 0


def cmd_start_bg(args: argparse.Namespace) -> int:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text(encoding="utf-8").strip())
            os.kill(pid, 0)
            print(f"OMP Voice Controller already running (pid {pid}).")
            return 0
        except OSError:
            PID_FILE.unlink(missing_ok=True)

    cmd = [
        sys.executable,
        str(Path(__file__).resolve()),
        "run",
        "--wake-word",
        args.wake_word,
        "--wake-threshold",
        str(args.wake_threshold),
        "--pause-seconds",
        str(args.pause_seconds),
        "--idle-timeout",
        str(args.idle_timeout),
    ]
    log_fh = open(LOG_FILE, "a", encoding="utf-8")
    proc = subprocess.Popen(
        cmd,
        stdout=log_fh,
        stderr=log_fh,
        stdin=subprocess.DEVNULL,
        start_new_session=True,
    )
    time.sleep(1.2)
    print(f"Started OMP Voice Controller in background (pid {proc.pid}, log: {LOG_FILE})")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="OMP Hands-Free Voice Controller")
    sub = parser.add_subparsers(dest="subcommand")

    for name in ("run", "start"):
        p = sub.add_parser(name)
        p.add_argument("--wake-word", default="hey_jarvis", help="openWakeWord model name (default: hey_jarvis)")
        p.add_argument("--wake-threshold", type=float, default=0.35, help="Wake word threshold 0..1 (default: 0.35)")
        p.add_argument("--pause-seconds", type=float, default=5.0, help="Silence pause to flush chunk (default: 5.0)")
        p.add_argument("--idle-timeout", type=float, default=15.0, help="Max silence with no speech before IDLE (default: 15.0)")

    sub.add_parser("stop")
    sub.add_parser("status")

    p_send = sub.add_parser("inject", help="Send a synthetic transcript chunk through the OMP bridge")
    p_send.add_argument("text", help="Transcript text to inject")

    p_hook = sub.add_parser("handy-hook", help="Handy external_script_path hook receiver")
    p_hook.add_argument("args", nargs="*", help="Optional transcript args from Handy")

    sub.add_parser("barge-in", help="Immediately silence VoiceBox playback")

    args = parser.parse_args()
    if args.subcommand == "handy-hook":
        ctrl = json.loads(STATUS_FILE.read_text(encoding="utf-8")) if STATUS_FILE.exists() else {"state": "STOPPED"}
        if ctrl.get("state") == "DICTATING":
            return 0
        text = " ".join(args.args).strip()
        if not text and not sys.stdin.isatty():
            text = sys.stdin.read().strip()
        if not text:
            _, text = latest_history_row()
        if text:
            dispatch_transcript(text)
        return 0
    if args.subcommand == "run":
        run_daemon(
            wake_word=args.wake_word,
            wake_threshold=args.wake_threshold,
            pause_seconds=args.pause_seconds,
            idle_timeout_seconds=args.idle_timeout,
        )
        return 0
    if args.subcommand == "start":
        return cmd_start_bg(args)
    if args.subcommand == "stop":
        return cmd_stop()
    if args.subcommand == "inject":
        print(json.dumps(dispatch_transcript(args.text), indent=2))
        return 0
    if args.subcommand == "barge-in":
        print(json.dumps(bridge_request("/barge-in", method="POST", body={}) or {"ok": False}, indent=2))
        return 0
    return cmd_status()


if __name__ == "__main__":
    raise SystemExit(main())
