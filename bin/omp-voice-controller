_coreaudio = None
_coregraphics = None


def _load_macos_frameworks() -> tuple[ctypes.CDLL, ctypes.CDLL]:
    """Load CoreAudio/CoreGraphics on first use so import works off macOS."""
    global _coreaudio, _coregraphics
    if _coreaudio is None or _coregraphics is None:
        audio = ctypes.CDLL("/System/Library/Frameworks/CoreAudio.framework/CoreAudio")
        graphics = ctypes.CDLL("/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics")
        graphics.CGEventSourceFlagsState.argtypes = [ctypes.c_uint32]
        graphics.CGEventSourceFlagsState.restype = ctypes.c_uint64
        _coreaudio = audio
        _coregraphics = graphics
    return _coreaudio, _coregraphics


class _AudioObjectPropertyAddress(ctypes.Structure):
    _fields_ = [
        ("mSelector", ctypes.c_uint32),
        ("mScope", ctypes.c_uint32),
        ("mElement", ctypes.c_uint32),
    ]


def coreaudio_default_input_device_id() -> int:
    """Return macOS CoreAudio kAudioHardwarePropertyDefaultInputDevice ID so we detect headphone hotplug."""
    try:
        audio, _graphics = _load_macos_frameworks()
        addr = _AudioObjectPropertyAddress(CA_SELECTOR_DEFAULT_INPUT, CA_SCOPE_GLOBAL, 0)
        dev_id = ctypes.c_uint32(0)
        size = ctypes.c_uint32(ctypes.sizeof(dev_id))
        res = audio.AudioObjectGetPropertyData(
            1, ctypes.byref(addr), 0, None, ctypes.byref(size), ctypes.byref(dev_id)
        )
        return int(dev_id.value) if res == 0 else -1
    except Exception:
        return -1


def next_mic_frame(
    frames: queue.Queue,
    active_id: int,
    device_id,
    last_check: float,
    check_every: float = DEVICE_CHECK_SECONDS,
) -> tuple[str, object, float]:
    """Return the next mic block, or ask the caller to reopen the device.

    The wait is capped at half a second. A blocking PortAudio read does not
    return after stream.abort() once the default input device changes, and the
    wake word and the Handy paste poll both sit behind that read.
    """
    try:
        block = frames.get(timeout=min(MIC_FRAME_WAIT_CAP_SECONDS, check_every))
    except queue.Empty:
        block = None
    now = time.monotonic()
    if now - last_check >= check_every:
        last_check = now
        new_id = device_id()
        if new_id != -1 and active_id != -1 and new_id != active_id:
            return "rebind", None, last_check
    if block is None:
        return "idle", None, last_check
    return "frame", block, last_check


def stamp_mic_block(block: object, captured_at: float) -> tuple[object, float]:
    """Pair a callback block with the wall time it finished. The samples are not logged."""
    return block, float(captured_at)


def block_end_wall_time(
    wall_now: float,
    adc_time: float | None,
    stream_now: float | None,
    frames: int,
    sample_rate: int,
) -> float:
    """Wall time when the block ended, not when the callback ran.

    adc_time and stream_now share PortAudio's clock. The gap from the end of
    the ADC block to stream_now is how late the callback is. A missing or
    backwards clock keeps wall_now.
    """
    if (
        isinstance(adc_time, bool)
        or isinstance(stream_now, bool)
        or not isinstance(adc_time, (int, float))
        or not isinstance(stream_now, (int, float))
        or frames <= 0
        or sample_rate <= 0
    ):
        return wall_now
    late = float(stream_now) - (float(adc_time) + frames / sample_rate)
    if late <= 0:
        return wall_now
    return wall_now - late


def mic_block_samples(item: object) -> object:
    if isinstance(item, tuple) and len(item) == 2 and isinstance(item[1], float):
        return item[0]
    return item


def mic_block_captured_at(item: object) -> float | None:
    if isinstance(item, tuple) and len(item) == 2 and isinstance(item[1], float):
        return item[1]
    return None


_capture_lock = threading.Lock()
_mic_dropped = 0
_mic_invalid = 0


def frame_status_invalid(status: object) -> bool:
    """True when PortAudio reports an input overflow, underflow, or a status string."""
    if status is None or status == "":
        return False
    if isinstance(status, bool):
        return status
    if getattr(status, "input_overflow", False) or getattr(status, "input_underflow", False):
        return True
    if isinstance(status, str):
        return True
    return bool(status)


def offer_mic_frame(frames: queue.Queue, block: object, status: object = None) -> tuple[int, int]:
    """Queue one callback block. Returns (dropped, invalid), each a count for this call.

    A full queue drops the oldest block so the newest audio is kept. The block
    itself is never logged.
    """
    invalid = 1 if frame_status_invalid(status) else 0
    try:
        frames.put_nowait(block)
        return 0, invalid
    except queue.Full:
        pass
    try:
        frames.get_nowait()
    except queue.Empty:
        return 1, invalid
    try:
        frames.put_nowait(block)
    except queue.Full:
        return 2, invalid
    return 1, invalid


def record_mic_offer(dropped: int, invalid: int) -> None:
    global _mic_dropped, _mic_invalid
    if dropped == 0 and invalid == 0:
        return
    with _capture_lock:
        _mic_dropped += dropped
        _mic_invalid += invalid


def slot_reference(slot: dict) -> dict | None:
    """The WAV afplay is playing, as published on the playback slot.

    This is the render description. It is not echo cancellation.
    """
    if not isinstance(slot, dict):
        return None
    ref = slot.get("reference")
    if not isinstance(ref, dict):
        return None
    rate = ref.get("sample_rate")
    channels = ref.get("channels")
    frames = ref.get("frames")
    wav = ref.get("wav")
    if isinstance(rate, bool) or not isinstance(rate, int) or rate < 8000:
        return None
    if isinstance(channels, bool) or not isinstance(channels, int) or channels <= 0:
        return None
    if isinstance(frames, bool) or not isinstance(frames, int) or frames <= 0:
        return None
    if not isinstance(wav, str) or not wav.endswith(".wav"):
        return None
    return {"sample_rate": rate, "channels": channels, "frames": frames, "wav": wav}


def resample_to_mic_rate(pcm: np.ndarray, src_rate: int, dst_rate: int = 16000) -> np.ndarray:
    """Linear map of mono PCM onto the microphone rate. Same-rate input is copied.

    This is not a band-limited resampler. It exists so a 22050 Hz VoiceBox file
    can be compared with a 16 kHz microphone block.
    """
    samples = np.ascontiguousarray(pcm, dtype=np.int16)
    if src_rate == dst_rate:
        return samples
    if src_rate < 8000 or dst_rate < 8000 or len(samples) == 0:
        return np.zeros(0, dtype=np.int16)
    out_len = int(len(samples) * dst_rate / src_rate)
    if out_len <= 0:
        return np.zeros(0, dtype=np.int16)
    pos = np.arange(out_len, dtype=np.float64) * (src_rate / dst_rate)
    i0 = np.minimum(np.floor(pos).astype(np.int64), len(samples) - 1)
    i1 = np.minimum(i0 + 1, len(samples) - 1)
    frac = (pos - i0).astype(np.float32)
    mixed = samples[i0].astype(np.float32) * (1.0 - frac) + samples[i1].astype(np.float32) * frac
    return np.clip(np.rint(mixed), -32768, 32767).astype(np.int16)


def downmix_to_mono(pcm: np.ndarray, channels: int) -> np.ndarray:
    """Average interleaved channels onto one. Mono passes through unchanged.

    afplay sends stereo to both speakers and the microphone hears their sum,
    so the averaged pair is the render reference for a stereo clip.
    """
    if channels <= 1:
        return pcm
    frames = len(pcm) // channels
    if frames <= 0:
        return np.zeros(0, dtype=np.int16)
    mixed = pcm[: frames * channels].reshape(frames, channels).mean(axis=1)
    return np.clip(np.rint(mixed), -32768, 32767).astype(np.int16)


def playback_rate_of(slot: dict) -> float:
    """afplay -r for this clip. Missing or out of range means 1x.

    The voice command accepts 0.7 to 2.0. The default in the extension is 1.18.
    """
    if not isinstance(slot, dict):
        return 1.0
    raw = slot.get("playback_rate")
    if isinstance(raw, bool) or not isinstance(raw, (int, float)):
        return 1.0
    rate = float(raw)
    if rate < 0.7 or rate > 2.0:
        return 1.0
    return rate


def render_cursor(started_at: float, now: float, sample_rate: int, playback_rate: float = 1.0) -> int:
    """How many file samples afplay has consumed since the clip started."""
    if sample_rate <= 0 or playback_rate <= 0 or now <= started_at:
        return 0
    return int((now - started_at) * sample_rate * playback_rate)


def parse_wav_pcm(data: bytes) -> dict | None:
    """16-bit PCM payload of a WAV file. None when the file is not that format."""
    if len(data) < 44 or data[0:4] != b"RIFF" or data[8:12] != b"WAVE":
        return None
    offset = 12
    fmt = None
    pcm = None
    while offset + 8 <= len(data):
        ident = data[offset : offset + 4]
        size = int.from_bytes(data[offset + 4 : offset + 8], "little")
        body = offset + 8
        if size < 0 or body + size > len(data):
            return None
        if ident == b"fmt " and size >= 16:
            fmt = struct.unpack_from("<HHIIHH", data, body)
        elif ident == b"data":
            pcm = data[body : body + size]
        offset = body + size + (size % 2)
    if fmt is None or pcm is None:
        return None
    format_id, channels, rate, _byte_rate, block, bits = fmt
    if format_id != 1 or bits != 16 or channels < 1 or rate < 8000:
        return None
    if block != channels * 2 or len(pcm) < block or len(pcm) % block != 0:
        return None
    return {"sample_rate": rate, "channels": channels, "frames": len(pcm) // block, "pcm": pcm}


def connect_render_reference(slot: dict, wav_bytes: bytes, now: float) -> dict | None:
    """Accept the WAV only when its PCM header matches the slot that names it.

    The returned pcm bytes are the samples afplay was given. They are not a
    cancelled microphone signal.
    """
    announced = slot_reference(slot)
    parsed = parse_wav_pcm(wav_bytes) if wav_bytes else None
    if announced is None or parsed is None:
        return None
    if (
        parsed["sample_rate"] != announced["sample_rate"]
        or parsed["channels"] != announced["channels"]
        or parsed["frames"] != announced["frames"]
    ):
        return None
    started = slot.get("started_at")
    rate = playback_rate_of(slot)
    cursor = 0
    if isinstance(started, (int, float)) and not isinstance(started, bool):
        cursor = render_cursor(float(started), now, parsed["sample_rate"], rate)
    if cursor > parsed["frames"]:
        cursor = parsed["frames"]
    return {
        "connected": True,
        "sample_rate": parsed["sample_rate"],
        "channels": parsed["channels"],
        "frames": parsed["frames"],
        "cursor": cursor,
        "aligned": parsed["sample_rate"] == 16000 and parsed["channels"] == 1,
        "pcm_bytes": len(parsed["pcm"]),
        "pcm": parsed["pcm"],
        "started_at": float(started) if isinstance(started, (int, float)) and not isinstance(started, bool) else None,
        "playback_rate": rate,
    }


def render_overlap(start: int, mic_len: int, render_len: int) -> tuple[int, int] | None:
    """Mic slice that lands inside the render when sample 0 would be at start."""
    mic_lo = max(0, -start)
    mic_hi = min(mic_len, render_len - start)
    if mic_hi <= mic_lo:
        return None
    return mic_lo, mic_hi


def best_render_delay(
    mic: np.ndarray,
    render: np.ndarray,
    position: int,
    max_delay: int,
    min_corr: float,
    step: int = 1,
) -> int | None:
    """Lag where the microphone block best matches the playback, or None.

    A weak match is left alone. This is a single delay, not a room model.
    """
    if step < 1 or max_delay < 0 or len(mic) == 0 or len(render) == 0:
        return None
    mic_f = mic.astype(np.float32)
    mic_energy = float(np.dot(mic_f, mic_f))
    if mic_energy < 1.0:
        return None

    def score_at(lag: int) -> float:
        start = position - lag
        span = render_overlap(start, len(mic), len(render))
        if span is None:
            return -1.0
        mic_lo, mic_hi = span
        full = mic_lo == 0 and mic_hi == len(mic)
        if not full and mic_hi - mic_lo < 160:
            return -1.0
        piece = mic_f[mic_lo:mic_hi]
        ref = render[start + mic_lo : start + mic_hi].astype(np.float32)
        piece_energy = float(np.dot(piece, piece))
        ref_energy = float(np.dot(ref, ref))
        if piece_energy < 1.0 or ref_energy < 1.0:
            return -1.0
        return float(np.dot(piece, ref) / np.sqrt(piece_energy * ref_energy))

    best_lag = None
    best_score = min_corr
    for lag in range(0, max_delay + 1, step):
        score = score_at(lag)
        if score > best_score:
            best_score = score
            best_lag = lag
    if best_lag is None or step == 1:
        return best_lag
    for lag in range(max(0, best_lag - step), min(max_delay, best_lag + step) + 1):
        score = score_at(lag)
        if score > best_score:
            best_score = score
            best_lag = lag
    return best_lag


def subtract_aligned_render(mic: np.ndarray, render: np.ndarray, position: int, delay: int) -> np.ndarray | None:
    """Remove a scaled copy of the playback from the mic block. None if it does not fit."""
    start = position - delay
    if start < 0 or start + len(mic) > len(render):
        return None
    mic_i = mic.astype(np.float32)
    ref = render[start : start + len(mic)].astype(np.float32)
    ref_energy = float(np.dot(ref, ref))
    if ref_energy < 1.0:
        return None
    gain = float(np.dot(mic_i, ref) / ref_energy)
    if gain <= 0.0 or gain > 4.0:
        return None
    cleaned = np.clip(np.rint(mic_i - gain * ref), -32768, 32767)
    return cleaned.astype(np.int16)


def subtract_render_filter(
    mic: np.ndarray,
    render: np.ndarray,
    position: int,
    delay: int,
    taps: int = 48,
) -> np.ndarray | None:
    """Remove a short filtered copy of the playback around one delay.

    The correlation peak is not always the first arrival, so the taps extend
    a few samples before it and a few after it. Each tap is at most 4, and the
    taps together are at most 4. A fit outside that range is rejected. This is
    not a room model.
    """
    if taps < 1:
        return None
    mic_i = mic.astype(np.float64)
    first = -(taps // 2) + 1
    start0 = position - delay
    span = render_overlap(start0, len(mic), len(render))
    if span is None:
        return None
    mic_lo, mic_hi = span
    if (mic_lo != 0 or mic_hi != len(mic)) and mic_hi - mic_lo < 160:
        return None
    cols = []
    for offset in range(first, first + taps):
        start = position - delay - offset
        if start + mic_lo < 0 or start + mic_hi > len(render):
            if offset == 0:
                return None
            continue
        cols.append(render[start + mic_lo : start + mic_hi].astype(np.float64))
    if not cols:
        return None
    piece = mic_i[mic_lo:mic_hi]
    coef, *_ = np.linalg.lstsq(np.column_stack(cols), piece, rcond=None)
    if float(np.max(coef)) <= 0.0 or float(np.max(np.abs(coef))) > 4.0 or float(np.sum(np.abs(coef))) > 4.0:
        return None
    cleaned = np.array(mic_i, copy=True)
    cleaned[mic_lo:mic_hi] = piece - np.column_stack(cols) @ coef
    return np.clip(np.rint(cleaned), -32768, 32767).astype(np.int16)


def subtract_playback_at(
    frame: np.ndarray,
    render: np.ndarray,
    started_at: float,
    captured_at: float,
    max_delay: int = 2400,
    min_corr: float = 0.75,
    playback_rate: float = 1.0,
    paused_seconds: float = 0.0,
) -> tuple[np.ndarray, int | None]:
    """Place the block at the render index of its capture time, not a later read.

    playback_rate is afplay -r. One wall-clock second consumes that many seconds of the file.
    paused_seconds is time afplay spent stopped, which does not advance the file.
    """
    end_position = render_cursor(started_at, captured_at - paused_seconds, 16000, playback_rate)
    return remove_render_from_block(frame, render, end_position, max_delay, min_corr)


def remove_render_from_block(
    mic: np.ndarray,
    render: np.ndarray,
    end_position: int,
    max_delay: int,
    min_corr: float,
) -> tuple[np.ndarray, int | None]:
    """Subtract playback from a block that ends at end_position.

    The clock is the render index just after the block. Delay zero lines the
    first mic sample up with end_position - len(mic). The returned delay is
    that acoustic lag. It does not include the length of the block.
    """
    origin = end_position - len(mic)
    delay = best_render_delay(mic, render, origin, max_delay, min_corr, step=1)
    if delay is None:
        return mic, None
    cleaned = subtract_render_filter(mic, render, origin, delay)
    if cleaned is None:
        cleaned = subtract_aligned_render(mic, render, origin, delay)
    if cleaned is None:
        return mic, None
    return cleaned, delay


def apply_render_subtraction(frame: np.ndarray, captured_at: float | None = None) -> np.ndarray:
    """Remove a delayed copy of our playback from one mic block.

    captured_at is the wall time the callback finished the block. The time the
    block is later read from the queue is not used. A weak correlation leaves
    the block unchanged. This is not a room model.
    """
    parsed = _render_parsed
    samples = _render_samples
    if not parsed or samples is None or not parsed.get("aligned"):
        return frame
    started = parsed.get("started_at")
    if not isinstance(started, float):
        return frame
    when = time.time() if captured_at is None else captured_at
    rate = parsed.get("playback_rate")
    if isinstance(rate, bool) or not isinstance(rate, (int, float)):
        rate = 1.0
    cleaned, delay = subtract_playback_at(
        frame, samples, started, when, playback_rate=float(rate), paused_seconds=paused_playback_seconds(when)
    )
    if delay is None:
        return frame
    log_once(f"render-delay-{delay}", f"render copy removed at delay {delay}")
    return cleaned


AEC_FRAME_SAMPLES = 160
_echo_ap = None
_echo_key = None
_echo_unavailable = False


def make_echo_canceller(delay_ms: int = 0):
    """Desktop echo control only. Noise suppression and gain control stay off.

    The barge path reads RMS. A gain controller would move those gates.
    delay_ms is the starting hint. The canceller estimates the rest.
    """
    from aec_audio_processing import AudioProcessor

    processor = AudioProcessor(
        enable_aec=True,
        enable_ns=False,
        enable_agc=False,
        enable_vad=False,
    )
    processor.set_stream_format(16000, 1)
    processor.set_reverse_stream_format(16000, 1)
    processor.set_stream_delay(delay_ms)
    return processor


def render_block_at(
    render: np.ndarray,
    started_at: float,
    captured_at: float,
    n: int,
    playback_rate: float,
    paused_seconds: float,
) -> np.ndarray:
    """Far-end samples for one mic block, lined up with render_cursor.

    Sample zero of the block is the file sample at the start of the capture.
    Samples outside the file are silence. This is not an acoustic delay.
    """
    end_position = render_cursor(started_at, captured_at - paused_seconds, 16000, playback_rate)
    origin = end_position - n
    block = np.zeros(n, dtype=np.int16)
    src_lo = max(0, origin)
    src_hi = min(len(render), origin + n)
    if src_hi > src_lo:
        dst_lo = src_lo - origin
        block[dst_lo : dst_lo + (src_hi - src_lo)] = render[src_lo:src_hi]
    return block


def process_echo_block(processor, mic: np.ndarray, reverse: np.ndarray) -> np.ndarray:
    """10 ms frames, reverse then capture, joined back in order.

    A length that is not a whole number of frames is returned unchanged.
    """
    mic_i = np.asarray(mic, dtype=np.int16).reshape(-1)
    reverse_i = np.asarray(reverse, dtype=np.int16).reshape(-1)
    if len(mic_i) != len(reverse_i) or len(mic_i) == 0 or len(mic_i) % AEC_FRAME_SAMPLES:
        return mic_i
    out = np.empty(len(mic_i), dtype=np.int16)
    for start in range(0, len(mic_i), AEC_FRAME_SAMPLES):
        stop = start + AEC_FRAME_SAMPLES
        processor.process_reverse_stream(reverse_i[start:stop].tobytes())
        cleaned = np.frombuffer(
            processor.process_stream(mic_i[start:stop].tobytes()),
            dtype=np.int16,
        )
        out[start:stop] = cleaned
    return out


def playback_echo_canceller(file_key):
    """One canceller per clip. A new file starts from an empty filter."""
    global _echo_ap, _echo_key, _echo_unavailable
    if _echo_unavailable:
        return None
    if _echo_ap is not None and _echo_key == file_key:
        return _echo_ap
    try:
        processor = make_echo_canceller()
    except ImportError:
        _echo_unavailable = True
        _echo_ap = None
        log_once("echo-cancel-missing", "WebRTC echo control unavailable; using the short render fit")
        return None
    _echo_ap = processor
    _echo_key = file_key
    log_once("echo-cancel", "WebRTC echo control on the playback reference")
    return processor


def cancel_playback_echo(frame: np.ndarray, captured_at: float | None = None) -> np.ndarray:
    """Remove our playback before VAD. The short fit runs only if this module is missing.

    No reference means the block is unchanged. Idle audio is not filtered.
    """
    parsed = _render_parsed
    samples = _render_samples
    if not parsed or samples is None or not parsed.get("aligned"):
        return frame
    started = parsed.get("started_at")
    if not isinstance(started, float):
        return frame
    processor = playback_echo_canceller(_render_file_key)
    if processor is None:
        return apply_render_subtraction(frame, captured_at)
    when = time.time() if captured_at is None else captured_at
    rate = parsed.get("playback_rate")
    if isinstance(rate, bool) or not isinstance(rate, (int, float)):
        rate = 1.0
    mic = np.asarray(frame, dtype=np.int16).reshape(-1)
    reverse = render_block_at(
        samples,
        started,
        when,
        len(mic),
        float(rate),
        paused_playback_seconds(when),
    )
    return process_echo_block(processor, mic, reverse)


def render_status_fields(connected: dict | None) -> dict:
    if not connected:
        return {"render_connected": False}
    return {
        "render_connected": True,
        "render_rate": connected["sample_rate"],
        "render_channels": connected["channels"],
        "render_frames": connected["frames"],
        "render_cursor": connected["cursor"],
        "render_aligned": connected["aligned"],
    }


_render_pcm = b""
_render_samples: np.ndarray | None = None
_render_fields = {"render_connected": False}
_render_file_key: tuple | None = None
_render_hold_until = 0.0
_render_paused_at: float | None = None
_render_paused_seconds = 0.0


def _slot_rank(slot: dict) -> tuple[float, int, int]:
    started = slot.get("started_at")
    try:
        started_f = float(started) if isinstance(started, (int, float)) and not isinstance(started, bool) else 0.0
    except (TypeError, ValueError):
        started_f = 0.0
    turn = slot.get("turn")
    clip = slot.get("clip")
    turn_i = turn if isinstance(turn, int) and not isinstance(turn, bool) else -1
    clip_i = clip if isinstance(clip, int) and not isinstance(clip, bool) else -1
    return (started_f, turn_i, clip_i)


def choose_render_slot(slots, now: float, pid_alive_fn) -> dict | None:
    """Newest slot that is speaking and names a WAV. Directory order is not used."""
    chosen = None
    best: tuple[float, int, int] | None = None
    for slot in slots:
        if not isinstance(slot, dict) or slot_reference(slot) is None:
            continue
        if not slot_is_speaking(slot, now, pid_alive_fn, 0.0):
            continue
        rank = _slot_rank(slot)
        if best is None or rank > best:
            best = rank
            chosen = slot
    return chosen


def refresh_render_reference(now: float | None = None) -> dict:
    """Load the newest speaking slot's WAV when the file matches that slot.

    After the slot ends, the PCM already in memory is kept for the reverb tail.
    The WAV file is deleted when afplay exits, so this does not read it again.
    """
    global _render_pcm, _render_samples, _render_fields, _render_file_key, _render_parsed, _render_hold_until, _render_paused_at, _render_paused_seconds
    moment = time.time() if now is None else now
    slots = _read_playback_slots() or []
    chosen = choose_render_slot(slots, moment, pid_alive)
    if chosen is None:
        if (
            _render_samples is not None
            and _render_parsed
            and _render_parsed.get("aligned")
            and moment < _render_hold_until
        ):
            _render_fields = render_status_fields(_render_parsed)
            return _render_fields
        _render_hold_until = 0.0
        _render_paused_at = None
        _render_paused_seconds = 0.0
        _render_pcm = b""
        _render_samples = None
        _render_file_key = None
        _render_parsed = None
        _render_fields = render_status_fields(None)
        return _render_fields
    ref = slot_reference(chosen)
    assert ref is not None
    key = (ref["wav"], ref["frames"], ref["sample_rate"], ref["channels"])
    if key != _render_file_key:
        _render_paused_at = None
        _render_paused_seconds = 0.0
        try:
            blob = Path(ref["wav"]).read_bytes()
        except OSError:
            blob = b""
        connected = connect_render_reference(chosen, blob, moment)
        _render_file_key = key
        if connected is None:
            _render_pcm = b""
            _render_samples = None
            _render_parsed = None
            _render_fields = render_status_fields(None)
            return _render_fields
        _render_pcm = connected["pcm"]
        raw = np.frombuffer(connected["pcm"], dtype="<i2").copy()
        _render_parsed = {key: value for key, value in connected.items() if key != "pcm"}
        mono = downmix_to_mono(raw, int(connected["channels"]))
        _render_samples = resample_to_mic_rate(mono, int(connected["sample_rate"]))
        _render_parsed["aligned"] = _render_samples.size > 0
    elif _render_parsed is None:
        _render_fields = render_status_fields(None)
        return _render_fields
    else:
        started = chosen.get("started_at")
        cursor = 0
        if isinstance(started, (int, float)) and not isinstance(started, bool):
            # Wall time includes SIGSTOP. The file does not move during that interval.
            playing_at = moment - paused_playback_seconds(moment)
            cursor = render_cursor(
                float(started), playing_at, int(_render_parsed["sample_rate"]), playback_rate_of(chosen)
            )
        _render_parsed = {**_render_parsed, "playback_rate": playback_rate_of(chosen)}
        if cursor > int(_render_parsed["frames"]):
            cursor = int(_render_parsed["frames"])
        _render_parsed = {**_render_parsed, "cursor": cursor}
    if _render_parsed and _render_parsed.get("aligned") and _render_samples is not None and len(_render_samples):
        _render_hold_until = moment + REVERB_TAIL_GUARD_SECONDS
    _render_fields = render_status_fields(_render_parsed)
    return _render_fields


def capture_totals() -> tuple[int, int]:
    with _capture_lock:
        return _mic_dropped, _mic_invalid


PLAYBACK_LEASE_SECONDS = 60.0


def _valid_pid(value: object) -> int | None:
    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
        return None
    return value


def slot_is_speaking(slot: dict, now: float, pid_alive_fn, tail: float) -> bool:
    """One session slot. A dead afplay is silence. A clean end keeps the reverb tail."""
    if not isinstance(slot, dict):
        return False
    ended_raw = slot.get("ended_at")
    try:
        ended = float(ended_raw) if ended_raw not in (None, "") else 0.0
    except (TypeError, ValueError):
        ended = 0.0
    if slot.get("playing") is not True:
        return ended > 0 and (now - ended) < tail
    afplay = _valid_pid(slot.get("afplay_pid"))
    writer = _valid_pid(slot.get("writer_pid"))
    if afplay is not None:
        if not pid_alive_fn(afplay):
            return False
        if writer is not None and not pid_alive_fn(writer):
            try:
                started = float(slot.get("started_at") or 0)
            except (TypeError, ValueError):
                started = 0.0
            return now < started + PLAYBACK_LEASE_SECONDS
        return True
    if writer is None or not pid_alive_fn(writer):
        return False
    try:
        lease = float(slot.get("lease_until") or 0)
    except (TypeError, ValueError):
        lease = 0.0
    return now < lease


def playback_is_speaking(data: dict, now: float, pid_alive_fn, tail: float) -> bool:
    """Legacy files have no sessions object and do not check pids."""
    if not isinstance(data, dict):
        return False
    sessions = data.get("sessions")
    if isinstance(sessions, dict):
        return any(
            isinstance(slot, dict) and slot_is_speaking(slot, now, pid_alive_fn, tail)
            for slot in sessions.values()
        )
    if data.get("playing") is True and not data.get("ended_at"):
        return True
    try:
        ended = float(data.get("ended_at", 0) or 0)
    except (TypeError, ValueError):
        return False
    return ended > 0 and (now - ended) < tail


def playback_sources_speaking(slots, legacy, now: float, pid_alive_fn, tail: float) -> bool:
    """slots is None only when the tts-playing directory is absent."""
    if slots is not None:
        return any(
            isinstance(slot, dict) and slot_is_speaking(slot, now, pid_alive_fn, tail) for slot in slots
        )
    if not isinstance(legacy, dict):
        return False
    return playback_is_speaking(legacy, now, pid_alive_fn, tail)


def _read_playback_slots() -> list[dict] | None:
    slot_dir = playback_slot_dir()
    if not slot_dir.is_dir():
        return None
    owner = playback_owner_pid()
    found: list[dict] = []
    for path in slot_dir.glob("*.json"):
        if not path.stem.isdigit():
            continue
        if owner and path.stem != owner:
            continue
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if isinstance(data, dict):
            found.append(data)
    return found


def _tts_file_says_speaking() -> bool:
    """True while a session slot is active or inside the reverb tail.

    The tts-playing directory is the authority when it exists. The flat
    tts-playing.json file is only the projection the old reader understood.
    A new write must flip this immediately, so it is not cached.
    """
    now = time.time()
    slots = _read_playback_slots()
    if slots is not None:
        return playback_sources_speaking(slots, None, now, pid_alive, REVERB_TAIL_GUARD_SECONDS)
    if not TTS_STATE_FILE.exists():
        return False
    try:
        data = json.loads(TTS_STATE_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    if not isinstance(data, dict):
        return False
    return playback_is_speaking(data, now, pid_alive, REVERB_TAIL_GUARD_SECONDS)


def is_voicebox_speaking() -> bool:
    """True only while tts-playing.json says this clip is ours."""
    try:
        return _tts_file_says_speaking()
    except (OSError, ValueError, TypeError):
        return False


LOG_ROTATE_BYTES = 1_048_576


def rotate_log(path: Path, limit_bytes: int) -> bool:
    """Keep one backup once a log passes the limit. A missing file is left alone."""
    try:
        if path.stat().st_size <= limit_bytes:
            return False
        backup = path.with_name(path.name + ".1")
        backup.unlink(missing_ok=True)
        path.rename(backup)
    except OSError:
        return False
    return True


def log(msg: str) -> None:
    ts = time.strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] {msg}"
    print(line, flush=True)


def log_once(key: str, msg: str) -> None:
    """One line for a hot path (missing cue, status write). Not an error every poll."""
    if key in _logged_once:
        return
    _logged_once.add(key)
    log(msg)


def _reap_cues() -> None:
    with _cue_lock:
        still_running: list[subprocess.Popen] = []
        for proc in _cue_procs:
            if proc.poll() is None:
                still_running.append(proc)
        _cue_procs[:] = still_running


def _spawn_tracked(argv: list[str]) -> subprocess.Popen:
    """start_new_session lets init reap if we exit; we also poll finished children."""
    _reap_cues()
    proc = subprocess.Popen(
        argv,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    with _cue_lock:
        _cue_procs.append(proc)
    return proc


def play_cue(path: str, wait: bool = False) -> None:
    if not os.path.exists(path):
        log_once(f"cue-missing:{path}", f"play_cue skipped, file missing: {path}")
        return
    try:
        proc = _spawn_tracked(["/usr/bin/afplay", path])
        if wait:
            proc.wait(timeout=CUE_WAIT_TIMEOUT_SECONDS)
            _reap_cues()
    except Exception as exc:
        log(f"play_cue failed: {exc}")


def publish_capture_totals() -> None:
    """Record drop counts and the render link without erasing the other fields."""
    dropped, invalid = capture_totals()
    render = refresh_render_reference()
    if not STATUS_FILE.exists():
        return
    try:
        data = json.loads(STATUS_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return
    if not isinstance(data, dict):
        return
    changed = data.get("mic_dropped") != dropped or data.get("mic_invalid") != invalid
    for key, value in render.items():
        if data.get(key) != value:
            changed = True
    if not changed:
        return
    note = None
    if data.get("mic_dropped") != dropped or data.get("mic_invalid") != invalid:
        note = f"mic capture dropped={dropped} invalid={invalid}"
    if data.get("render_connected") != render.get("render_connected"):
        if render.get("render_connected"):
            note = (
                f"render reference connected rate={render['render_rate']} "
                f"frames={render['render_frames']} aligned={render['render_aligned']}"
            )
        else:
            note = "render reference unavailable"
    data["mic_dropped"] = dropped
    data["mic_invalid"] = invalid
    data.update(render)
    tmp = STATUS_FILE.with_suffix(".capture.tmp")
    tmp.write_text(json.dumps(data, indent=2), encoding="utf-8")
    tmp.replace(STATUS_FILE)
    if note:
        log(note)


def write_status(state: str, extra: dict | None = None) -> None:
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        payload = {
            "state": state,
            "pid": os.getpid(),
            "updated_at": time.time(),
        }
        if extra:
            payload.update(extra)
        dropped, invalid = capture_totals()
        payload["mic_dropped"] = dropped
        payload["mic_invalid"] = invalid
        payload.update(_render_fields)
        tmp = STATUS_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps(payload, indent=2), encoding="utf-8")
        tmp.replace(STATUS_FILE)
    except Exception as exc:
        log_once("write-status", f"write_status failed: {exc}")


def bridge_request(
    path: str,
    method: str = "GET",
    body: dict | None = None,
    timeout: float = BRIDGE_REQUEST_TIMEOUT_SECONDS,
    base: str | None = None,
) -> dict | None:
    url = f"{base or OMP_BRIDGE_URL}{path}"
    data = json.dumps(body).encode("utf-8") if body is not None else None
    headers = {"content-type": "application/json"} if data is not None else {}
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception as exc:
        log_once(f"bridge-{url}", f"bridge_request {url} failed: {exc}")
        return None


def normalize_tty(value: object) -> str | None:
    if not isinstance(value, str):
        return None
    text = value.strip()
    if not text or text in {"?", "??", "stdin", "-"}:
        return None
    if text.startswith("/dev/tty"):
        return text
    if text.startswith("tty"):
        return "/dev/" + text
    return None


def normalize_started_at(value: object) -> float:
    try:
        number = float(value)  # type: ignore[arg-type]
    except (TypeError, ValueError):
        return 0.0
    if number > 10_000_000_000:
        return number / 1000.0
    return number


def choose_delivery(
    focus: dict | None,
    sessions: list[dict],
    legacy_owner_pid: int | None,
) -> dict:
    """Pick where a Handy transcript goes.

    A focused text control wins. An omp tab with its own bridge gets the
    transcript through that bridge. Any other text control is a paste.
    When the focused control is not text, the newest omp session gets it.
    """
    text_role = focus_is_text(focus)
    tty = normalize_tty(focus.get("tty")) if focus else None
    usable: list[dict] = []
    for session in sessions:
        pid = session.get("pid")
        if not isinstance(pid, int):
            continue
        port = session.get("port")
        usable.append(
            {
                "pid": pid,
                "tty": normalize_tty(session.get("tty")),
                "started_at": normalize_started_at(session.get("started_at")),
                "port": port if isinstance(port, int) and port > 0 else None,
            }
        )

    def bridge(session: dict, port: int) -> dict:
        return {"mode": "bridge", "pid": session["pid"], "port": port, "focused_text": text_role}

    def paste(pid: int | None = None) -> dict:
        return {"mode": "paste", "pid": pid, "port": None, "focused_text": text_role}

    if text_role:
        matches = [session for session in usable if tty and session["tty"] == tty]
        if len(matches) == 1:
            session = matches[0]
            if session["port"]:
                return bridge(session, session["port"])
            if legacy_owner_pid == session["pid"]:
                return bridge(session, 17494)
            return paste(session["pid"])
        return paste(None)

    if not usable:
        return paste(None)
    newest = max(usable, key=lambda session: (session["started_at"], session["pid"]))
    if newest["port"]:
        return bridge(newest, newest["port"])
    if legacy_owner_pid == newest["pid"]:
        return bridge(newest, 17494)
    return paste(newest["pid"])


def focus_is_text(focus: dict | None) -> bool:
    if not focus:
        return False
    if focus.get("editable") is True:
        return True
    return focus.get("role") in TEXT_ROLES


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def pid_tty(pid: int) -> str | None:
    try:
        out = subprocess.check_output(
            ["lsof", "-nP", "-a", "-p", str(pid), "-d", "0", "-Fn"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    for line in out.splitlines():
        if line.startswith("n"):
            return normalize_tty(line[1:])
    return None


def pid_started_at(pid: int) -> float:
    try:
        raw = subprocess.check_output(["ps", "-p", str(pid), "-o", "lstart="], text=True).strip()
        return datetime.datetime.strptime(raw, "%a %b %d %H:%M:%S %Y").timestamp()
    except (OSError, subprocess.CalledProcessError, ValueError):
        return 0.0


def omp_ui_pids() -> list[int]:
    try:
        out = subprocess.check_output(["ps", "-ax", "-o", "pid=,command="], text=True)
    except (OSError, subprocess.CalledProcessError):
        return []
    pids: list[int] = []
    for line in out.splitlines():
        line = line.strip()
        if not line or "__omp_worker" in line:
            continue
        pid_s, _, cmd = line.partition(" ")
        if not pid_s.isdigit() or not cmd:
            continue
        exe = cmd.split()[0]
        if exe == "omp" or exe.endswith("/omp"):
            pids.append(int(pid_s))
    return pids


def legacy_bridge_owner_pid() -> int | None:
    try:
        out = subprocess.check_output(
            ["lsof", "-nP", "-iTCP:17494", "-sTCP:LISTEN", "-t"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    for line in out.splitlines():
        line = line.strip()
        if line.isdigit():
            return int(line)
    return None


def load_session_registry() -> dict[int, dict]:
    found: dict[int, dict] = {}
    if not SESSION_DIR.exists():
        return found
    for path in SESSION_DIR.glob("*.json"):
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            pid = int(data["pid"])
        except (OSError, ValueError, KeyError, TypeError):
            continue
        if not pid_alive(pid):
            try:
                path.unlink(missing_ok=True)
            except OSError:
                pass
            continue
        port = data.get("port")
        found[pid] = {
            "pid": pid,
            "tty": normalize_tty(data.get("tty")),
            "started_at": normalize_started_at(data.get("startedAt")),
            "port": int(port) if isinstance(port, int) and port > 0 else None,
        }
    return found


def loopback_listen_port(lsof_text: str) -> int | None:
    """The one 127.0.0.1 listen port in lsof -F n output. Two different ports is no guess."""
    ports: list[int] = []
    for line in lsof_text.splitlines():
        if not line.startswith("n"):
            continue
        host, sep, port = line[1:].rpartition(":")
        if not sep or host not in {"127.0.0.1", "localhost"} or not port.isdigit():
            continue
        number = int(port)
        if number not in ports:
            ports.append(number)
    if len(ports) != 1:
        return None
    return ports[0]


def pid_bridge_port(pid: int) -> int | None:
    """Registry files disappear while the bridge is still listening. One loopback port that answers /status is that bridge."""
    try:
        text = subprocess.check_output(
            ["lsof", "-nP", "-a", "-p", str(pid), "-iTCP", "-sTCP:LISTEN", "-F", "n"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    port = loopback_listen_port(text)
    if port is None:
        return None
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/status", timeout=1) as res:
            data = json.loads(res.read().decode())
    except (OSError, ValueError, json.JSONDecodeError):
        return None
    if not isinstance(data, dict) or data.get("ok") is not True or data.get("pid") != pid:
        return None
    return port


def omp_session_records() -> list[dict]:
    records = load_session_registry()
    for pid in omp_ui_pids():
        if not pid_alive(pid):
            continue
        current = records.get(pid, {"pid": pid, "tty": None, "started_at": 0, "port": None})
        if not current.get("tty"):
            current["tty"] = pid_tty(pid)
        if not current.get("started_at"):
            current["started_at"] = pid_started_at(pid)
        if not current.get("port"):
            current["port"] = pid_bridge_port(pid)
        records[pid] = current
    return list(records.values())


_FOCUSED_TEXT_SCRIPT = """
tell application "System Events"
  set frontApp to first application process whose frontmost is true
  set appName to name of frontApp
  try
    -- Chromium and Electron hide a web text box until this is on. Native
    -- AppKit fields already report a text role. Either way this is the front
    -- app, not one browser.
    set value of attribute "AXEnhancedUserInterface" of frontApp to true
  end try
  try
    set value of attribute "AXManualAccessibility" of frontApp to true
  end try
  set roleName to ""
  set editable to "no"
  set textRoles to {"AXTextArea", "AXTextField", "AXComboBox", "AXSearchField", "AXTextView", "AXSecureTextField"}
  repeat 6 times
    try
      set focusedElem to value of attribute "AXFocusedUIElement" of frontApp
      if focusedElem is not missing value then
        try
          set roleName to role of focusedElem
        end try
        set subName to ""
        try
          set subName to subrole of focusedElem
        end try
        if roleName is in textRoles or subName is in {"AXSecureTextField", "AXSearchField"} then
          set editable to "yes"
        else
          try
            set selRange to value of attribute "AXSelectedTextRange" of focusedElem
            set editable to "yes"
          end try
          if editable is "no" then
            try
              set anc to value of attribute "AXHighestEditableAncestor" of focusedElem
              if anc is not missing value then
                set ancRole to role of anc
                if ancRole is in textRoles then
                  set editable to "yes"
                  if roleName is "" then set roleName to ancRole
                end if
              end if
            end try
          end if
        end if
        exit repeat
      end if
    end try
    delay 0.05
  end repeat
end tell
return appName & linefeed & roleName & linefeed & editable
"""


def focused_text_context() -> dict | None:
    raw = subprocess.run(
        ["/usr/bin/osascript", "-e", _FOCUSED_TEXT_SCRIPT],
        capture_output=True,
        text=True,
        check=False,
    )
    if raw.returncode != 0:
        log(f"Focus lookup failed ({raw.stderr.strip() or raw.returncode})")
        return None
    lines = [line.strip() for line in raw.stdout.splitlines()]
    app = lines[0] if lines else ""
    role = lines[1] if len(lines) > 1 else ""
    editable = len(lines) > 2 and lines[2] == "yes"
    if role not in TEXT_ROLES and not editable:
        log(f"Focus is not a text box app={app!r} role={role!r}")
        return None
    log(f"Focus text box app={app!r} role={role!r}")
    tty_script = None
    if app == "Terminal":
        tty_script = 'tell application "Terminal" to tty of selected tab of front window'
    elif app in {"iTerm2", "iTerm"}:
        tty_script = 'tell application "iTerm" to tty of current session of current window'
    tty = None
    if tty_script:
        tty_run = subprocess.run(
            ["/usr/bin/osascript", "-e", tty_script],
            capture_output=True,
            text=True,
            check=False,
        )
        if tty_run.returncode == 0:
            tty = tty_run.stdout.strip()
    return {"app": app, "role": role, "tty": tty, "editable": editable}


def resolve_delivery() -> dict:
    only = bridge_only_base()
    if only:
        port = int(only.rsplit(":", 1)[-1])
        pid_text = playback_owner_pid()
        pid = int(pid_text) if pid_text.isdigit() else None
        return {"mode": "bridge", "port": port, "pid": pid, "focused_text": False}
    return choose_delivery(focused_text_context(), omp_session_records(), legacy_bridge_owner_pid())


def bridge_base(dest: dict) -> str:
    port = dest.get("port") or 17494
    return f"http://127.0.0.1:{int(port)}"


def bridge_status_targets(sessions: list[dict], legacy_owner_pid: int | None) -> list[str]:
    bases: list[str] = []
    for session in sessions:
        port = session.get("port")
        if isinstance(port, int) and not isinstance(port, bool) and port > 0:
            bases.append(f"http://127.0.0.1:{port}")
    if legacy_owner_pid is not None:
        bases.append("http://127.0.0.1:17494")
    deduped: list[str] = []
    for base in bases:
        if base not in deduped:
            deduped.append(base)
    return deduped


def live_bridge_bases() -> list[str]:
    only = bridge_only_base()
    if only:
        return [only]
    return bridge_status_targets(omp_session_records(), legacy_bridge_owner_pid())


def status_probe_order(delivery: dict, targets: list[str]) -> list[str]:
    ordered = list(targets)
    if delivery.get("mode") != "bridge":
        return ordered
    port = delivery.get("port")
    if not isinstance(port, int) or isinstance(port, bool) or port <= 0:
        return ordered
    preferred = f"http://127.0.0.1:{port}"
    return [preferred, *[base for base in ordered if base != preferred]]


LEGACY_BRIDGE_URL = "http://127.0.0.1:17494"
NO_BRIDGE_NOTE = "No session bridge responded"
LEGACY_BIND_NOTE = "Restart the OMP session (/restart) to bind :17494"


def probe_bridge_status(delivery: dict, targets: list[str]) -> dict:
    ordered = status_probe_order(delivery, targets)
    for base in ordered:
        response = bridge_request("/status", method="GET", base=base)
        if isinstance(response, dict) and response.get("ok") is True:
            return {**response, "url": base}
    note = NO_BRIDGE_NOTE
    if LEGACY_BRIDGE_URL in ordered:
        note = f"{NO_BRIDGE_NOTE}. {LEGACY_BIND_NOTE}"
    return {"ok": False, "note": note, "targets": ordered}


def latest_history_row() -> tuple[int, str]:
    if not HANDY_DB.exists():
        return (0, "")
    try:
        conn = sqlite3.connect(f"file:{HANDY_DB}?mode=ro", uri=True, timeout=1.5)
        try:
            cur = conn.execute(
                "SELECT id, COALESCE(post_processed_text, transcription_text, '') "
                "FROM transcription_history ORDER BY id DESC LIMIT 1"
            )
            row = cur.fetchone()
            if not row:
                return (0, "")
            return (int(row[0]), str(row[1]))
        finally:
            conn.close()
    except Exception as exc:
        log_once("handy-db", f"latest_history_row failed: {exc}")
        return (0, "")


def wait_for_new_history_row(after_id: int, timeout_sec: float = 6.0) -> tuple[int, str] | None:
    deadline = time.monotonic() + timeout_sec
    while time.monotonic() < deadline:
        row_id, text = latest_history_row()
        if row_id > after_id:
            return (row_id, text)
        time.sleep(HISTORY_POLL_SECONDS)
    return None


def unmute_async() -> None:
    """Unmute in two beats; the tracked spawn is reaped like the cue children."""
    try:
        _spawn_tracked(
            [
                "/bin/sh",
                "-c",
                f'sleep {UNMUTE_FIRST_DELAY_SECONDS}; /usr/bin/osascript -e "set volume without output muted" >/dev/null 2>&1; '
                f'sleep {UNMUTE_SECOND_DELAY_SECONDS}; /usr/bin/osascript -e "set volume without output muted" >/dev/null 2>&1',
            ]
        )
    except Exception as exc:
        log_once("unmute", f"unmute_async failed: {exc}")


def handy_process_running() -> bool:
    """True when the Handy app process exists. A failed probe is treated as running so we do not relaunch it."""
    try:
        res = subprocess.run(
            ["/usr/bin/pgrep", "-x", "handy"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=OSASKA_PROBE_TIMEOUT_SECONDS,
        )
        return res.returncode == 0
    except Exception as exc:
        log_once("handy-probe", f"handy_process_running failed: {exc}")
        return True


def handy_is_recording() -> bool:
    """Manual fn barge-in has no recording flag from Handy. Never raise; a missing function used to kill the mic loop."""
    return False


def handy_exec(flag: str, allow_launch: bool = False) -> bool:
    """Send a flag to the running Handy app. Never launches the app unless allow_launch is set."""
    if not allow_launch and not handy_process_running():
        return False
    try:
        subprocess.run(
            [HANDY_BIN, flag],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=3.0,
            check=False,
        )
        return True
    except Exception as exc:
        log(f"handy_exec {flag} failed: {exc}")
        return False


def handy_window_open() -> bool:
    """False when the user has closed Handy's window. A failed probe is treated as still open."""
    if not handy_process_running():
        return False
    try:
        res = subprocess.run(
            [
                "/usr/bin/osascript",
                "-e",
                'tell application "System Events" to tell process "handy" to count windows',
            ],
            capture_output=True,
            text=True,
            timeout=OSASKA_PROBE_TIMEOUT_SECONDS,
            check=False,
        )
        return int((res.stdout or "0").strip() or "0") > 0
    except Exception as exc:
        log_once("handy-window", f"handy_window_open probe failed: {exc}")
        return True


def handy_toggle(allow_launch: bool = False) -> bool:
    return handy_exec("--toggle-transcription", allow_launch=allow_launch)


def handy_start_recording(allow_launch: bool = False, *, fresh: bool = False) -> bool:
    # A wake from IDLE is not already recording. Cancel here blocks the mic
    # loop for a Handy round-trip and drops the words right after the wake.
    if not fresh:
        if not handy_cancel(allow_launch=allow_launch):
            return False
        time.sleep(HANDY_RESTART_PAUSE_SECONDS)
    started = handy_toggle(allow_launch=allow_launch)
    if started:
        unmute_async()
    return started


def handy_stop_recording() -> bool:
    return handy_toggle(allow_launch=False)


def handy_cancel(allow_launch: bool = False) -> bool:
    return handy_exec("--cancel", allow_launch=allow_launch)


HANDY_MODEL_QUALITY = "handy-computer/Qwen3-ASR-1.7B-gguf/Qwen3-ASR-1.7B-Q8_0.gguf"
HANDY_MODEL_LIGHT = "handy-computer/Qwen3-ASR-0.6B-gguf/Qwen3-ASR-0.6B-Q8_0.gguf"
STRATA_STATE = Path.home() / ".local/state/strata/omp-autostart.json"
# threading.Event, not a bare bool: _watch_strata writes it from a background
# thread while the mic loop reads it. All access goes through the event.
_handy_on_light = False
_voicebox_want: bool | None = None
_voicebox_ok = False
_voicebox_retry_at = 0.0
VOICEBOX_HEALTH_RETRY_SECONDS = 5.0


def sync_speech_tier(now: float) -> None:
    """Keep Handy on the Strata tier. Ask VoiceBox again 5 s after a refusal.

    File mode must not get here: apply_handy_model kills the shared Handy app.

    A down VoiceBox used to invert the Handy flag, so the next mic frame tried
    again. That was a health check and a log line about twelve times a second.
    """
    if handy_file_mode():
        return
    global _voicebox_want, _voicebox_ok, _voicebox_retry_at
    strata_running = _strata_loaded.is_set()
    if strata_running != _handy_on_light:
        apply_handy_model(strata_running)
    if strata_running != _voicebox_want:
        _voicebox_want = strata_running
        _voicebox_ok = False
        _voicebox_retry_at = 0.0
        _logged_once.discard("voicebox-health")
    if _voicebox_ok or now < _voicebox_retry_at:
        return
    if apply_voicebox_model(strata_running):
        _voicebox_ok = True
        _logged_once.discard("voicebox-health")
        return
    _voicebox_retry_at = now + VOICEBOX_HEALTH_RETRY_SECONDS


def strata_loaded() -> bool:
    """True only while the local Strata engine is the running model."""
    try:
        raw = json.loads(STRATA_STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    return raw.get("engine") == "flash"


def _set_strata_loaded(loaded: bool) -> None:
    if loaded:
        _strata_loaded.set()
    else:
        _strata_loaded.clear()


def _watch_strata() -> None:
    """Block on the state file. A start or stop is the only time this wakes."""
    while _daemon_running.is_set():
        _set_strata_loaded(strata_loaded())
        try:
            fd = os.open(STRATA_STATE, os.O_EVTONLY)
        except OSError:
            time.sleep(5)
            continue
        try:
            kq = select.kqueue()
            event = select.kevent(
                fd,
                filter=select.KQ_FILTER_VNODE,
                flags=select.KQ_EV_ADD | select.KQ_EV_CLEAR,
                fflags=select.KQ_NOTE_WRITE | select.KQ_NOTE_ATTRIB | select.KQ_NOTE_RENAME | select.KQ_NOTE_DELETE,
            )
            kq.control([event], 0)
            kq.control(None, 1)
        except OSError:
            time.sleep(5)
        finally:
            os.close(fd)


def handy_file_mode() -> bool:
    """Transcribe captured frames with handy --transcribe-file.

    The GUI recorder and history.db are shared with the live controller.
    Toggling them from a test would submit the user's speech. File mode
    never launches or cancels that app.
    """
    return os.environ.get("OMP_VOICE_HANDY", "") == "transcribe-file"


def transcribe_handy_file(frames: list[np.ndarray]) -> str:
    """Run Handy's batch ASR on frames the controller already captured. No microphone."""
    if not frames:
        return ""
    audio = np.concatenate(frames).astype(np.int16, copy=False)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    path = STATE_DIR / f"handy-capture-{time.time_ns()}.wav"
    import wave

    with wave.open(str(path), "wb") as handle:
        handle.setnchannels(1)
        handle.setsampwidth(2)
        handle.setframerate(16000)
        handle.writeframes(audio.tobytes())
    try:
        proc = subprocess.run(
            [HANDY_BIN, "--transcribe-file", str(path), "--json"],
            capture_output=True,
            text=True,
            timeout=120,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        log(f"handy --transcribe-file failed: {exc}")
        return ""
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError:
        log(f"handy --transcribe-file returned no JSON (exit {proc.returncode})")
        return ""
    text = str(data.get("text") or "").strip()
    log(f"Handy file transcript: {text!r} model={data.get('model')}")
    return text


def bridge_only_base() -> str | None:
    """When set, delivery and barge-in stay on this one bridge."""
    raw = os.environ.get("OMP_VOICE_BRIDGE_ONLY", "").strip()
    if not raw:
        return None
    if raw.startswith("http://") or raw.startswith("https://"):
        return raw.rstrip("/")
    return f"http://127.0.0.1:{int(raw)}"


def playback_owner_pid() -> str:
    return os.environ.get("OMP_VOICE_PLAYBACK_PID", "").strip()


def playback_slot_dir() -> Path:
    override = os.environ.get("OMP_VOICE_PLAYBACK_DIR", "").strip()
    if override:
        return Path(override)
    return STATE_DIR / "tts-playing"


def handy_model_id() -> str:
    try:
        raw = json.loads(HANDY_SETTINGS.read_text(encoding="utf-8"))
        return str(raw.get("settings", {}).get("selected_model", ""))
    except (OSError, ValueError):
        return ""


def apply_voicebox_model(strata_running: bool) -> bool:
    """0.6B while Strata is resident. 1.7B on the GPU when it is not."""
    size = "0.6B" if strata_running else "1.7B"
    drop = "qwen-tts-1.7B" if strata_running else "qwen-tts-0.6B"
    marker = STATE_DIR / "tts-model"
    loaded = ""
    try:
        with urllib.request.urlopen("http://127.0.0.1:17493/health", timeout=2) as res:
            loaded = str(json.loads(res.read().decode()).get("model_size") or "")
    except (OSError, ValueError, json.JSONDecodeError):
        log_once("voicebox-health", "VoiceBox health unread; speech tier not changed")
        return False
    if loaded == size:
        marker.write_text(size + "\n", encoding="utf-8")
        return True
    try:
        urllib.request.urlopen(
            urllib.request.Request(f"http://127.0.0.1:17493/models/{drop}/unload", method="POST"),
            timeout=60,
        )
        urllib.request.urlopen(
            urllib.request.Request(
                f"http://127.0.0.1:17493/models/load?model_size={size}",
                method="POST",
            ),
            timeout=180,
        )
    except (OSError, urllib.error.URLError) as exc:
        log(f"VoiceBox model switch to {size} failed: {exc}")
        return False
    marker.write_text(size + "\n", encoding="utf-8")
    log(f"VoiceBox model -> {size} ({'Strata loaded' if strata_running else 'Strata stopped'})")
    return True


def apply_handy_model(strata_running: bool) -> None:
    """1.7B by default. 0.6B only while Strata is resident."""
    global _handy_on_light
    want = HANDY_MODEL_LIGHT if strata_running else HANDY_MODEL_QUALITY
    if handy_model_id() == want:
        _handy_on_light = strata_running
        return
    try:
        raw = json.loads(HANDY_SETTINGS.read_text(encoding="utf-8"))
        raw.setdefault("settings", {})["selected_model"] = want
        HANDY_SETTINGS.write_text(json.dumps(raw, indent=2), encoding="utf-8")
    except (OSError, ValueError) as exc:
        log(f"Could not set Handy model: {exc}")
        return
    _handy_on_light = strata_running
    log(f"Handy model -> {want} ({'Strata loaded' if strata_running else 'Strata stopped'})")
    subprocess.run(["/usr/bin/pkill", "-f", "Handy.app/Contents/MacOS/handy"], check=False)
    time.sleep(0.4)
    subprocess.Popen(
        [HANDY_BIN, "--start-hidden"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def _run_osascript(script: str) -> None:
    subprocess.run(
        ["/usr/bin/osascript", "-e", script],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def fallback_macos_inject(text: str, action: str) -> None:
    """Fallback if OMP bridge (:17494) is unreachable (e.g. OMP not yet restarted).

    The paste injection overwrites the pasteboard, so the user's original
    clipboard bytes are saved first and restored afterwards.
    """
    saved: bytes | None = None
    try:
        saved = subprocess.run(
            ["/usr/bin/pbpaste"], capture_output=True, check=False, timeout=2.0
        ).stdout
    except Exception as exc:
        log_once("pbpaste", f"clipboard save failed, paste will overwrite it: {exc}")

    if action in ("appended", "paused") and text:
        subprocess.run(["/usr/bin/pbcopy"], input=text.encode("utf-8"), check=False)
        _run_osascript('tell application "System Events" to keystroke "v" using command down')
    elif action == "sent":
        if text:
            subprocess.run(["/usr/bin/pbcopy"], input=text.encode("utf-8"), check=False)
            _run_osascript('tell application "System Events" to keystroke "v" using command down')
            time.sleep(PASTE_KEY_SETTLE_SECONDS)
        _run_osascript('tell application "System Events" to key code 36')

    if saved is not None:
        # Restore what was on the clipboard before the injection, not the injected text.
        subprocess.run(["/usr/bin/pbcopy"], input=saved, check=False)


_GRAMMAR: dict | None = None


def load_command_grammar(path: Path) -> dict:
    grammar = json.loads(path.read_text(encoding="utf-8"))
    grammar["wake"].sort(key=len, reverse=True)
    return grammar


def command_grammar() -> dict:
    """Phrase of N words: one word from each of N lists, in order. Wake is optional in front.

    The install copies grammar.json into ~/.local. A checkout that has not been
    installed, including CI, uses the copy next to this script.
    """
    global _GRAMMAR
    if _GRAMMAR is None:
        installed = Path.home() / ".local" / "share" / "omp-voice" / "grammar.json"
        shipped = Path(__file__).resolve().parent.parent / "grammar.json"
        path = installed if installed.is_file() else shipped
        _GRAMMAR = load_command_grammar(path)
    return _GRAMMAR


def is_wake_phrase(phrase: str, grammar: dict | None = None) -> bool:
    """True when the phrase is exactly one grammar wake, ignoring trailing punctuation.

    The old check was a full match of hey/ok/hello Jarvis or Jarvis, then
    spaces and . , ! ?. Words that are not in grammar["wake"] are not wakes.
    """
    grammar = grammar or command_grammar()
    body = re.sub(r"[\s.,!?]*$", "", phrase)
    if not body:
        return False
    lowered = body.lower()
    for wake in grammar["wake"]:
        if len(wake) == 1:
            if lowered == wake[0]:
                return True
            continue
        pattern = r"[\s,]+".join(re.escape(word) for word in wake)
        if re.fullmatch(pattern, lowered):
            return True
    return False


def clip_for_whisper(audio_f32: np.ndarray, gain_cap: float) -> np.ndarray:
    """Scale a float clip toward 0.5 peak, never above gain_cap, then clip to [-1, 1]."""
    peak = float(np.max(np.abs(audio_f32)))
    if peak > 0.01:
        return np.clip(audio_f32 * min(gain_cap, 0.5 / peak), -1.0, 1.0)
    return audio_f32


def _command_tokens(text: str) -> list[str]:
    return [token for token in re.sub(r"[\s.,!?;:]+", " ", text.lower()).strip().split(" ") if token]


def _is_playback_barge(tokens: list[str]) -> bool:
    """A short barge over our own TTS. Not a sentence that merely ends in stop."""
    if tokens and all(token == "stop" for token in tokens):
        return True
    if len(tokens) < 2 or tokens[0] != "hold" or tokens[1] != "on":
        return False
    return tokens[2:] in ([], ["a", "second"], ["a", "sec"], ["one", "second"], ["one", "sec"])


def _slots_match(words: list[str], slots: list[list[str]]) -> bool:
    return len(words) == len(slots) and all(word in choices for word, choices in zip(words, slots))


def match_command(raw: str, grammar: dict | None = None) -> dict | None:
    """Longest suffix that is an optional wake plus one word from each slot."""
    grammar = grammar or command_grammar()
    tokens = _command_tokens(raw)
    best: dict | None = None
    for start in range(len(tokens)):
        span = tokens[start:]
        for wake in [[], *grammar["wake"]]:
            if wake and span[: len(wake)] != wake:
                continue
            rest = span[len(wake) :]
            for group in grammar["actions"]:
                if not _slots_match(rest, group["slots"]):
                    continue
                if best is None or len(span) > best["span"]:
                    best = {
                        "span": len(span),
                        "action": group["action"],
                        "stem": [rest[0]],
                        "prefix": " ".join(tokens[:start]),
                        "phrase": " ".join(span),
                    }
    if best is None:
        return None
    best.pop("span")
    return best


def shield_live_command_word(shown: str) -> str:
    """Keep a one-word command visible in the live field.

    The bridge drops a final token of "pause" or "stop" and runs that command.
    It also strips .,!?;: before that match, so "pause." is the same command.
    A word joiner on the command word is not displayed and does not match the slot.
    """
    tokens = shown.split()
    if not tokens:
        return shown
    last = tokens[-1]
    core = re.sub(r"[.,!?;:]+$", "", last)
    if not core:
        return shown
    trail = last[len(core) :]
    matched = match_command(core)
    if not matched or matched["prefix"] or len(matched["phrase"].split()) != 1:
        return shown
    if matched["phrase"] != core.lower():
        return shown
    tokens[-1] = core + "\u2060" + trail
    return " ".join(tokens)


def canonicalize_transcript(text: str) -> str:
    """Map a send-family suffix onto the phrase an older bridge already submits."""
    matched = match_command(text)
    if not matched or matched["action"] != "sent":
        return text
    prefix = matched["prefix"]
    return f"{prefix} send prompt".strip() if prefix else "send prompt"


def _omp_vb_pids() -> list[str]:
    try:
        listing = subprocess.check_output(["ps", "-axo", "pid=,command="], text=True)
    except Exception as exc:
        log_once("kill-tts", f"kill_tts_clips probe failed: {exc}")
        return []
    owner = playback_owner_pid()
    needle = f"omp-vb-{owner}-" if owner else "omp-vb-"
    return [
        line.split(None, 1)[0]
        for line in listing.splitlines()
        if "afplay" in line and needle in line
    ]


def paused_playback_seconds(now: float) -> float:
    """Wall time afplay has been stopped, including a pause that is still open."""
    extra = 0.0
    if _render_paused_at is not None:
        extra = max(0.0, now - _render_paused_at)
    return _render_paused_seconds + extra


def note_render_paused(now: float) -> None:
    global _render_paused_at
    if _render_paused_at is None:
        _render_paused_at = now


def note_render_resumed(now: float) -> None:
    global _render_paused_at, _render_paused_seconds
    if _render_paused_at is None:
        return
    _render_paused_seconds += max(0.0, now - _render_paused_at)
    _render_paused_at = None


def pause_tts_clips() -> None:
    """Hold our clips so the mic hears the person instead of the speakers."""
    pids = list(_omp_vb_pids())
    if not pids:
        return
    for pid in pids:
        subprocess.run(["kill", "-STOP", pid], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    note_render_paused(time.time())


def resume_tts_clips() -> None:
    for pid in _omp_vb_pids():
        subprocess.run(["kill", "-CONT", pid], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    note_render_resumed(time.time())


def kill_tts_clips() -> None:
    """Stop VoiceBox speech clips only. Leave the wake chime, which is a different file."""
    for pid in _omp_vb_pids():
        subprocess.run(["kill", "-9", pid], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def bridge_session_file() -> Path | None:
    """Session file of the OMP process that owns the voice bridge."""
    try:
        listeners = subprocess.check_output(["lsof", "-nP", "-iTCP:17494", "-sTCP:LISTEN"], text=True)
    except (OSError, subprocess.CalledProcessError):
        return None
    pid = ""
    for line in listeners.splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 2 and parts[1].isdigit():
            pid = parts[1]
            break
    if not pid:
        return None
    try:
        opened = subprocess.check_output(["lsof", "-nP", "-p", pid], text=True)
    except (OSError, subprocess.CalledProcessError):
        return None
    for line in opened.splitlines():
        if "/sessions/" in line and line.endswith(".jsonl"):
            return Path(line.split()[-1])
    return None


def watch_submitted_messages() -> None:
    """A typed or spoken send is the new turn. Stop leftover playback only.

    Do not abort the agent. The session file records the user message, the
    turn leaves idle, and this poll would then cancel that same turn
    ("Interrupted by user", 0 tokens). Wake and the fn barge-in still abort.
    """
    path: Path | None = None
    offset = 0
    while _daemon_running.is_set():
        current = bridge_session_file()
        if current != path:
            path = current
            offset = path.stat().st_size if path and path.exists() else 0
        if path and path.exists():
            size = path.stat().st_size
            if size < offset:
                offset = size
            elif size > offset:
                with path.open(encoding="utf-8", errors="replace") as handle:
                    handle.seek(offset)
                    fresh = handle.read()
                    offset = handle.tell()
                for line in fresh.splitlines():
                    try:
                        event = json.loads(line)
                    except ValueError:
                        continue
                    message = event.get("message") if isinstance(event, dict) else None
                    if (
                        isinstance(event, dict)
                        and event.get("type") == "message"
                        and isinstance(message, dict)
                        and message.get("role") == "user"
                    ):
                        log("Submitted message -> stopping leftover playback")
                        silence_speech(False)
        time.sleep(WATCH_POLL_SECONDS)


def fn_held() -> bool:
    """True while the Globe/fn key is down. Handy uses that key as push-to-talk."""
    try:
        _, graphics = _load_macos_frameworks()
        flags = graphics.CGEventSourceFlagsState(1)
    except Exception as exc:
        log_once("fn-probe", f"fn_held probe failed: {exc}")
        return False
    return bool(int(flags) & 0x00800000)


def silence_speech(abort_agent: bool) -> None:
    # Kill the speakers before the bridge round-trip. Otherwise Handy records the reply.
    # Abort only the session that would receive the dictation. Other sessions lose
    # their audio but keep a turn that the user is not talking to.
    kill_tts_clips()
    try:
        target = resolve_delivery()
    except Exception as exc:
        log_once("silence-target", f"resolve_delivery failed in silence_speech: {exc}")
        target = {"mode": "bridge", "port": 17494}
    target_base = bridge_base(target) if target.get("mode") == "bridge" else None
    for base in live_bridge_bases():
        bridge_request(
            "/barge-in",
            method="POST",
            body={"abortAgent": bool(abort_agent) and base == target_base},
            base=base,
        )

    def keep_killing() -> None:
        for _ in range(KILL_RETRY_COUNT):
            time.sleep(KILL_RETRY_SECONDS)
            kill_tts_clips()

    threading.Thread(target=keep_killing, daemon=True).start()


def focused_paste_plan(original: str) -> dict:
    """A trailing send phrase presses Enter. Any words before it are typed first.

    The command matcher lowercases its prefix. Keep the spoken capitalization
    by cutting that many words off the original line instead.
    """
    matched = match_command(original)
    if matched and matched["action"] == "sent":
        phrase_words = matched["phrase"].split()
        spoken = original.split()
        head = spoken[: len(spoken) - len(phrase_words)] if phrase_words else spoken
        typed = " ".join(head).strip(" .,!?;:")
        return {"action": "sent", "text": typed, "phrase": matched["phrase"]}
    if matched and matched["action"] in {"cancelled", "cleared", "scratched", "paused"}:
        # The terminal composer is a text box, so the paste path used to type
        # "clear draft" into the prompt. These phrases act on the draft.
        return {"action": matched["action"], "text": "", "phrase": matched["phrase"]}
    return {"action": "appended", "text": original.strip(), "phrase": ""}


def with_preserved_draft(spoken: str, preserved: str) -> str:
    """A pause keeps its line in the editor. The later send must include that line."""
    spoken = " ".join(spoken.split()).strip()
    preserved = " ".join(preserved.split()).strip()
    if not preserved:
        return spoken
    if spoken.lower() == preserved.lower() or spoken.lower().startswith(preserved.lower() + " "):
        return spoken
    return f"{preserved} {spoken}".strip()


# Words spoken before "stop". The bridge editor drops them when that pause
# happens off a text box, and the next send then submits only the new line.
PRESERVED_PAUSE = ""


def note_pause(original: str) -> None:
    global PRESERVED_PAUSE
    matched = match_command(original)
    if not matched or matched["action"] != "paused":
        return
    prefix = " ".join(matched["prefix"].split()).strip()
    if not prefix:
        return
    PRESERVED_PAUSE = with_preserved_draft(prefix, PRESERVED_PAUSE)
    log(f"Preserved pause prefix: {PRESERVED_PAUSE!r}")


def bridge_draft(base: str | None) -> str:
    if not base:
        return ""
    status = bridge_request("/status", method="GET", base=base)
    if not status or not status.get("ok"):
        return ""
    return str(status.get("draft") or "")


def draft_ends_with_prefix(draft: str, prefix: str) -> bool:
    norm = " ".join(draft.lower().split())
    kept = " ".join(prefix.lower().split())
    if not kept:
        return False
    return norm == kept or norm.endswith(" " + kept)


def session_bridge_base(dest: dict) -> str | None:
    """Paste delivery has no port. The pause still lives on the session bridge, not :17494."""
    port = dest.get("port")
    if isinstance(port, int) and port > 0:
        return f"http://127.0.0.1:{port}"
    for base in live_bridge_bases():
        if not base.rstrip("/").endswith(":17494"):
            return base
    return None


def consume_preserved_for_send(original: str, *, editor_has_it: bool) -> str:
    global PRESERVED_PAUSE
    kept = " ".join(PRESERVED_PAUSE.split()).strip()
    if not kept:
        return original
    PRESERVED_PAUSE = ""
    if editor_has_it:
        log(f"Pause prefix already at end of bridge draft: {kept!r}")
        return original
    combined = with_preserved_draft(original, kept)
    log(f"Send includes preserved pause: {combined!r}")
    return combined


def paste_into_focus(original: str, preserved: str = "") -> dict:
    plan = focused_paste_plan(original)
    if plan["action"] == "sent":
        text = with_preserved_draft(plan["text"], preserved)
        log(f"Submitted draft: {text!r}")
        fallback_macos_inject(text, "sent")
        return {
            "action": "sent",
            "draft": text,
            "strippedCommand": plan["phrase"],
            "via": "focus",
        }
    if plan["action"] != "appended":
        return {
            "action": plan["action"],
            "draft": "",
            "strippedCommand": plan["phrase"],
            "via": "focus",
        }
    typed = plan["text"] + (" " if plan["text"] else "")
    fallback_macos_inject(typed, "appended")
    return {"action": "appended", "draft": plan["text"], "via": "focus"}


_undelivered_transcript = ""
_pending_send_prefix = ""


_ASIDE_ACTIONS = {"paused", "scratched", "cleared", "cancelled"}


def _command_leaves_hold(text: str) -> bool:
    """Pause, scratch, clear, and cancel must not consume a sentence that is waiting."""
    matched = match_command(text)
    return bool(matched and matched["action"] in _ASIDE_ACTIONS)


def _visible_hold() -> str:
    sentence = _undelivered_transcript
    prefix = _pending_send_prefix
    if not prefix:
        return sentence
    if not sentence or sentence == prefix or sentence.endswith(" " + prefix):
        return sentence or prefix
    return f"{sentence} {prefix}"


def _remember_send_prefix(prefix: str) -> None:
    """Keep words that were in front of a send. A later sentence must not consume them."""
    global _pending_send_prefix
    piece = " ".join(prefix.split())
    if not piece:
        return
    current = _pending_send_prefix
    if not current or piece == current or current.endswith(" " + piece):
        _pending_send_prefix = piece if not current else current
        return
    if piece.endswith(" " + current):
        _pending_send_prefix = piece
        return
    _pending_send_prefix = f"{current} {piece}".strip()


def _with_undelivered(text: str) -> str:
    sentence = _undelivered_transcript
    matched = match_command(text)
    if not (matched and matched["action"] == "sent"):
        if not sentence or text == sentence or text.startswith(sentence + " "):
            return text
        return f"{sentence} {text}".strip()
    prefix = matched["prefix"]
    stored = _pending_send_prefix
    if stored and not prefix:
        prefix = stored
    elif stored and prefix and stored.endswith(" " + prefix):
        prefix = stored
    elif stored and prefix and not (prefix == stored or prefix.endswith(" " + stored)):
        prefix = f"{stored} {prefix}".strip()
    command = f"{prefix} send prompt".strip() if prefix else "send prompt"
    if not sentence:
        return command
    if command == sentence or command.startswith(sentence + " "):
        return command
    if prefix and (sentence == prefix or sentence.endswith(" " + prefix)):
        return f"{sentence} send prompt"
    return f"{sentence} {command}".strip()


def _remember_undelivered(text: str) -> str:
    """Keep a bridge transcript that could not be posted. The same text is stored once."""
    global _undelivered_transcript
    piece = " ".join(text.split())
    if not piece:
        return _undelivered_transcript
    if piece == _undelivered_transcript or _undelivered_transcript.endswith(" " + piece):
        return _undelivered_transcript
    _undelivered_transcript = f"{_undelivered_transcript} {piece}".strip()
    return _undelivered_transcript


def _clear_undelivered() -> None:
    global _undelivered_transcript
    _undelivered_transcript = ""


def _clear_delivery(text: str) -> None:
    """A sent or clear command also drops the prefix. A clear also drops a saved pause line."""
    global _pending_send_prefix, PRESERVED_PAUSE
    _clear_undelivered()
    matched = match_command(text)
    if matched and matched["action"] in {"sent", "cleared"}:
        _pending_send_prefix = ""
    if matched and matched["action"] == "cleared":
        PRESERVED_PAUSE = ""


def _hold_failed_send(prefix: str) -> dict:
    """A send that did not post keeps the words in front of the command. The command itself is not stored."""
    if prefix.strip():
        _remember_send_prefix(prefix)
    log("Send post failed; keeping the held sentence")
    return {"action": "held", "draft": _visible_hold()}


def dispatch_transcript(text: str) -> dict:
    """Paste into the focused text control, or send to the newest omp when focus is not text.

    In a text field, a trailing send phrase ("send it", "send that") is Enter,
    not more typed words. Anywhere else, that phrase still submits the omp draft.
    """
    original = " ".join(text.strip().split())
    if not original:
        return {"action": "noop", "draft": ""}

    try:
        dest = resolve_delivery()
    except Exception as exc:
        log(f"Delivery lookup failed ({exc}); using the legacy bridge")
        dest = {"mode": "bridge", "port": 17494, "focused_text": False}
    log(
        f"Delivery {dest.get('mode')} pid={dest.get('pid')} port={dest.get('port')} "
        f"focused_text={dest.get('focused_text')}"
    )
    matched_now = match_command(original)
    if matched_now and matched_now["action"] == "paused":
        note_pause(original)

    if dest.get("mode") == "paste":
        # The text box only has this chunk. A pause that landed while focus was
        # elsewhere is remembered here. Include that line. Clear the bridge
        # copy only when that copy is the pause line and nothing else.
        base = session_bridge_base(dest)
        if matched_now and matched_now["action"] == "paused" and base:
            resp = bridge_request("/transcript", method="POST", body={"text": original}, base=base)
            if resp and resp.get("ok"):
                log(f"Paused draft: {resp.get('draft')!r}")
                return resp
            return {
                "action": "paused",
                "draft": PRESERVED_PAUSE,
                "strippedCommand": matched_now["phrase"],
            }
        if matched_now and matched_now["action"] == "sent":
            kept = PRESERVED_PAUSE
            original = consume_preserved_for_send(original, editor_has_it=False)
            result = paste_into_focus(original)
            if result.get("action") == "sent" and base and kept.strip():
                draft = bridge_draft(base)
                if " ".join(draft.split()).lower() == " ".join(kept.split()).lower():
                    bridge_request("/transcript", method="POST", body={"text": "clear draft"}, base=base)
            return result
        return paste_into_focus(original)

    if matched_now and matched_now["action"] == "sent" and PRESERVED_PAUSE.strip():
        base_for_draft = bridge_base(dest) if dest.get("port") else session_bridge_base(dest)
        editor_has_it = draft_ends_with_prefix(bridge_draft(base_for_draft), PRESERVED_PAUSE)
        original = consume_preserved_for_send(original, editor_has_it=editor_has_it)
        text = original

    base = bridge_base(dest)
    text = canonicalize_transcript(text)
    cleaned = " ".join(text.strip().split())
    if not cleaned:
        return {"action": "noop", "draft": ""}

    status = bridge_request("/status", method="GET", base=base)
    if status and status.get("ok"):
        if status.get("version", 1) >= 2:
            aside = _command_leaves_hold(text)
            payload = text if aside else _with_undelivered(text)
            resp = bridge_request("/transcript", method="POST", body={"text": payload}, base=base)
            if resp and resp.get("ok"):
                cleared = match_command(text)
                if not aside or (cleared and cleared["action"] == "cleared"):
                    _clear_delivery(text)
                return resp
            sent = match_command(text)
            if not aside and sent and sent["action"] == "sent":
                return _hold_failed_send(sent["prefix"])
            if sent and sent["action"] == "paused":
                log("Pause post failed; keeping the held sentence")
                return {"action": "held", "draft": _visible_hold()}
            if sent and sent["action"] == "scratched":
                log("Scratch post failed; keeping the held sentence")
                return {"action": "held", "draft": _visible_hold()}
            if sent and sent["action"] == "cleared":
                log("Clear post failed; keeping the held sentence")
                return {"action": "held", "draft": _visible_hold()}
            if sent and sent["action"] == "cancelled":
                log("Cancel post failed; keeping the held sentence")
                return {
                    "action": "cancelled",
                    "draft": _visible_hold(),
                    "strippedCommand": sent["phrase"],
                }
        else:
            # v1 bridge compatibility (before the OMP session was restarted):
            # Handy's Cmd+V already pasted `text` into the focused OMP editor if `draft` ends with `text`.
            current_draft = str(status.get("draft", ""))
            already_pasted = current_draft.rstrip().endswith(text.strip()) or current_draft.rstrip().endswith(cleaned)
            matched = match_command(cleaned)
            if already_pasted and not matched:
                return {"action": "appended", "draft": current_draft}
            if already_pasted and matched:
                n_del = len(text)
                subprocess.run(
                    [
                        "/usr/bin/osascript",
                        "-e",
                        f'tell application "System Events" to repeat {n_del} times\nkey code 51\nend repeat',
                    ],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
                time.sleep(0.08)
            if matched and matched["action"] == "paused":
                mapped = f"{matched['prefix']} pause listening".strip()
                resp = bridge_request("/transcript", method="POST", body={"text": mapped}, base=base)
                if resp and resp.get("ok"):
                    return resp
                log("Pause post failed; keeping the held sentence")
                return {"action": "held", "draft": _visible_hold()}
            if matched and matched["action"] == "sent":
                mapped = _with_undelivered(f"{matched['prefix']} send prompt".strip())
                resp = bridge_request("/transcript", method="POST", body={"text": mapped}, base=base)
                if resp and resp.get("ok"):
                    _clear_delivery(text)
                    return resp
                return _hold_failed_send(matched["prefix"])
            aside = _command_leaves_hold(text)
            payload = text if aside else _with_undelivered(text)
            resp = bridge_request("/transcript", method="POST", body={"text": payload}, base=base)
            if resp and resp.get("ok"):
                if not aside or (matched and matched["action"] == "cleared"):
                    _clear_delivery(text)
                return resp
            if aside and matched and matched["action"] == "cancelled":
                log("Cancel post failed; keeping the held sentence")
                return {
                    "action": "cancelled",
                    "draft": _visible_hold(),
                    "strippedCommand": matched["phrase"],
                }
            if aside and matched and matched["action"] in {"scratched", "cleared"}:
                log("Command post failed; keeping the held sentence")
                return {"action": "held", "draft": _visible_hold()}

    if dest.get("mode") == "bridge" and not dest.get("focused_text") and match_command(cleaned) is None:
        held = _remember_undelivered(cleaned)
        log(f"Bridge status failed; holding {len(held)} chars")
        return {"action": "held", "draft": held}

    if dest.get("focused_text"):
        return paste_into_focus(original)

    matched = match_command(cleaned)
    if matched and matched["action"] == "cancelled":
        return {"action": "cancelled", "strippedCommand": matched["phrase"]}
    if matched and matched["action"] == "paused":
        fallback_macos_inject(matched["prefix"] + (" " if matched["prefix"] else ""), "paused")
        return {"action": "paused", "strippedCommand": matched["phrase"]}
    if matched and matched["action"] == "sent":
        if _pending_send_prefix:
            if matched["prefix"]:
                _remember_send_prefix(matched["prefix"])
            log("Send status failed; keeping the held prefix")
            return {"action": "held", "draft": _visible_hold()}
        fallback_macos_inject(matched["prefix"], "sent")
        return {"action": "sent", "strippedCommand": matched["phrase"]}

    fallback_macos_inject(cleaned + " ", "appended")
    return {"action": "appended", "draft": cleaned}


def configure_handy_settings() -> None:
    """Ensure Handy keeps its ASR model warm and uses standard ctrl_v paste."""
    if not HANDY_SETTINGS.exists():
        return
    try:
        raw = json.loads(HANDY_SETTINGS.read_text(encoding="utf-8"))
        settings = raw.get("settings", {})
        changed = False
        if settings.get("mute_while_recording") is True:
            settings["mute_while_recording"] = False
            changed = True
        if settings.get("model_unload_timeout") == "min2":
            settings["model_unload_timeout"] = "hour1"
            changed = True
        if settings.get("selected_language") != "en":
            settings["selected_language"] = "en"
            changed = True
        if settings.get("paste_method") != "none":
            settings["paste_method"] = "none"
            settings["external_script_path"] = None
            changed = True
        if settings.get("shortcut_activation") != "push_to_talk":
            # hold_or_toggle treats a tap of fn as "start and keep waiting".
            # Release must end the take.
            settings["shortcut_activation"] = "push_to_talk"
            changed = True
        if changed:
            HANDY_SETTINGS.write_text(json.dumps(raw, indent=2), encoding="utf-8")
            log("Updated Handy settings (mute_while_recording=False, model_unload_timeout=hour1, paste_method=none)")
    except Exception as exc:
        log(f"Warning: could not update Handy settings: {exc}")


def tts_wake_threshold() -> float:
    """Same wake score during playback on the laptop mic and on headphones.

    The laptop used to require 0.50 because it hears the speakers. A real
    Hey Jarvis then fell through, and the whisper check transcribed the
    speaker audio instead of opening Handy. There is no headphones-specific
    value, so the dead parameter is gone.
    """
    return TTS_WAKE_SCORE_THRESHOLD


def idle_command(heard: str) -> dict | None:
    """A command said alone, with no words before it."""
    matched = match_command(heard)
    if matched and not matched["prefix"]:
        return matched
    return None


def _open_pid_lock(block: bool) -> object | None:
    """Advisory flock on the PID file so two `start` calls cannot both spawn.

    The daemon holds this lock for its entire life (cmd_start_bg passes the
    already-locked fd to the child via pass_fds); a start probe takes it only
    briefly to prove no daemon is holding it.
    """
    handle = open(PID_FILE, "a+", encoding="utf-8")
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | (0 if block else fcntl.LOCK_NB))
    except OSError:
        handle.close()
        return None
    return handle


def barge_note(mic: "MicState", stage: str, **fields) -> None:
    """One stage change. Frame rows are written only while a hold is open and tracing is on."""
    if os.environ.get("OMP_VOICE_BARGE_TRACE", "") != "1":
        return
    event = {"t": round(time.time(), 3), "stage": stage}
    for key, value in fields.items():
        if isinstance(value, float):
            event[key] = round(value, 3)
        else:
            event[key] = value
    mic.barge_trace.append(event)
    if len(mic.barge_trace) > 80:
        del mic.barge_trace[:-80]
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        with (STATE_DIR / "barge-trace.jsonl").open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(event) + "\n")
    except OSError:
        return


def stop_playback(reason: str) -> None:
    # Kill the clip and the turn. Stopping only afplay leaves the agent
    # streaming, and the next sentence starts the loop again.
    log(reason)
    silence_speech(True)


@dataclass
class MicState:
    """Loop locals the idle and dictation handlers assign. Models stay outside."""

    state: str = "IDLE"
    last_history_id: int = 0
    speech_seen_in_chunk: bool = False
    chunk_started_at: float = 0.0
    last_handy_ui_check: float = 0.0
    handy_ui_gone: bool = False
    handy_ui_seen: bool = False
    last_speech_at: float = 0.0
    cooldown_until: float = 0.0
    score_wake_blocked_until: float = 0.0
    last_tts_check: float = 0.0
    last_tts_mute: float = 0.0
    last_manual_check: float = 0.0
    barge_mute: bool = False
    tts_active: bool = False
    fn_was_down: bool = False
    fn_ignore_through: int = 0
    fn_cut_busy: bool = False
    tts_loud_run: int = 0
    tts_stop_silence: int = 0
    idle_in_speech: bool = False
    idle_silence_frames: int = 0
    checked_fast_cmd: bool = False
    pending_fast_flush: bool = False
    partial_sent_frames: int = 0
    partial_shown: str = ""
    partial_base: str = ""
    on_headphones: bool = False
    whisper_pending: dict | None = None
    idle_verify_next: tuple | None = None
    # Rolling speaker-bleed floor while VoiceBox plays (~2.0s). A person talking over the
    # laptop speakers sits well above that floor; a wake-word hit on the TTS audio does not.
    tts_rms_floor: deque[float] = field(default_factory=lambda: deque(maxlen=25))
    tts_stop_frames: list[np.ndarray] = field(default_factory=list)
    tts_barge_held: bool = False
    tts_barge_voice: bool = False
    tts_barge_quiet: int = 0
    tts_barge_skip: int = 0
    tts_barge_loud: int = 0
    tts_barge_next: tuple | None = None
    tts_barge_cool_until: float = 0.0
    tts_floor_holdoff: int = 0
    tts_pre_roll: deque[np.ndarray] = field(default_factory=lambda: deque(maxlen=8))
    tts_barge_waiting: bool = False
    barge_trace: list = field(default_factory=list)
    barge_onset_wall: float = 0.0
    idle_pre_roll: deque[np.ndarray] = field(default_factory=lambda: deque(maxlen=6))  # 480ms pre-roll
    idle_speech_frames: list[np.ndarray] = field(default_factory=list)
    dict_tail_frames: deque[np.ndarray] = field(default_factory=lambda: deque(maxlen=38))
    dict_speech_frames: list[np.ndarray] = field(default_factory=list)

    def kick_whisper(self, jobs: queue.Queue, kind: str, audio_f32: np.ndarray, prompt: str) -> bool:
        """Queue one clip. Return False if a clip is already in flight (do not block the mic loop)."""
        if self.whisper_pending is not None:
            if kind == "tts_barge":
                self.tts_barge_next = (audio_f32, prompt)
                return True
            return False
        slot: queue.Queue = queue.Queue(maxsize=1)
        try:
            jobs.put_nowait({"audio": audio_f32, "prompt": prompt, "slot": slot})
        except queue.Full:
            if kind == "tts_barge":
                self.tts_barge_next = (audio_f32, prompt)
            return False
        self.whisper_pending = {"kind": kind, "slot": slot}
        return True

    def release_barge_clip(self, jobs: queue.Queue) -> bool:
        """Queue a held interruption once Whisper is free. A full queue keeps it."""
        if self.tts_barge_next is None or self.whisper_pending is not None:
            return False
        audio, prompt = self.tts_barge_next
        self.tts_barge_next = None
        if self.kick_whisper(jobs, "tts_barge", audio, prompt):
            return True
        if self.tts_barge_next is None:
            self.tts_barge_next = (audio, prompt)
        return False

    def hold_idle_utterance(self, audio: np.ndarray, prompt: str) -> str:
        """Keep one idle clip while Whisper is busy. A newer clip replaces the older one."""
        replaced = self.idle_verify_next is not None
        self.idle_verify_next = (audio, prompt)
        return "replaced" if replaced else "held"

    def release_idle_utterance(self, jobs: queue.Queue) -> bool:
        """Queue the held idle clip once the in-flight job is gone. Dictation drops it."""
        if self.state != "IDLE":
            self.idle_verify_next = None
            return False
        if self.idle_verify_next is None or self.whisper_pending is not None:
            return False
        audio, prompt = self.idle_verify_next
        self.idle_verify_next = None
        if self.kick_whisper(jobs, "idle_verify", audio, prompt):
            return True
        self.idle_verify_next = (audio, prompt)
        return False

    def show_closing_partial(self, jobs: queue.Queue) -> None:
        """Write the latest words before the flush line.

        Live partials are kicked only while speech frames are still arriving.
        The last word often lands in the silence that starts the flush, so
        the field would otherwise keep the older prefix.
        """
        spoken = len(self.dict_speech_frames)
        if spoken < 6 or spoken - self.partial_sent_frames < 4:
            return
        window = self.dict_speech_frames[-75:]
        try:
            audio_i16 = np.concatenate(window)
            if float(np.max(np.abs(audio_i16))) < 350.0:
                return
            audio_f32 = clip_for_whisper(audio_i16.astype(np.float32) / 32768.0, 5.0)
            slot: queue.Queue = queue.Queue(maxsize=1)
            jobs.put({"audio": audio_f32, "prompt": "A person dictating a sentence.", "slot": slot}, timeout=8)
            heard = str(slot.get(timeout=8))
        except Exception:
            return
        if not heard.strip():
            return
        log(f"Partial transcript: {heard.strip()!r}")
        self.show_partial(heard)
        self.partial_sent_frames = spoken

    def maybe_emit_partial(self, jobs: queue.Queue) -> None:
        """Transcribe the open chunk while speech continues. Do not flush Handy."""
        spoken = len(self.dict_speech_frames)
        if spoken < 18 or spoken - self.partial_sent_frames < 18:
            return
        if self.whisper_pending is not None:
            return
        window = self.dict_speech_frames[-75:]
        audio_i16 = np.concatenate(window)
        if float(np.max(np.abs(audio_i16))) < 350.0:
            return
        audio_f32 = clip_for_whisper(audio_i16.astype(np.float32) / 32768.0, 5.0)
        if self.kick_whisper(jobs, "partial", audio_f32, "A person dictating a sentence."):
            self.partial_sent_frames = spoken

    def take_whisper(self) -> tuple[str, str] | None:
        if self.whisper_pending is None:
            return None
        try:
            text = self.whisper_pending["slot"].get_nowait()
        except queue.Empty:
            return None
        kind = str(self.whisper_pending["kind"])
        self.whisper_pending = None
        return kind, text

    def transcribe_local_fallback(self, jobs: queue.Queue, frames_list: list[np.ndarray]) -> str:
        """If Handy failed to persist a row (e.g. Escape/fn interference), transcribe our buffered PCM directly."""
        if len(frames_list) < 6:
            return ""
        try:
            audio_i16 = np.concatenate(frames_list)
            if float(np.max(np.abs(audio_i16))) < 350.0:
                return ""
            audio_f32 = clip_for_whisper(audio_i16.astype(np.float32) / 32768.0, 5.0)
            # The worker owns the model. Wait here only; the mic loop never blocks on whisper.
            slot: queue.Queue = queue.Queue(maxsize=1)
            jobs.put({"audio": audio_f32, "prompt": "send prompt, prompt this, send that, submit prompt, scratch that, undo that, clear draft, pause listening.", "slot": slot})
            return str(slot.get(timeout=30))
        except Exception:
            return ""

    def enter_dictating(self, reason: str, oww, vad) -> None:
        log(f"Wake triggered ({reason}) -> entering DICTATING")
        oww.reset()
        vad.reset_states()
        self.idle_speech_frames.clear()
        self.dict_tail_frames.clear()
        self.dict_speech_frames.clear()
        self.partial_sent_frames = 0
        self.checked_fast_cmd = False
        self.pending_fast_flush = False
        self.idle_in_speech = False
        self.idle_silence_frames = 0
        self.idle_verify_next = None
        # 1. Trigger Barge-in on VoiceBox if it's speaking (and abort any in-flight OMP generation/tool run)
        self.barge_mute = True
        silence_speech(True)
        # 2. Play Wake chime AND start Handy concurrently so any speech right after "Hey Jarvis" is never missed!
        play_cue(SOUND_WAKE, wait=False)
        self.last_history_id, _ = latest_history_row()
        # 3. Start Handy recording off the mic thread. This is the only path
        # allowed to launch the app. fresh=True skips cancel so the words
        # after the wake are not dropped while Handy is contacted.
        if handy_file_mode():
            log("Wake handler: capturing PCM for handy --transcribe-file, not toggling Handy")
        else:
            threading.Thread(
                target=lambda: handy_start_recording(allow_launch=True, fresh=True),
                daemon=True,
            ).start()
        self.forget_handy_window()
        self.state = "DICTATING"
        self.partial_shown = ""
        self.partial_base = ""
        self.speech_seen_in_chunk = False
        self.chunk_started_at = time.monotonic()
        self.last_speech_at = self.chunk_started_at
        self.score_wake_blocked_until = 0.0
        self.cooldown_until = self.chunk_started_at + ENTER_DICTATION_COOLDOWN_SECONDS
        write_status(self.state, {"chunk_started_at": time.time(), "trigger": reason})

    def note_barge_release(self) -> None:
        """A hold that was not a stop. Do not treat the resume attack as a new voice."""
        self.tts_loud_run = 0
        self.tts_floor_holdoff = 6
        self.tts_barge_cool_until = time.monotonic() + 1.50

    def forget_handy_window(self) -> None:
        """Our own stop/start hides the overlay. That hide is not the user closing it."""
        self.handy_ui_gone = False
        self.handy_ui_seen = False
        self.last_handy_ui_check = time.monotonic()

    def finish_fn_take(self, oww, vad) -> None:
        """Fn went down and back up. Handy push-to-talk already stops on release.

        Do not toggle first: a toggle after release starts a new recording and
        leaves the window waiting. Only toggle when the window is still open
        because a voice-started take is still running, and cancel if that
        toggle opened another one.
        """
        prev = self.last_history_id
        row = wait_for_new_history_row(prev, timeout_sec=2.2)
        if row is None and handy_window_open():
            handy_stop_recording()
            row = wait_for_new_history_row(prev, timeout_sec=2.2)
            if row is None and handy_window_open():
                handy_cancel(allow_launch=False)
        if row is not None:
            self.last_history_id, transcript = row
            log(f"fn release transcribed #{self.last_history_id}: {transcript!r}")
            time.sleep(0.26)
            outcome = dispatch_transcript(transcript)
            log(f"fn release outcome: {outcome.get('action', 'appended')}")
        else:
            log("fn release ended the take with no transcript")
        self.transition_to_idle("fn_released", SOUND_PAUSE, oww, vad)

    def transition_to_idle(self, action: str, sound: str, oww, vad, *, cooldown: float = WAKE_COOLDOWN_SECONDS) -> None:
        play_cue(sound, wait=False)
        self.state = "IDLE"
        oww.reset()
        vad.reset_states()
        self.dict_tail_frames.clear()
        self.dict_speech_frames.clear()
        self.partial_sent_frames = 0
        self.partial_shown = ""
        self.partial_base = ""
        self.speech_seen_in_chunk = False
        self.cooldown_until = time.monotonic() + cooldown
        write_status(self.state, {"last_action": action})

    def _partial_bridge(self) -> str | None:
        try:
            dest = resolve_delivery()
        except Exception as exc:
            log(f"Partial field lookup failed ({exc})")
            return None
        if dest.get("mode") != "bridge" or not dest.get("focused_text"):
            log(f"Partial field skipped ({dest.get('mode')}, focused={dest.get('focused_text')})")
            return None
        return bridge_base(dest)

    def show_partial(self, heard: str) -> None:
        """Replace the live partial in the focused editor. One copy, not a growing stack."""
        shown = " ".join(heard.strip().split())
        matched = match_command(shown)
        # A one-word command is also an ordinary last word ("pause").
        # Leave it in the live field. A longer command ("send that") is still stripped.
        if matched and len(matched["phrase"].split()) > 1:
            shown = " ".join(matched["prefix"].split()).strip()
        shown = shield_live_command_word(shown)
        if not shown or shown == self.partial_shown:
            return
        base = self.partial_base or self._partial_bridge()
        if not base:
            return
        if self.partial_shown:
            undone = bridge_request("/transcript", method="POST", body={"text": "scratch that"}, base=base)
            if not undone or undone.get("action") != "scratched":
                log(f"Partial field scratch failed: {undone}")
                return
            self.partial_shown = ""
        resp = bridge_request("/transcript", method="POST", body={"text": shown}, base=base)
        if resp and resp.get("action") == "appended":
            self.partial_shown = shown
            self.partial_base = base
            log(f"Partial written to focused field: {shown!r}")
        else:
            log(f"Partial field write failed: {resp}")

    def retract_partial(self) -> None:
        """Drop the live partial so the final Handy transcript is the only draft.

        Handy steals focus while it flushes, so this uses the bridge that
        wrote the partial instead of looking up focus again.
        """
        if not self.partial_shown or not self.partial_base:
            return
        undone = bridge_request(
            "/transcript", method="POST", body={"text": "scratch that"}, base=self.partial_base
        )
        if undone and undone.get("action") == "scratched":
            log(f"Partial removed before final send: {self.partial_shown!r}")
            self.partial_shown = ""
            self.partial_base = ""
        else:
            log(f"Partial retract failed: {undone}")

    def apply_whisper(self, heard_kind: str, heard: str, oww, vad, jobs=None) -> bool:
        """Handle one finished Whisper clip. True means skip the rest of this iteration."""
        if heard_kind == "tts_barge" and self.state == "IDLE":
            # A sentence that ends in "stop" is the bed, not a barge. The
            # burst may be heard once or several times; every token has to
            # be the word stop. "Hold on a second" is the same barge.
            stop_tokens = _command_tokens(heard)
            barge_note(self, "whisper", text=heard, barge=_is_playback_barge(stop_tokens))
            if _is_playback_barge(stop_tokens):
                self.tts_barge_held = False
                self.tts_barge_waiting = False
                self.tts_barge_next = None
                latency = round(time.time() - self.barge_onset_wall, 3) if self.barge_onset_wall else None
                barge_note(self, "stop_playback", latency_s=latency, text=heard)
                stop_playback(f"Heard {heard!r} over TTS -> stopping speech, not opening Handy")
                self.tts_loud_run = 0
                self.tts_rms_floor.clear()
                self.tts_active = False
                return True
            nxt = self.tts_barge_next
            self.tts_barge_next = None
            if nxt is not None and jobs is not None:
                audio, prompt = nxt
                if self.kick_whisper(jobs, "tts_barge", audio, prompt):
                    return True
                if self.tts_barge_next is None:
                    self.tts_barge_next = (audio, prompt)
            if (self.tts_barge_held or self.tts_barge_waiting) and self.tts_barge_next is None:
                self.tts_barge_held = False
                self.tts_barge_waiting = False
                self.note_barge_release()
                barge_note(self, "resume", reason="not a stop")
            if is_wake_phrase(heard):
                log(f"Ignored wake {heard!r} over TTS")
                return True
            if heard:
                log(f"Ignored {heard!r} over TTS (not stop)")
            else:
                log("TTS barge empty")
        elif heard_kind == "idle_verify" and self.state == "IDLE":
            if is_wake_phrase(heard):
                self.enter_dictating(f"whisper heard {heard!r}", oww, vad)
                return True
            idle_cmd = idle_command(heard)
            if idle_cmd and idle_cmd["action"] == "sent":
                log(f"Standalone send phrase in IDLE ({heard!r}) -> submitting draft")
                outcome = dispatch_transcript("send prompt")
                if outcome.get("action") == "sent":
                    play_cue(SOUND_SEND, wait=False)
                self.cooldown_until = time.monotonic() + WAKE_COOLDOWN_SECONDS
            elif idle_cmd and idle_cmd["action"] in ("scratched", "cleared"):
                log(f"Standalone scratch/clear phrase in IDLE ({heard!r}) -> scratching draft")
                dispatch_transcript(heard)
                play_cue(SOUND_CANCEL, wait=False)
                self.cooldown_until = time.monotonic() + WAKE_COOLDOWN_SECONDS
        elif heard_kind == "fast_cmd" and self.state == "DICTATING":
            self.pending_fast_flush = bool(match_command(heard))
        elif heard_kind == "partial" and self.state == "DICTATING" and heard.strip():
            log(f"Partial transcript: {heard.strip()!r}")
            self.show_partial(heard)
        return False

    def handle_idle_frame(self, frame, now, rms, vad_score, is_speech, dev_name, oww, vad, wake_word, wake_threshold, jobs) -> bool:
        """One IDLE mic frame. True means skip the rest of this iteration."""
        global _handy_on_light
        self.release_idle_utterance(jobs)
        sync_speech_tier(now)
        if not handy_file_mode() and (now - self.last_manual_check) >= 1.0:
            self.last_manual_check = now
            manual_id, manual_txt = latest_history_row()
            if manual_id > self.last_history_id and manual_id <= self.fn_ignore_through:
                self.last_history_id = manual_id
                log(f"Dropped Handy transcription #{manual_id} recorded over playback")
            elif manual_id > self.last_history_id and manual_txt.strip():
                self.last_history_id = manual_id
                log(f"Manual Handy transcription #{manual_id}: {manual_txt!r}")
                manual_outcome = dispatch_transcript(manual_txt)
                manual_action = manual_outcome.get("action", "appended")
                log(f"Manual chunk outcome: {manual_action}")
                if manual_action == "sent":
                    play_cue(SOUND_SEND, wait=False)
                elif manual_action in ("paused", "cancelled", "scratched", "cleared"):
                    play_cue(SOUND_CANCEL if manual_action in ("scratched", "cleared") else SOUND_PAUSE, wait=False)
        if (now - self.last_tts_check) >= 0.24:
            was_speaking = self.tts_active
            self.last_tts_check = now
            self.tts_active = is_voicebox_speaking()
            if self.tts_active != was_speaking:
                barge_note(self, "speaking", speaking=self.tts_active)
        # Handy starts recording on fn. That used to keep the reply that was
        # still coming out of the speakers. Cut the speakers on the key edge,
        # throw away that take, and record again only if fn is still held.
        fn_down = fn_held()
        if (
            not handy_file_mode()
            and fn_down
            and not self.fn_was_down
            and not self.fn_cut_busy
            and (self.tts_active or is_voicebox_speaking())
        ):
            self.fn_cut_busy = True
            self.tts_active = False
            kill_tts_clips()
            log("fn held during playback -> stopping speech before Handy keeps it")

            def cut_playback_then_listen() -> None:
                silence_speech(True)
                handy_cancel(allow_launch=False)
                deadline = time.monotonic() + 1.5
                while time.monotonic() < deadline and is_voicebox_speaking():
                    kill_tts_clips()
                    time.sleep(0.05)
                absorb_until = time.monotonic() + 0.45
                while time.monotonic() < absorb_until:
                    row_id, _ = latest_history_row()
                    self.fn_ignore_through = max(self.fn_ignore_through, row_id)
                    time.sleep(0.05)
                if fn_held():
                    handy_start_recording(allow_launch=False)
                    log("fn barge-in: speakers stopped, recording restarted without the reply")
                else:
                    log("fn barge-in: speakers stopped")
                self.fn_cut_busy = False

            threading.Thread(target=cut_playback_then_listen, daemon=True).start()
        self.fn_was_down = fn_down

        # While VoiceBox is playing, ignore the wake word. A reply that
        # sounds like "Hey Jarvis" must not open Handy. "stop" still stops
        # playback and does not open Handy. Headphones use the voice
        # detector instead of loudness, because the mic is not hearing
        # the earpiece.
        if self.tts_active:
            self.idle_pre_roll.clear()
            self.idle_speech_frames.clear()
            self.idle_in_speech = False
            self.idle_silence_frames = 0
            self.on_headphones = any(
                word in dev_name.lower()
                for word in ("buds", "airpod", "headphone", "headset", "beats")
            )
            oww.reset()
            floor = sorted(self.tts_rms_floor)[len(self.tts_rms_floor) // 2] if self.tts_rms_floor else 0.0
            if self.on_headphones:
                hot = vad_score >= 0.25 and rms >= 180.0
                user_voice = hot
                clip_limit = 18
                clip_floor = 250.0
            else:
                # Measured speaker bleed on this laptop peaks near rms 175
                # with VAD above 0.9. Pausing on that bleed stops the clip
                # and starts it again, which is the echo. A pause now needs
                # three frames well above that bleed. Those frames are the
                # person, so they must not become the next floor.
                hot = (
                    vad_score >= 0.55
                    and rms >= max(320.0, floor * 2.4)
                    and time.monotonic() >= self.tts_barge_cool_until
                )
                self.tts_loud_run = self.tts_loud_run + 1 if hot else 0
                user_voice = self.tts_loud_run >= 3
                clip_limit = 10
                clip_floor = 80.0
            just_held = False
            if self.tts_barge_waiting:
                return True
            if not self.tts_barge_held:
                self.tts_pre_roll.append(frame.copy())
            if user_voice and not self.tts_stop_frames and not self.tts_barge_held:
                # Do not SIGSTOP the clip here. The words are not known yet, and
                # pausing speaker bleed stops the reply and starts it again.
                # A confirmed stop calls stop_playback. Anything else leaves it playing.
                self.tts_barge_held = True
                self.tts_barge_voice = False
                self.tts_barge_quiet = 0
                self.tts_barge_skip = 2
                self.tts_barge_loud = 0
                just_held = True
                self.tts_stop_frames = [chunk.copy() for chunk in self.tts_pre_roll]
                self.barge_onset_wall = time.time()
                log(
                    f"TTS barge hold rms={rms:.0f} vad={vad_score:.2f} floor={floor:.0f} "
                    f"hot={self.tts_loud_run} frames={len(self.tts_stop_frames)}"
                )
                barge_note(
                    self,
                    "hold",
                    speaking=True,
                    rms=rms,
                    vad=vad_score,
                    floor=floor,
                    hot=self.tts_loud_run,
                    frames=len(self.tts_stop_frames),
                )
            keep = False
            if self.tts_barge_held and not just_held:
                if self.tts_barge_skip > 0:
                    self.tts_barge_skip -= 1
                elif rms >= 220.0:
                    self.tts_barge_loud += 1
                    self.tts_barge_quiet = 0
                    if self.tts_barge_loud >= 3:
                        self.tts_barge_voice = True
                        barge_note(self, "voice", rms=rms, vad=vad_score, loud=self.tts_barge_loud)
                    keep = True
                else:
                    self.tts_barge_quiet += 1
            if keep:
                self.tts_stop_silence = 0
                self.tts_stop_frames.append(frame.copy())
                flush_clip = len(self.tts_stop_frames) >= clip_limit
            elif self.tts_stop_frames:
                self.tts_stop_silence += 1
                flush_clip = self.tts_stop_silence >= 4
            else:
                flush_clip = False
            # A short word ends before three more loud frames. The onset audio is
            # already in the clip. Ask Whisper. Do not resume the player from here.
            if (
                self.tts_barge_held
                and not self.tts_barge_voice
                and self.tts_barge_quiet >= 2
                and self.tts_stop_frames
            ):
                flush_clip = True
            elif (
                self.tts_barge_held
                and not self.tts_stop_frames
                and self.tts_barge_skip == 0
                and self.tts_barge_quiet >= 4
            ):
                self.tts_barge_held = False
                self.tts_barge_quiet = 0
                flush_clip = False
                self.note_barge_release()
                log("TTS barge release")
                barge_note(self, "resume", reason="empty hold")
            if flush_clip and self.tts_stop_frames:
                    clip = np.concatenate(self.tts_stop_frames)
                    n_frames = len(self.tts_stop_frames)
                    self.tts_stop_frames.clear()
                    self.tts_stop_silence = 0
                    peak = float(np.max(np.abs(clip)))
                    log(
                        f"TTS barge clip frames={n_frames} peak={peak:.0f} "
                        f"voice={self.tts_barge_voice} quiet={self.tts_barge_quiet}"
                    )
                    barge_note(
                        self,
                        "clip",
                        frames=n_frames,
                        peak=peak,
                        voice=self.tts_barge_voice,
                        quiet=self.tts_barge_quiet,
                    )
                    if 2 <= n_frames <= 16 and peak >= clip_floor:
                        audio_f32 = clip_for_whisper(clip.astype(np.float32) / 32768.0, 6.0)
                        self.tts_barge_waiting = True
                        if not self.kick_whisper(jobs, "tts_barge", audio_f32, "Hey Jarvis. stop."):
                            if self.tts_barge_next is not None:
                                log("whisper busy; held TTS barge clip")
                            else:
                                log("whisper busy; skipped TTS barge clip")
                                self.tts_barge_waiting = False
                                if self.tts_barge_held:
                                    self.tts_barge_held = False
                                    self.note_barge_release()
                                    barge_note(self, "resume", reason="whisper skipped")
                    elif self.tts_barge_held:
                        self.tts_barge_waiting = False
                        self.tts_barge_held = False
                        self.note_barge_release()
                        barge_note(self, "resume", reason="clip rejected")
            if self.tts_floor_holdoff > 0:
                self.tts_floor_holdoff -= 1
            elif not self.tts_barge_held and not hot:
                self.tts_rms_floor.append(rms)
            return True
        if self.tts_barge_held:
            resume_tts_clips()
            self.tts_barge_held = False
            self.note_barge_release()
        self.tts_barge_voice = False
        self.tts_barge_quiet = 0
        self.tts_barge_skip = 0
        self.tts_barge_loud = 0
        self.tts_loud_run = 0
        self.tts_rms_floor.clear()
        self.tts_stop_frames.clear()
        self.tts_stop_silence = 0

        # Path 1: Fast neural keyword spotter (with 3x gain normalization if mic signal is quiet)
        boosted = np.clip(frame.astype(np.float32) * 3.0, -32768, 32767).astype(np.int16) if rms < 1200 else frame
        preds = oww.predict(boosted)
        score = float(preds.get(wake_word, 0.0))
        if score >= wake_threshold:
            if now < self.score_wake_blocked_until:
                return False
            self.enter_dictating(f"openWakeWord score={score:.2f}", oww, vad)
            return True

        # Path 2: Short utterance verifier (disabled while VoiceBox TTS is playing so continuous TTS speech isn't fed to Whisper)
        if is_speech:
            if not self.idle_in_speech:
                self.idle_in_speech = True
                self.idle_silence_frames = 0
                self.idle_speech_frames.extend(self.idle_pre_roll)
            self.idle_speech_frames.append(frame.copy())
            # Cap at ~3.2s (40 frames) so long background conversations are ignored
            if len(self.idle_speech_frames) > 42:
                self.idle_speech_frames.clear()
                self.idle_in_speech = False
                self.idle_silence_frames = 0
        else:
            if not self.idle_in_speech:
                self.idle_pre_roll.append(frame.copy())
            else:
                self.idle_speech_frames.append(frame.copy())
                self.idle_silence_frames += 1
                # 7 frames = 560ms of silence after a short burst (0.3s - 3.2s)
                if self.idle_silence_frames >= 7:
                    n_frames = len(self.idle_speech_frames)
                    audio_i16 = np.concatenate(self.idle_speech_frames)
                    self.idle_speech_frames.clear()
                    self.idle_in_speech = False
                    self.idle_silence_frames = 0
                    if 5 <= n_frames <= 42 and float(np.max(np.abs(audio_i16))) >= RMS_IDLE_UTTERANCE:
                        audio_f32 = clip_for_whisper(audio_i16.astype(np.float32) / 32768.0, 6.0)
                        prompt = "Hey Jarvis, Jarvis, send prompt, prompt this, submit prompt, scratch that, undo that, clear draft."
                        if not self.kick_whisper(jobs, "idle_verify", audio_f32, prompt):
                            held = self.hold_idle_utterance(audio_f32, prompt)
                            log(f"whisper busy; {held} idle utterance")

        return False

    def handle_dictating_frame(self, frame, now, rms, vad_score, is_speech, oww, vad, pause_seconds, idle_timeout_seconds, jobs) -> bool:
        """One DICTATING mic frame. True means skip the rest of this iteration."""
        # Quitting Handy, or closing its window, must not launch it again.
        # Skip the first 1.5s so the window we just opened can appear.
        fn_down = False if handy_file_mode() else fn_held()
        fn_released = self.fn_was_down and not fn_down
        self.fn_was_down = fn_down
        if not handy_file_mode() and fn_released and (now - self.chunk_started_at) > 0.4:
            log("fn released during dictation -> closing Handy and returning to IDLE")
            self.finish_fn_take(oww, vad)
            return True
        if not handy_file_mode() and (now - self.chunk_started_at) > 1.5 and (now - self.last_handy_ui_check) >= 1.0:
            self.last_handy_ui_check = now
            # --start-hidden has no window until the overlay appears. A zero
            # count before we have seen one is not the user closing it.
            if not handy_process_running():
                self.handy_ui_gone = True
            elif handy_window_open():
                self.handy_ui_seen = True
            elif self.handy_ui_seen:
                self.handy_ui_gone = True
        if self.handy_ui_gone:
            log("Handy was closed during dictation -> staying idle, not opening it again")
            self.score_wake_blocked_until = time.monotonic() + DISMISS_WAKE_SECONDS
            self.transition_to_idle("handy_closed", SOUND_PAUSE, oww, vad)
            return True
        # If the user manually pressed `fn` and Handy already finished a new row while we were waiting,
        # consume and dispatch it immediately so we never re-toggle Handy out of sync!
        live_id, live_txt = (0, "") if handy_file_mode() else latest_history_row()
        if live_id > self.last_history_id:
            self.last_history_id = live_id
            log(f"Detected manual Handy transcription #{live_id} during DICTATING: {live_txt!r}")
            time.sleep(0.26)
            self.retract_partial()
            outcome = dispatch_transcript(live_txt)
            action = outcome.get("action", "appended")
            log(f"Manual chunk outcome: {action}")
            if outcome.get("draft"):
                log(f"Transcript draft: {outcome.get('draft')!r}")
            self.dict_tail_frames.clear()
            self.dict_speech_frames.clear()
            self.checked_fast_cmd = False
            self.speech_seen_in_chunk = False
            if action in ("sent", "paused", "cancelled"):
                if action == "sent":
                    cue = SOUND_SEND
                elif action == "cancelled":
                    cue = SOUND_CANCEL
                else:
                    cue = SOUND_PAUSE
                self.transition_to_idle(action, cue, oww, vad)
            else:
                play_cue(SOUND_CHUNK_TICK, wait=False)
                self.forget_handy_window()
                if not handy_file_mode():
                    handy_start_recording()
                self.chunk_started_at = time.monotonic()
                self.last_speech_at = self.chunk_started_at
                self.cooldown_until = self.chunk_started_at + 0.25
                write_status(self.state, {"last_action": action})
            return True

        # Headphones sit close to the mouth, so a quiet or slow phrase is
        # still speech. The room-mic gate (vad 0.40 / rms 320) drops those
        # frames, the 5s clock starts, and the rest of the sentence is cut.
        heard_speech = is_speech or (self.on_headphones and (vad_score >= 0.15 or rms >= 30.0))
        if heard_speech:
            if not self.speech_seen_in_chunk:
                log(f"Speech started in chunk (vad={vad_score:.2f}, rms={rms:.0f})")
            self.speech_seen_in_chunk = True
            self.last_speech_at = now
            self.checked_fast_cmd = False
            self.dict_tail_frames.append(frame.copy())
            if len(self.dict_speech_frames) < 750:  # cap at ~60s
                self.dict_speech_frames.append(frame.copy())
            self.maybe_emit_partial(jobs)
        else:
            if self.speech_seen_in_chunk:
                self.dict_tail_frames.append(frame.copy())
                if len(self.dict_speech_frames) < 750:
                    self.dict_speech_frames.append(frame.copy())
                silence_dur = now - self.last_speech_at
                flush_after = 8.0 if self.on_headphones else pause_seconds
                should_flush = silence_dur >= flush_after

                if not should_flush and self.pending_fast_flush and silence_dur >= FAST_COMMAND_SILENCE_SECONDS:
                    log(f"Fast command phrase detected after {silence_dur:.1f}s silence -> flushing now")
                    should_flush = True
                    self.pending_fast_flush = False
                if not should_flush and silence_dur >= FAST_COMMAND_SILENCE_SECONDS and not self.checked_fast_cmd and len(self.dict_tail_frames) >= 8:
                    self.checked_fast_cmd = True
                    tail_i16 = np.concatenate(list(self.dict_tail_frames))
                    tail_f32 = clip_for_whisper(tail_i16.astype(np.float32) / 32768.0, 6.0)
                    if not self.kick_whisper(jobs, 
                        "fast_cmd",
                        tail_f32,
                        "send prompt, prompt this, submit prompt, pause listening, cancel that, scratch that, undo that, clear draft.",
                    ):
                        log("whisper busy; skipped fast-command tail")

                if should_flush:
                    self.show_closing_partial(jobs)
                    log(f"Pause of {silence_dur:.1f}s detected -> flushing chunk via Handy")
                    prev_id = self.last_history_id
                    if handy_file_mode():
                        transcript = transcribe_handy_file(list(self.dict_speech_frames))
                        row = (prev_id, transcript) if transcript else None
                    elif not handy_stop_recording():
                        log("Handy is not running -> not launching it to flush")
                        action = "handy_stopped"
                        row = None
                    else:
                        row = wait_for_new_history_row(prev_id, timeout_sec=2.2)
                    if row is not None:
                        self.last_history_id, transcript = row
                        log(f"Handy transcribed chunk #{self.last_history_id}: {transcript!r}")
                        # Wait 260ms so Handy's native Cmd+V paste (229ms) finishes before OMP deduplicates & updates editor
                        time.sleep(0.26)
                        self.retract_partial()
                        outcome = dispatch_transcript(transcript)
                        action = outcome.get("action", "appended")
                        log(f"Transcript outcome: {action}")
                        if outcome.get("draft"):
                            log(f"Transcript draft: {outcome.get('draft')!r}")
                    else:
                        # Handy was closed or its recording was cancelled. Keep any words we already
                        # buffered, then go idle. Do not toggle Handy back on.
                        fallback_txt = self.transcribe_local_fallback(jobs, self.dict_speech_frames)
                        if fallback_txt:
                            log(f"Handy row missing (stopped externally); kept local transcript: {fallback_txt!r}")
                            self.retract_partial()
                            dispatch_transcript(fallback_txt)
                        else:
                            log("Handy row missing (stopped externally); nothing to keep")
                        action = "handy_stopped"

                    self.dict_speech_frames.clear()
                    self.partial_sent_frames = 0
                    if action == "sent":
                        self.transition_to_idle("sent", SOUND_SEND, oww, vad)
                        log("Prompt submitted -> returned to IDLE")
                    elif action == "paused":
                        self.transition_to_idle("paused", SOUND_PAUSE, oww, vad)
                        log("Paused listening -> returned to IDLE (draft preserved)")
                    elif action in ("scratched", "cleared"):
                        # Play cancel/undo tone, keep DICTATING active so the user can immediately re-speak the corrected thought!
                        play_cue(SOUND_CANCEL, wait=False)
                        self.forget_handy_window()
                        if not handy_file_mode():
                            handy_start_recording()
                        vad.reset_states()
                        self.dict_tail_frames.clear()
                        self.checked_fast_cmd = False
                        self.speech_seen_in_chunk = False
                        self.chunk_started_at = time.monotonic()
                        self.last_speech_at = self.chunk_started_at
                        self.cooldown_until = self.chunk_started_at + 0.25
                        write_status(self.state, {"last_action": action})
                        log(f"Draft {action} -> continuing DICTATING for replacement chunk...")
                    elif action in ("cancelled", "handy_stopped"):
                        self.transition_to_idle(
                            action,
                            SOUND_PAUSE if action == "handy_stopped" else SOUND_CANCEL,
                            oww,
                            vad,
                        )
                        log("Handy stopped -> returned to IDLE without restarting it")
                    else:
                        play_cue(SOUND_CHUNK_TICK, wait=False)
                        self.forget_handy_window()
                        if not handy_file_mode():
                            handy_start_recording()
                        vad.reset_states()
                        self.dict_tail_frames.clear()
                        self.checked_fast_cmd = False
                        self.speech_seen_in_chunk = False
                        self.chunk_started_at = time.monotonic()
                        self.last_speech_at = self.chunk_started_at
                        self.cooldown_until = self.chunk_started_at + 0.25
                        write_status(self.state, {"last_action": action})
                        log("Continuing DICTATING for next chunk...")
            else:
                if (now - self.chunk_started_at) >= idle_timeout_seconds:
                    log(f"No speech for {idle_timeout_seconds:.0f}s in DICTATING -> cancelling Handy & returning to IDLE")
                    self.retract_partial()
                    if not handy_file_mode():
                        handy_cancel()
                    self.transition_to_idle("idle_timeout", SOUND_PAUSE, oww, vad, cooldown=IDLE_TIMEOUT_COOLDOWN_SECONDS)
        return False

MIC_RATE = 16000
MIC_CHUNK = 1280


class SoundDeviceAudioSource:
    """Production input. Opens the default microphone and nothing else."""

    name = "sounddevice"

    def __init__(self, sample_rate: int = MIC_RATE, chunk_samples: int = MIC_CHUNK) -> None:
        self.sample_rate = sample_rate
        self.chunk_samples = chunk_samples
        self.frames: queue.Queue = queue.Queue(maxsize=32)
        self._stream = None

    def __enter__(self) -> "SoundDeviceAudioSource":
        import sounddevice as sd

        try:
            sd._terminate()
            sd._initialize()
        except Exception:
            pass
        sample_rate = self.sample_rate
        frames = self.frames

        def on_mic(indata, block_frames, time_info, status) -> None:
            block = indata.copy()
            captured = block_end_wall_time(
                time.time(),
                getattr(time_info, "inputBufferAdcTime", None),
                getattr(time_info, "currentTime", None),
                int(block_frames),
                sample_rate,
            )
            dropped, invalid = offer_mic_frame(frames, stamp_mic_block(block, captured), status)
            record_mic_offer(dropped, invalid)

        self._stream = sd.InputStream(
            samplerate=sample_rate,
            channels=1,
            dtype="int16",
            blocksize=self.chunk_samples,
            callback=on_mic,
        )
        self._stream.__enter__()
        log(f"Audio source {self.name}")
        return self

    def __exit__(self, exc_type, exc, tb) -> None:
        if self._stream is not None:
            self._stream.__exit__(exc_type, exc, tb)
            self._stream = None


class FixtureAudioSource:
    """PCM fixtures in frame order. Does not open a microphone."""

    name = "fixture"

    def __init__(
        self,
        segments: list[tuple[np.ndarray, float]],
        *,
        chunk_samples: int = MIC_CHUNK,
        sample_rate: int = MIC_RATE,
        pace: bool = True,
    ) -> None:
        frames: list[np.ndarray] = []
        for pcm, trailing_silence in segments:
            audio = np.asarray(pcm, dtype=np.int16).reshape(-1)
            gap = np.zeros(int(trailing_silence * sample_rate), dtype=np.int16)
            audio = np.concatenate([audio, gap])
            pad = (-len(audio)) % chunk_samples
            if pad:
                audio = np.concatenate([audio, np.zeros(pad, dtype=np.int16)])
            for start in range(0, len(audio), chunk_samples):
                frames.append(audio[start : start + chunk_samples])
        self.frames = frames
        self._index = 0
        self.pace = pace
        self.chunk_samples = chunk_samples
        self.sample_rate = sample_rate

    def __enter__(self) -> "FixtureAudioSource":
        log(f"Audio source {self.name} ({len(self.frames)} frames, microphone not opened)")
        return self

    def __exit__(self, exc_type, exc, tb) -> None:
        return None

    def read(self) -> np.ndarray | None:
        if self._index >= len(self.frames):
            return None
        frame = self.frames[self._index]
        self._index += 1
        if self.pace:
            time.sleep(self.chunk_samples / self.sample_rate)
        return frame


def handle_captured_frame(
    mic: MicState,
    frame: np.ndarray,
    captured_at: float | None,
    dev_name: str,
    oww,
    vad,
    vad_threshold: float,
    wake_word: str,
    wake_threshold: float,
    pause_seconds: float,
    idle_timeout_seconds: float,
    whisper_jobs: queue.Queue,
) -> None:
    """One captured block. The microphone and the fixture source both call this."""
    refresh_render_reference()
    frame = cancel_playback_echo(np.asarray(frame), captured_at)
    now = time.monotonic()
    if now < mic.cooldown_until:
        # The tail of "cancel that" must not open a new utterance. A wake
        # score still does: the phrase is often shorter than this window.
        rms = float(np.sqrt(np.mean(frame.astype(np.float32) ** 2)))
        boosted = np.clip(frame.astype(np.float32) * 3.0, -32768, 32767).astype(np.int16) if rms < 1200 else frame
        preds = oww.predict(boosted)
        score = float(preds.get(wake_word, 0.0) or 0.0)
        if mic.state == "IDLE" and score >= wake_threshold and now >= mic.score_wake_blocked_until:
            mic.enter_dictating(f"openWakeWord score={score:.2f} during cooldown", oww, vad)
        return
    rms = float(np.sqrt(np.mean(frame.astype(np.float32) ** 2)))
    vad_score = float(vad.predict(frame))
    is_speech = (vad_score >= vad_threshold) or (rms >= RMS_SPEECH_FLOOR)
    polled = mic.take_whisper()
    if polled:
        heard_kind, heard = polled
        if mic.apply_whisper(heard_kind, heard, oww, vad, whisper_jobs):
            return
    mic.release_barge_clip(whisper_jobs)
    if mic.barge_mute and (now - mic.last_tts_mute) >= 0.25:
        mic.last_tts_mute = now
        kill_tts_clips()
        if not is_voicebox_speaking():
            mic.barge_mute = False
    if mic.state == "IDLE":
        mic.handle_idle_frame(
            frame, now, rms, vad_score, is_speech, dev_name, oww, vad, wake_word, wake_threshold, whisper_jobs
        )
    elif mic.state == "DICTATING":
        mic.handle_dictating_frame(
            frame, now, rms, vad_score, is_speech, oww, vad, pause_seconds, idle_timeout_seconds, whisper_jobs
        )


def load_fixture_listeners():
    """Wake, VAD, and the Whisper worker. Does not open a microphone or Handy."""
    from faster_whisper import WhisperModel
    from openwakeword.model import Model
    from openwakeword.vad import VAD

    oww = Model(wakeword_models=["hey_jarvis"], inference_framework="onnx")
    vad = VAD()
    whisper = WhisperModel("tiny.en", device="cpu", compute_type="int8")
    jobs: queue.Queue = queue.Queue(maxsize=1)

    def _whisper_text(audio_f32: np.ndarray, prompt: str) -> str:
        segments, _info = whisper.transcribe(
            audio_f32,
            language="en",
            beam_size=1,
            without_timestamps=True,
            initial_prompt=prompt,
        )
        return " ".join(segment.text for segment in segments).strip()

    def _whisper_worker() -> None:
        while _daemon_running.is_set() or not jobs.empty():
            try:
                job = jobs.get(timeout=WATCH_POLL_SECONDS)
            except queue.Empty:
                continue
            try:
                text = _whisper_text(job["audio"], job["prompt"])
            except Exception as exc:
                log(f"whisper worker failed: {exc}")
                text = ""
            job["slot"].put(text)

    _daemon_running.set()
    threading.Thread(target=_whisper_worker, daemon=True).start()
    return oww, vad, jobs


def run_daemon(
    wake_word: str = "hey_jarvis",
    wake_threshold: float = WAKE_SCORE_THRESHOLD,
    pause_seconds: float = 5.0,
    idle_timeout_seconds: float = 15.0,
    vad_threshold: float = 0.40,
) -> None:
    import sounddevice as sd
    from faster_whisper import WhisperModel
    from openwakeword.model import Model
    from openwakeword.vad import VAD

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    PID_FILE.write_text(str(os.getpid()), encoding="utf-8")
    configure_handy_settings()
    # Ensure macOS microphone input gain is at least 80% so across-the-room voice isn't attenuated
    subprocess.run(
        ["/usr/bin/osascript", "-e", "set volume input volume 85"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )

    log(f"Loading openWakeWord '{wake_word}' + Silero VAD + faster-whisper tiny.en wake verifier...")
    oww = Model(wakeword_models=[wake_word], inference_framework="onnx")
    vad = VAD()
    whisper = WhisperModel("tiny.en", device="cpu", compute_type="int8")

    sample_rate = 16000
    chunk_samples = 1280  # 80 ms frames

    whisper_jobs: queue.Queue = queue.Queue(maxsize=1)
    def _whisper_text(audio_f32: np.ndarray, prompt: str) -> str:
        segments, _info = whisper.transcribe(
            audio_f32,
            language="en",
            beam_size=1,
            without_timestamps=True,
            initial_prompt=prompt,
        )
        return " ".join(segment.text for segment in segments).strip()

    def _whisper_worker() -> None:
        while _daemon_running.is_set() or not whisper_jobs.empty():
            try:
                job = whisper_jobs.get(timeout=WATCH_POLL_SECONDS)
            except queue.Empty:
                continue
            try:
                text = _whisper_text(job["audio"], job["prompt"])
            except Exception as exc:
                log(f"whisper worker failed: {exc}")
                text = ""
            job["slot"].put(text)

    mic = MicState()
    mic.last_history_id, _ = latest_history_row()
    mic.fn_was_down = fn_held()

    global _handy_on_light, _pid_lock_handle
    _daemon_running.set()
    inherited = os.environ.get("OMP_VOICE_PID_LOCK_FD")
    if inherited:
        _pid_lock_handle = os.fdopen(int(inherited), "a+")
    elif _pid_lock_handle is None:
        _pid_lock_handle = _open_pid_lock(block=True)
    _set_strata_loaded(strata_loaded())
    threading.Thread(target=_watch_strata, daemon=True).start()
    threading.Thread(target=watch_submitted_messages, daemon=True).start()
    threading.Thread(target=_whisper_worker, daemon=True).start()
    apply_handy_model(_strata_loaded.is_set())
    sync_speech_tier(time.monotonic())
    write_status(mic.state, {"wake_word": wake_word, "pause_seconds": pause_seconds})
    log(
        f"OMP Voice Controller ready in IDLE. Say 'Hey Jarvis' (or 'Jarvis') to start dictating; "
        f"pause {pause_seconds:.1f}s to flush chunk; say 'send prompt' to press Enter."
    )

    running = True

    def handle_sig(_signum: int, _frame: object) -> None:
        nonlocal running
        running = False

    signal.signal(signal.SIGINT, handle_sig)
    signal.signal(signal.SIGTERM, handle_sig)

    while running:
        try:
            sd._terminate()
            sd._initialize()
        except Exception:
            pass
        active_ca_dev = coreaudio_default_input_device_id()
        try:
            dev_info = sd.query_devices(kind="input")
            dev_name = str(dev_info.get("name", "default")) if isinstance(dev_info, dict) else "default"
        except Exception:
            dev_name = "default"
        mic.on_headphones = any(
            word in dev_name.lower() for word in ("buds", "airpod", "headphone", "headset", "beats")
        )
        log(f"Opening microphone input stream on '{dev_name}' (CoreAudio id={active_ca_dev})")
        write_status(mic.state, {"wake_word": wake_word, "pause_seconds": pause_seconds, "mic": dev_name})
        last_dev_check = time.monotonic()

        try:
            source = SoundDeviceAudioSource(sample_rate, chunk_samples)
            with source:
                last_capture_publish = 0.0
                while running:
                    kind, pcm_block, last_dev_check = next_mic_frame(
                        source.frames,
                        active_ca_dev,
                        coreaudio_default_input_device_id,
                        last_dev_check,
                    )
                    now_mono = time.monotonic()
                    if now_mono - last_capture_publish >= 1.0:
                        last_capture_publish = now_mono
                        publish_capture_totals()
                    if kind == "rebind":
                        new_ca_dev = coreaudio_default_input_device_id()
                        log(
                            f"macOS default microphone changed ({active_ca_dev} -> {new_ca_dev}); rebinding stream..."
                        )
                        subprocess.run(
                            ["/usr/bin/osascript", "-e", "set volume input volume 85"],
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL,
                            check=False,
                        )
                        break
                    if kind != "frame" or pcm_block is None:
                        continue
                    handle_captured_frame(
                        mic,
                        mic_block_samples(pcm_block)[:, 0],
                        mic_block_captured_at(pcm_block),
                        dev_name,
                        oww,
                        vad,
                        vad_threshold,
                        wake_word,
                        wake_threshold,
                        pause_seconds,
                        idle_timeout_seconds,
                        whisper_jobs,
                    )
        except Exception as stream_err:
            log(f"Audio stream interrupted ({stream_err}); reconnecting in 1.0s...")
            time.sleep(1.0)

    if mic.state == "DICTATING":
        handy_cancel()
    write_status("STOPPED")
    try:
        PID_FILE.unlink(missing_ok=True)
    except Exception:
        pass
    _daemon_running.clear()
    log("OMP Voice Controller stopped.")


def cmd_status() -> int:
    try:
        delivery = resolve_delivery()
    except Exception as exc:
        delivery = {"mode": "unknown", "error": str(exc)}
    try:
        targets = live_bridge_bases()
    except Exception as exc:
        log_once("status-targets", f"live_bridge_bases failed: {exc}")
        targets = []
    bridge = probe_bridge_status(delivery, targets)
    ctrl = json.loads(STATUS_FILE.read_text(encoding="utf-8")) if STATUS_FILE.exists() else {"state": "STOPPED"}
    pid = ctrl.get("pid")
    alive = False
    if isinstance(pid, int):
        try:
            os.kill(pid, 0)
            alive = True
        except OSError:
            alive = False
    print(
        json.dumps(
            {
                "controller": {**ctrl, "alive": alive},
                "delivery": delivery,
                "omp_bridge": bridge,
            },
            indent=2,
        )
    )
    return 0


def cmd_stop() -> int:
    if not PID_FILE.exists():
        print("OMP Voice Controller is not running.")
        return 0
    try:
        pid = int(PID_FILE.read_text(encoding="utf-8").strip())
        os.kill(pid, signal.SIGTERM)
        for _ in range(30):
            try:
                os.kill(pid, 0)
                time.sleep(0.05)
            except OSError:
                break
        PID_FILE.unlink(missing_ok=True)
        print(f"Stopped OMP Voice Controller (pid {pid}).")
    except Exception as exc:
        print(f"Controller not running ({exc}).")
        PID_FILE.unlink(missing_ok=True)
    return 0


def cmd_start_bg(args: argparse.Namespace) -> int:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    lock = _open_pid_lock(block=False)
    if lock is None:
        print("OMP Voice Controller already running.")
        return 0
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text(encoding="utf-8").strip() or "0")
            if pid > 0:
                os.kill(pid, 0)
                print(f"OMP Voice Controller already running (pid {pid}).")
                lock.close()
                return 0
        except OSError:
            pass

    cmd = [
        sys.executable,
        str(Path(__file__).resolve()),
        "run",
        "--wake-word",
        args.wake_word,
        "--wake-threshold",
        str(args.wake_threshold),
        "--pause-seconds",
        str(args.pause_seconds),
        "--idle-timeout",
        str(args.idle_timeout),
    ]
    rotate_log(LOG_FILE, LOG_ROTATE_BYTES)
    log_fh = open(LOG_FILE, "a", encoding="utf-8")
    child_env = os.environ.copy()
    child_env["OMP_VOICE_PID_LOCK_FD"] = str(lock.fileno())
    proc = subprocess.Popen(
        cmd,
        stdout=log_fh,
        stderr=log_fh,
        stdin=subprocess.DEVNULL,
        start_new_session=True,
        pass_fds=(lock.fileno(),),
        env=child_env,
    )
    log_fh.close()
    lock.close()
    time.sleep(START_SPAWN_WAIT_SECONDS)
    print(f"Started OMP Voice Controller in background (pid {proc.pid}, log: {LOG_FILE})")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="OMP Hands-Free Voice Controller")
    sub = parser.add_subparsers(dest="subcommand")

    for name in ("run", "start"):
        p = sub.add_parser(name)
        p.add_argument("--wake-word", default="hey_jarvis", help="openWakeWord model name (default: hey_jarvis)")
        p.add_argument("--wake-threshold", type=float, default=WAKE_SCORE_THRESHOLD, help="Wake word threshold 0..1 (default: 0.50)")
        p.add_argument("--pause-seconds", type=float, default=5.0, help="Silence pause to flush chunk (default: 5.0)")
        p.add_argument("--idle-timeout", type=float, default=15.0, help="Max silence with no speech before IDLE (default: 15.0)")

    sub.add_parser("stop")
    sub.add_parser("status")

    p_send = sub.add_parser("inject", help="Send a synthetic transcript chunk through the OMP bridge")
    p_send.add_argument("text", help="Transcript text to inject")

    p_hook = sub.add_parser("handy-hook", help="Handy external_script_path hook receiver")
    p_hook.add_argument("args", nargs="*", help="Optional transcript args from Handy")

    sub.add_parser("barge-in", help="Immediately silence VoiceBox playback")

    args = parser.parse_args()
    if args.subcommand == "handy-hook":
        ctrl = json.loads(STATUS_FILE.read_text(encoding="utf-8")) if STATUS_FILE.exists() else {"state": "STOPPED"}
        if ctrl.get("state") == "DICTATING":
            return 0
        text = " ".join(args.args).strip()
        if not text and not sys.stdin.isatty():
            text = sys.stdin.read().strip()
        if not text:
            _, text = latest_history_row()
        if text:
            dispatch_transcript(text)
        return 0
    if args.subcommand == "run":
        run_daemon(
            wake_word=args.wake_word,
            wake_threshold=args.wake_threshold,
            pause_seconds=args.pause_seconds,
            idle_timeout_seconds=args.idle_timeout,
        )
        return 0
    if args.subcommand == "start":
        return cmd_start_bg(args)
    if args.subcommand == "stop":
        return cmd_stop()
    if args.subcommand == "inject":
        print(json.dumps(dispatch_transcript(args.text), indent=2))
        return 0
    if args.subcommand == "barge-in":
        print(json.dumps(bridge_request("/barge-in", method="POST", body={}) or {"ok": False}, indent=2))
        return 0
    return cmd_status()


if __name__ == "__main__":
    raise SystemExit(main())
